---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { SEO } from "astro-seo";

import SmoothScroll from "../components/SmoothScroll.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Preloader from "../components/Preloader.astro";

type Props = {
 title: string;
 description?: string;
 ogImage?: string;
};

const { title, description = "HAUSOFMATTERS", ogImage = "/og-image.jpg" } = Astro.props;

const site = Astro.site;
const ogImageUrl = new URL(ogImage, site).href;

// Current page value (/home, /about, /404 ...)
const currentPage = Astro.url.pathname.replace(/\/$/, "").split("/").pop() || "home";
---

<!doctype html>
<html lang="ko" data-page={currentPage}>
 <head>
  <script is:inline>
   const saved = localStorage.getItem("theme");
   if (saved) {
    document.documentElement.setAttribute("data-theme", saved);
   }
  </script>

  <SEO
   title={title}
   description={description}
   charset="UTF-8"
   openGraph={{
    basic: {
     title: title,
     type: "website",
     image: ogImageUrl,
    },
   }}
   twitter={{
    creator: "@zamso",
   }}
   extend={{
    // extending the default link tags
    link: [
     {
      rel: "icon",
      type: "image/png",
      sizes: "16x16",
      href: "/favicon/favicon-16x16.png",
     },
     {
      rel: "icon",
      type: "image/png",
      sizes: "32x32",
      href: "/favicon/favicon-32x32.png",
     },
     {
      rel: "apple-touch-icon",
      sizes: "180x180",
      href: "/favicon/apple-touch-icon.png",
     },
     { rel: "manifest", href: "/favicon/site.webmanifest" },
     { rel: "sitemap", href: "/sitemap-index.xml" },
    ],
    // extending the default meta tags
    meta: [
     { name: "twitter:image", content: ogImageUrl },
     { name: "twitter:title", content: title },
     { name: "twitter:description", content: description },
     { name: "viewport", content: "width=device-width" },
     { name: "msapplication-TileColor", content: "#000000" },
     { name: "theme-color", content: "#ffffff" },
     { name: "generator", content: Astro.generator },
    ],
   }}
  />

  <!-- <meta name="theme-color">가 #ffffff로 고정돼 있으면, 다크 모드에서도 iOS Safari의
       상태바/툴바 영역이 라이트 배경으로 합성돼 스크롤(특히 overscroll/바운스) 중에
       실제 페이지 배경(검정)과 어긋나며 콘텐츠가 그 틈으로 비쳐 보이는 원인이 됨 —
       <SEO>가 렌더링된 직후(이 메타 태그가 DOM에 존재하는 시점) 저장된/시스템 테마에
       맞는 색으로 즉시 덮어써서 첫 페인트부터 올바른 값이 적용되게 함.
       Header.astro의 테마 토글(initTheme)도 전환 시 같은 값을 다시 씀 -->
  <script is:inline>
   (function () {
    var saved = localStorage.getItem("theme");
    var theme = saved || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    var meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute("content", theme === "dark" ? "#020202" : "#ffffff");
   })();
  </script>

  <ClientRouter />

  <!-- Flipbook 라이브러리 사전 로드 -->
  <script is:inline src="/scripts/jquery-3.6.0.min.js"></script>
  <script is:inline src="/scripts/flipbook.min.js"></script>
  <link rel="stylesheet" href="/styles/flipbook.style.css" />
  <link rel="stylesheet" href="/styles/font-awesome.css" />
 </head>
 <!-- Astro 기본 페이지 전환 애니메이션(크로스페이드)이 전환 중 화면이 탁해 보이는
      "깜빡임"으로 보여서 끔 — 콘텐츠가 그냥 즉시 바뀌는 쪽이 더 자연스러움 -->
 <body transition:animate="none">
  <a href="#main-content" class="skip-link">본문으로 건너뛰기</a>
  <Preloader />
  <SmoothScroll />
  <!-- 헤더가 스크롤됐는지 감지하는 1px 센티넬. scroll 이벤트 대신 IntersectionObserver로
       관찰하는 이유: iOS Safari는 관성(모멘텀) 스크롤 중엔 scroll 이벤트를 거의/전혀 쏘지
       않아서, 빠르게 스크롤하면 헤더 배경이 갱신될 기회를 놓쳐 콘텐츠가 헤더 위로 비쳐
       보이는 문제가 있었음 — IntersectionObserver는 메인 스레드 스크롤 이벤트에 의존하지
       않아 이 문제가 없음 -->
  <div id="scroll-sentinel" aria-hidden="true"></div>
  <Header />
  <main id="main-content" tabindex="-1"><slot /></main>
  <Footer />
  <script src="../scripts/imageFade.js"></script>
 </body>
</html>

<script is:inline>
 function applyTheme() {
  const saved = localStorage.getItem("theme");
  if (saved) {
   document.documentElement.setAttribute("data-theme", saved);
  }
 }
 applyTheme();
 document.addEventListener("astro:after-swap", applyTheme);
</script>
