---
type Props = {
 title: string;
};

const { title } = Astro.props;
---

<div class="share">
 <button id="share-native">Share</button>
 <button id="share-copy">Copy Link</button>
</div>
<div id="copy-toast" aria-live="polite">링크가 복사되었습니다</div>

<script>
 function showToast(message) {
  const toast = document.getElementById("copy-toast");
  if (!toast) return;

  toast.textContent = message;
  toast.classList.add("visible");
  setTimeout(() => toast.classList.remove("visible"), 2000);
 }

 function initShare() {
  const shareBtn = document.getElementById("share-native");
  const copyBtn = document.getElementById("share-copy");

  if (!shareBtn || !copyBtn) return;
  if (shareBtn.dataset.initialized) return;
  shareBtn.dataset.initialized = "true";
  copyBtn.dataset.initialized = "true";

  const url = window.location.href;
  const title = document.title;

  // 네이티브 공유
  shareBtn.addEventListener("click", async () => {
   if (navigator.share) {
    try {
     await navigator.share({ title, url });
    } catch (e) {
     // AbortError: 사용자가 직접 취소한 경우 → 토스트 없이 무시
     if (e?.name !== "AbortError") {
      showToast("공유에 실패했습니다.");
     }
    }
   } else {
    showToast("공유 기능이 지원되지 않는 브라우저입니다.");
   }
  });

  // 링크 복사
  copyBtn.addEventListener("click", async () => {
   try {
    await navigator.clipboard.writeText(url);
    showToast("링크가 복사되었습니다.");
   } catch (e) {
    showToast("복사에 실패했습니다.");
   }
  });
 }

 document.addEventListener("astro:page-load", initShare);
</script>
