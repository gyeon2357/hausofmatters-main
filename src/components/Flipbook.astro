---
export interface Props {
  pdfPath: string;
}

const {pdfPath} = Astro.props;
---

<button type="button" class="flipbook-btn" data-pdf={pdfPath}>Read Now</button>

<script>
  function initFlipbook() {
    if (typeof $ === "undefined" || typeof $.fn?.flipBook === "undefined") {
      console.log("[Flipbook] 라이브러리 로드 대기 중...");
      setTimeout(initFlipbook, 100);
      return;
    }

    const btn = document.querySelector(".flipbook-btn");
    if (!(btn instanceof HTMLElement)) return;

    const pdfUrl = btn.dataset.pdf;
    if (!pdfUrl) {
      console.log("[Flipbook] PDF 경로가 없음");
      return;
    }

    if (btn.classList.contains("flipbook-initialized")) {
      console.log("[Flipbook] 이미 초기화됨");
      return;
    }

    console.log("[Flipbook] 초기화 중:", pdfUrl);

    try {
      $(btn).flipBook({
        pdfUrl: pdfUrl,
        btnColor: "#000",
        sideBtnBackground: "transparent",
        sideBtnColor: "#fff",
        lightBox: true,
        viewMode: "3d",
        layout: 3,
        currentPage: {vAlign: "bottom", hAlign: "left"},
      });

      btn.classList.add("flipbook-initialized");
      console.log("[Flipbook] ✅ 초기화 완료!");
    } catch (error) {
      console.error("[Flipbook] 초기화 실패:", error);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      console.log("[Flipbook] DOMContentLoaded 발동");
      initFlipbook();
    });
  } else {
    console.log("[Flipbook] 문서 이미 로드됨");
    initFlipbook();
  }

  document.addEventListener("astro:after-swap", () => {
    const btn = document.querySelector<HTMLElement>(".flipbook-btn");
    if (btn) {
      btn.classList.remove("flipbook-initialized");
    }
    initFlipbook();
  });
</script>
