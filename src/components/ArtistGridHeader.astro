---
import TextSlider from "../components/TextSlider.astro";
import Separator from "../components/Separator.astro";

type Props = {
 artistsTotal: number;
};

const { artistsTotal } = Astro.props;
---

<header class="title-header title-header--initial">
 <h1><TextSlider content="Artists" /></h1>

 <section>
  <div>
   <button data-sort><TextSlider content="Sort" /></button>
   <button data-shuffle><TextSlider content="Shuffle" /></button>
  </div>
  <span class="total-num"><TextSlider content={"(" + artistsTotal + ")"} /></span>
 </section>
</header>

<Separator />

<style>
 section {
  display: flex;
  justify-content: space-between;
 }

 div {
  display: flex;
  list-style: none;
  align-items: center;
  gap: 1rem;
  margin: 0;
  padding: 0;
 }

 .total-num {
  font-size: var(--font-size-s);
  font-weight: 700;
  vertical-align: text-top;
 }
</style>
<script src="../scripts/gridActions.js"></script>
