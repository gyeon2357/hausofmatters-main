---
import Separator from "../components/Separator.astro";
---

<Separator />
<footer>
 <p>Instagram</p>
 <div><p><a href="https://www.instagram.com/hausofmatters/">@HAUSOFMATTERS</a></p></div>

 <h2>© 2026 Hausofmatters All Rights Reserved.</h2>

 <!-- 화면에 고정된 플로팅 버튼이 아니라, 푸터까지 스크롤했을 때만 보이는 일반 버튼 -->
 <button id="footer-top-btn" type="button" class="footer-top-btn" aria-label="맨 위로">TOP</button>
</footer>

<style>
 footer {
  display: flex;
  flex-direction: column;

  align-items: start;

  padding: 1rem 0;
 }

 footer div {
  display: flex;
  flex-direction: row;
  gap: 0.5rem;
 }

 footer h2 {
  font-size: var(--font-size-s);
  font-weight: 400;

  margin: 1rem 0 0;
  line-height: 1.2;
 }

 footer p {
  font-size: var(--font-size-s);

  margin: 1rem 0 0;
  line-height: 1.4;
 }

 footer div p {
  margin: 0;
 }

 .footer-top-btn {
  margin-top: 1.5rem;
  font-size: var(--font-size-s);
  padding: var(--btn-padding);
  border: 1px solid var(--border-color);
  border-radius: 999px;
  background: none;
  color: inherit;
  cursor: pointer;
 }
</style>

<script>
 function initFooterTopBtn() {
  const btn = document.getElementById("footer-top-btn");
  if (!btn || btn.dataset.initialized) return;
  btn.dataset.initialized = "true";

  btn.addEventListener("click", () => {
   if ((window as any).__lenis) {
    (window as any).__lenis.scrollTo(0, { duration: 1.2 });
   } else {
    window.scrollTo({ top: 0, behavior: "smooth" });
   }
  });
 }

 document.addEventListener("astro:page-load", initFooterTopBtn);
</script>
