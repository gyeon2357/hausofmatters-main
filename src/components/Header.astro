---
import TextSlider from "../components/TextSlider.astro";
import Search from "../components/Search.astro";
---

<!-- 데스크톱: 로고를 가운데 두고 좌우에 텍스트 버튼(테마/검색) 배치.
     모바일: 화면이 좁아 텍스트 버튼은 숨기고 로고만 남김 — 카테고리는 하단 pill-nav가 전담 -->
<header class="full-bleed" transition:persist>
 <section class="header-bar">
  <button id="theme-toggle" aria-label="다크모드 전환" class="text-btn theme-toggle">
   <TextSlider content="Dark" />
  </button>

  <a href="/" class="logo-link">
   <img id="site-logo" src="/images/logo.png" alt="HAUSOFMATTERS" class="logo" />
  </a>

  <!-- Search 링크 → button으로 교체, 모달 직접 제어 -->
  <button id="search-open-btn" aria-label="검색" class="text-btn search-btn">
   <TextSlider content="Search" />
  </button>
 </section>
</header>

<!-- 카테고리 내비게이션: 헤더와 분리해 화면 하단에 고정 -->
<nav class="pill-nav full-bleed" aria-label="주요 메뉴" transition:persist>
 <ul class="pill-links">
  <li>
   <a href="/magazine/" data-astro-prefetch><TextSlider content="Magazine" /></a>
  </li>
  <li>
   <a href="/albums/" data-astro-prefetch><TextSlider content="Album" /></a>
  </li>
  <li>
   <a href="/interview/" data-astro-prefetch><TextSlider content="Interview" /></a>
  </li>
  <li>
   <a href="/feature/" data-astro-prefetch><TextSlider content="Feature" /></a>
  </li>
  <li>
   <a href="/about/" data-astro-prefetch><TextSlider content="About" /></a>
  </li>
 </ul>
</nav>

<button id="top-btn" class="top-btn" aria-label="Scroll to top">TOP</button>

<style>
  header {
   display: flex;
   flex-direction: column;

   position: sticky;
   top: 0;
   z-index: 100;
   /* 불투명한 흰 박스 대신 아래로 갈수록 옅어지는 스크림 — 콘텐츠(특히 커버 이미지) 위에
      떠 있는 느낌을 주고, 스크롤해도 텍스트가 완전히 가려지지 않게 함 */
   background: linear-gradient(to bottom, var(--color-bg) 0%, color-mix(in srgb, var(--color-bg) 55%, transparent) 65%, transparent 100%);

   font-family: var(--info-font);

   padding: 1rem 1rem 2rem;
  }

  /* 아이콘(테마) - 로고(중앙) - 아이콘(검색) 3열 그리드로, 좌우 아이콘 폭이 달라도
     로고가 항상 시각적 중앙에 오도록 바깥 두 칸을 동일 비율(1fr)로 둠 */
  .header-bar {
   display: grid;
   grid-template-columns: 1fr auto 1fr;
   align-items: center;
   width: 100%;
  }

  .logo-link {
   display: flex;
   align-items: center;
   justify-content: center;
  }

  .logo {
   display: block;
   height: 1.5rem;
   width: auto;
  }

  .text-btn {
   display: flex;
   align-items: center;
   background: none;
   border: none;
   color: inherit;
   cursor: pointer;
   padding: 0;
   font: inherit;
   font-size: var(--font-size-s);
   text-decoration: underline;
   text-underline-position: under;
  }

  .theme-toggle {
   justify-self: start;
  }

  .search-btn {
   justify-self: end;
  }

  /* 카테고리 pill 내비게이션 — 화면 하단에 고정. 헤더와 대칭으로 위로 갈수록
     옅어지는 스크림 배경을 써서 흰 박스처럼 보이지 않게 함 */
  .pill-nav {
   position: fixed;
   left: 0;
   right: 0;
   bottom: 0;
   z-index: 100;
   width: 100%;

   padding: 1.5rem 1rem 1rem;
   background: linear-gradient(to top, var(--color-bg) 0%, color-mix(in srgb, var(--color-bg) 55%, transparent) 65%, transparent 100%);

   overflow-x: auto;
   scrollbar-width: none;
  }

  .pill-nav::-webkit-scrollbar {
   display: none;
  }

  .pill-links {
   display: flex;
   justify-content: center;
   list-style: none;
   gap: 0.5rem;
   margin: 0;
   padding: 0;
   width: max-content;
   min-width: 100%;
  }

  .pill-links a {
   display: flex;
   align-items: center;
   white-space: nowrap;
   font-size: var(--font-size-s);
   padding: var(--btn-padding);
   border: 1px solid var(--border-color);
   border-radius: 999px;
   transition:
    background-color 0.2s ease,
    color 0.2s ease;
  }

  .pill-links a:hover {
   color: inherit;
   background: color-mix(in srgb, currentColor 8%, transparent);
  }

  .pill-links a.current {
   background: var(--color-text);
   border-color: var(--color-text);
   color: var(--color-bg);
  }

  @media screen and (max-width: 768px) {
   header {
    padding: 0.75rem 0.75rem 1.5rem;
   }

   .logo {
    height: 1.1rem;
   }

   /* 화면이 좁아지면 텍스트 버튼(테마/검색)은 숨기고 로고만 남김 */
   .theme-toggle,
   .search-btn {
    display: none;
   }

   .pill-nav {
    padding: 1.25rem 0.75rem 0.75rem;
   }

   .pill-links {
    /* 실기기 소형 화면에서 pill 5개가 잘리지 않도록 간격/글자 크기를 살짝 줄임 */
    gap: 0.35rem;
   }

   .pill-links a {
    font-size: var(--font-size-xs);
   }
  }

  #top-btn {
   display: none;
   position: fixed;
   /* pill-nav가 화면 하단에 고정되므로 그 위로 띄움 */
   bottom: calc(var(--bottom-nav-height, 3.5rem) + 0.75rem);
   right: 1rem;
   z-index: 200;

   background: var(--color-bg);
   color: var(--color-text, currentColor);
   font-family: inherit;
   font-size: var(--font-size-s);
   padding: var(--btn-padding);
   border: 1px solid var(--border-color);
   border-radius: 999px;
   cursor: pointer;

   opacity: 0;
   transition: opacity 0.25s ease;
  }

  #top-btn.visible {
   display: block;
   opacity: 1;
  }
 </style>

 <script>
  function initHeader() {
   const path = window.location.pathname;
   document.querySelectorAll("header a[href], .pill-nav a[href]").forEach(a => {
    const href = a.getAttribute("href");
    if (!href) return;
    a.classList.toggle("current", href !== "/" && path.startsWith(href));
   });
  }

  // pill-nav가 화면 하단에 고정되므로 실제 높이를 CSS 변수로 노출 —
  // body 하단 여백(footer 가림 방지)과 top-btn 위치가 여기에 맞춰 움직임
  function updateBottomNavHeight() {
   const nav = document.querySelector(".pill-nav");
   if (nav) document.documentElement.style.setProperty("--bottom-nav-height", nav.getBoundingClientRect().height + "px");
  }

  function initTheme() {
   const btn = document.getElementById("theme-toggle");
   if (!btn || btn.dataset.initialized) return;
   btn.dataset.initialized = "true";

   const inner = btn.querySelector(".oh__inner");

   const getEffective = () =>
    document.documentElement.getAttribute("data-theme") || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");

   const apply = (theme: string) => {
    document.documentElement.setAttribute("data-theme", theme);
    localStorage.setItem("theme", theme);
    if (inner) inner.textContent = theme === "dark" ? "Light" : "Dark";
    const logo = document.getElementById("site-logo") as HTMLImageElement | null;
    if (logo) logo.src = theme === "dark" ? "/images/logo-w.png" : "/images/logo.png";
   };

   const initial = getEffective();
   if (inner) inner.textContent = initial === "dark" ? "Light" : "Dark";
   const logoInit = document.getElementById("site-logo") as HTMLImageElement | null;
   if (logoInit) logoInit.src = initial === "dark" ? "/images/logo-w.png" : "/images/logo.png";

   btn.addEventListener("click", () => {
    apply(getEffective() === "dark" ? "light" : "dark");
   });
  }

  // ── Search 인덱스 전역 캐시 ─────────────────────────────
  if (!(window as any).__searchCache) {
   (window as any).__searchCache = { index: [] as any[], loaded: false, promise: null as Promise<void> | null };
  }
  const searchCache = (window as any).__searchCache as { index: any[]; loaded: boolean; promise: Promise<void> | null };

  function loadSearchIndex(): Promise<void> {
   if (searchCache.loaded) return Promise.resolve();
   if (searchCache.promise) return searchCache.promise;
   searchCache.promise = fetch("/search-index.json")
    .then(r => r.json())
    .then(data => {
     searchCache.index = data;
     searchCache.loaded = true;
    });
   return searchCache.promise;
  }

  // ── Search 모달 ──────────────────────────────────────────
  function initSearch() {
   // dialog는 페이지마다 새로 렌더링 → 매번 fresh하게 조회
   const openBtn = document.getElementById("search-open-btn");
   const dialog = document.getElementById("search-dialog") as HTMLDialogElement | null;
   const input = document.getElementById("search-input") as HTMLInputElement | null;
   const closeBtn = document.getElementById("close-dialog");
   const form = document.getElementById("search-form");
   const hint = document.getElementById("search-hint");
   const suggestions = document.getElementById("search-suggestions");

   if (!openBtn || !dialog || !input) return;

   // AbortController로 이전 페이지의 리스너를 정리하고 새로 바인딩
   const ac = new AbortController();
   const sig = ac.signal;
   const prev = (openBtn as any).__searchAC as AbortController | undefined;
   prev?.abort();
   (openBtn as any).__searchAC = ac;

   function openDialog() {
    dialog!.showModal();
    input!.value = "";
    hint!.textContent = "아티스트 · 앨범 · 인터뷰 · 공연정보";
    suggestions?.classList.remove("suggestions-hidden");
    setTimeout(() => input!.focus(), 50);
   }

   function closeDialog() {
    dialog!.close();
   }

   // showModal() 특성상 열려있는 동안 openBtn 자체가 inert(클릭 불가)라
   // 트리거 버튼을 닫기로 재사용할 수 없음 — 별도 닫기 버튼(closeBtn) 필요
   openBtn.addEventListener("click", openDialog, { signal: sig });
   closeBtn?.addEventListener("click", closeDialog, { signal: sig });

   dialog.addEventListener(
    "click",
    e => {
     if (e.target === dialog) closeDialog();
    },
    { signal: sig }
   );

   let debounce: ReturnType<typeof setTimeout>;
   input.addEventListener(
    "input",
    () => {
     suggestions?.classList.toggle("suggestions-hidden", input!.value.trim() !== "");
     clearTimeout(debounce);
     debounce = setTimeout(async () => {
      const q = input!.value.trim().toLowerCase();
      const submitBtn = document.getElementById("search-submit");
      if (!q) {
       hint!.textContent = "아티스트 · 앨범 · 인터뷰 · 공연정보";
       submitBtn?.classList.remove("has-results");
       return;
      }
      await loadSearchIndex();
      const count = searchCache.index.filter((item: any) => {
       if (item.displayTitle.toLowerCase().includes(q)) return true;
       return Object.values(item.fields as Record<string, string>).some(v => v.toLowerCase().includes(q));
      }).length;
      hint!.textContent = count > 0 ? `${count} result${count > 1 ? "s" : ""}` : "검색결과가 없습니다";
      submitBtn?.classList.toggle("has-results", count > 0);
     }, 100);
    },
    { signal: sig }
   );

   form?.addEventListener(
    "submit",
    e => {
     e.preventDefault();
     const q = input!.value.trim();
     if (!q) return;
     closeDialog();
     window.location.href = `/search?q=${encodeURIComponent(q)}`;
    },
    { signal: sig }
   );

   // 페이지 로드마다 인덱스 백그라운드 프리패치
   loadSearchIndex();
  }

  document.addEventListener("astro:page-load", initHeader);
  document.addEventListener("astro:page-load", initTheme);
  document.addEventListener("astro:page-load", initSearch);
  document.addEventListener("astro:page-load", initTopBtn);
  document.addEventListener("astro:page-load", updateBottomNavHeight);
  window.addEventListener("resize", updateBottomNavHeight, { passive: true });

  // ── Top 버튼 ─────────────────────────────────────────────
  function initTopBtn() {
   const btn = document.getElementById("top-btn");
   if (!btn) return;

   const THRESHOLD = window.innerHeight;

   function onScroll() {
    btn!.classList.toggle("visible", window.scrollY > THRESHOLD);
   }

   btn.addEventListener("click", () => {
    if ((window as any).__lenis) {
     (window as any).__lenis.scrollTo(0, { duration: 1.2 });
    } else {
     window.scrollTo({ top: 0, behavior: "smooth" });
    }
   });

   window.addEventListener("scroll", onScroll, { passive: true });
   onScroll();
  }
 </script>
</header>

<!-- Search 모달: header 밖에 두어 z-index 충돌 방지 -->
<Search />
