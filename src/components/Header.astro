---
import TextSlider from "../components/TextSlider.astro";
import Search from "../components/Search.astro";
import SiteMenu from "../components/SiteMenu.astro";
---

<header class="full-bleed" transition:persist>
 <section class="header-bar">
  <button id="theme-toggle" aria-label="다크모드 전환" class="text-btn theme-toggle theme-toggle-btn">
   <TextSlider content="Dark" />
  </button>

  <a href="/" class="logo-link">
   <img id="site-logo" src="/images/logo.png" alt="HAUSOFMATTERS" class="logo" />
  </a>

  <div class="header-actions">
   <button
    id="search-open-btn"
    aria-label="검색"
    aria-haspopup="dialog"
    aria-controls="search-dialog"
    aria-expanded="false"
    class="text-btn search-btn"
   >
    <TextSlider content="Search" />
   </button>
   <button
    id="site-menu-open"
    aria-label="전체 메뉴 열기"
    aria-haspopup="dialog"
    aria-controls="site-menu-dialog"
    aria-expanded="false"
    class="text-btn menu-btn"
   >
    <TextSlider content="Menu" />
   </button>
  </div>
 </section>
</header>

<nav class="pill-nav full-bleed" aria-label="주요 메뉴" transition:persist>
 <ul class="pill-links">
  <li>
   <a href="/magazine/" data-astro-prefetch><TextSlider content="Magazine" /></a>
  </li>
  <li>
   <a href="/albums/" data-astro-prefetch><TextSlider content="Album" /></a>
  </li>
  <li>
   <a href="/interview/" data-astro-prefetch><TextSlider content="Interview" /></a>
  </li>
  <li>
   <a href="/feature/" data-astro-prefetch><TextSlider content="Feature" /></a>
  </li>
 </ul>
</nav>

<style>
  header {
   display: flex;
   flex-direction: column;

   position: sticky;
   top: 0;
   z-index: 100;
   background: var(--color-bg);
   transition: background-color 0.2s ease;
   transform: translateZ(0);

   font-family: var(--info-font);

   padding: 1rem;

   pointer-events: none;
  }

  .header-bar {
   pointer-events: auto;
   display: grid;
   grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
   align-items: center;
   width: 100%;
  }

  .logo-link {
   grid-column: 2;
   display: flex;
   align-items: center;
   justify-content: center;
  }

  .logo {
   display: block;
   height: 1.05rem;
   width: auto;
  }

  .theme-toggle {
   grid-column: 1;
   justify-self: start;
  }

  .header-actions {
   grid-column: 3;
   display: flex;
   align-items: center;
   gap: 1rem;
   justify-self: end;
  }

  .pill-nav {
   position: fixed;
   left: 0;
   right: 0;
   bottom: 0;
   z-index: 100;
   width: 100%;

   padding: 1rem;

   overflow-x: auto;
   scrollbar-width: none;
  }

  .pill-nav::-webkit-scrollbar {
   display: none;
  }

  .pill-links {
   display: flex;
   justify-content: center;
   list-style: none;
   gap: 0.5rem;
   margin: 0;
   padding: 0.4rem;
   width: max-content;
   min-width: 100%;
   background: color-mix(in srgb, var(--color-bg) 85%, transparent);
   backdrop-filter: blur(20px);
   -webkit-backdrop-filter: blur(20px);
   border-radius: 999px;
  }

  .pill-links a {
   display: flex;
   align-items: center;
   white-space: nowrap;
   font-size: var(--font-size-s);
   padding: var(--btn-padding);
   background: var(--color-bg);
   border: 1px solid var(--border-color);
   border-radius: 999px;
   transition:
    background-color 0.2s ease,
    color 0.2s ease;
  }

  .pill-links a:hover {
   color: inherit;
   background: color-mix(in srgb, currentColor 8%, var(--color-bg));
  }

  .pill-links a.current {
   background: var(--color-text);
   border-color: var(--color-text);
   color: var(--color-bg);
   font-weight: inherit;
  }

  .pill-links a:focus {
   background: var(--color-bg);
   opacity: 1;
  }

  .pill-links a.current:focus {
   background: var(--color-text);
  }

  .pill-links a:focus-visible {
   outline: 2px solid currentColor;
   outline-offset: 2px;
  }

  @media screen and (max-width: 768px) {
   header {
    padding: 0.75rem;
   }

   .logo {
    height: 0.88rem;
   }

   .pill-nav {
    padding: 0.75rem;
   }

   .pill-links {
    gap: 0.35rem;
   }

   .pill-links a {
    font-size: var(--font-size-xs);
   }
  }

 </style>

 <script>
  function stripTrailingSlash(p: string) {
   return p.length > 1 && p.endsWith("/") ? p.slice(0, -1) : p;
  }

  function initHeader() {
   const path = stripTrailingSlash(window.location.pathname);
   document.querySelectorAll("header.full-bleed a[href], .pill-nav a[href], .site-menu-links a[href]").forEach(a => {
    const href = a.getAttribute("href");
    if (!href || href === "/") return;
    const hrefPath = stripTrailingSlash(href);
    const isCurrent = path === hrefPath || path.startsWith(hrefPath + "/");
    a.classList.toggle("current", isCurrent);
    if (isCurrent) a.setAttribute("aria-current", "page");
    else a.removeAttribute("aria-current");
   });
  }

  function updateBottomNavHeight() {
   const nav = document.querySelector(".pill-nav");
   if (nav) document.documentElement.style.setProperty("--bottom-nav-height", nav.getBoundingClientRect().height + "px");
  }

  function updateHeaderHeight() {
   const bar = document.querySelector(".header-bar");
   if (bar) document.documentElement.style.setProperty("--menu-anchor-top", bar.getBoundingClientRect().bottom + "px");
  }

  function initTheme() {
   const btns = Array.from(document.querySelectorAll<HTMLElement>(".theme-toggle-btn"));
   if (btns.length === 0) return;

   const getEffective = () =>
    document.documentElement.getAttribute("data-theme") || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");

   const syncLabels = (theme: string) => {
    btns.forEach(btn => {
     const inner = btn.querySelector(".oh__inner");
     if (inner) inner.textContent = theme === "dark" ? "Light" : "Dark";
    });
   };

   const apply = (theme: string) => {
    document.documentElement.setAttribute("data-theme", theme);
    localStorage.setItem("theme", theme);
    syncLabels(theme);
    const logo = document.getElementById("site-logo") as HTMLImageElement | null;
    if (logo) logo.src = theme === "dark" ? "/images/logo-w.png" : "/images/logo.png";

    const themeColorMeta = document.querySelector('meta[name="theme-color"]');
    if (themeColorMeta) themeColorMeta.setAttribute("content", theme === "dark" ? "#020202" : "#ffffff");

    [document.querySelector("header.full-bleed"), document.querySelector(".pill-nav")].forEach(el => {
     if (!(el instanceof HTMLElement)) return;
     const prevDisplay = el.style.display;
     el.style.display = "none";
     void el.offsetHeight;
     el.style.display = prevDisplay;
    });
   };

   const initial = getEffective();
   syncLabels(initial);
   const logoInit = document.getElementById("site-logo") as HTMLImageElement | null;
   if (logoInit) logoInit.src = initial === "dark" ? "/images/logo-w.png" : "/images/logo.png";

   btns.forEach(btn => {
    if (btn.dataset.initialized) return;
    btn.dataset.initialized = "true";
    btn.addEventListener("click", () => {
     apply(getEffective() === "dark" ? "light" : "dark");
    });
   });
  }

  if (!(window as any).__searchCache) {
   (window as any).__searchCache = { index: [] as any[], loaded: false, promise: null as Promise<void> | null };
  }
  const searchCache = (window as any).__searchCache as { index: any[]; loaded: boolean; promise: Promise<void> | null };

  function loadSearchIndex(): Promise<void> {
   if (searchCache.loaded) return Promise.resolve();
   if (searchCache.promise) return searchCache.promise;
   searchCache.promise = fetch("/search-index.json")
    .then(r => r.json())
    .then(data => {
     searchCache.index = data;
     searchCache.loaded = true;
    });
   return searchCache.promise;
  }

  function initSearch() {
   const openBtn = document.getElementById("search-open-btn");
   const dialog = document.getElementById("search-dialog") as HTMLDialogElement | null;
   const input = document.getElementById("search-input") as HTMLInputElement | null;
   const closeBtn = document.getElementById("close-dialog");
   const form = document.getElementById("search-form");
   const hint = document.getElementById("search-hint");
   const suggestions = document.getElementById("search-suggestions");

   if (!openBtn || !dialog || !input) return;

   const ac = new AbortController();
   const sig = ac.signal;
   const prev = (openBtn as any).__searchAC as AbortController | undefined;
   prev?.abort();
   (openBtn as any).__searchAC = ac;

   function openDialog() {
    dialog!.showModal();
    openBtn!.setAttribute("aria-expanded", "true");
    input!.value = "";
    hint!.textContent = "";
    hint!.classList.remove("search-hint--emphasized");
    suggestions?.classList.remove("suggestions-hidden", "suggestions-expanded");
    setTimeout(() => input!.focus(), 50);
   }

   function closeDialog() {
    dialog!.close();
   }

   dialog.addEventListener(
    "close",
    () => {
     openBtn!.setAttribute("aria-expanded", "false");
    },
    { signal: sig }
   );

   openBtn.addEventListener("click", openDialog, { signal: sig });
   closeBtn?.addEventListener("click", closeDialog, { signal: sig });

   dialog.addEventListener(
    "click",
    e => {
     if (e.target === dialog) closeDialog();
    },
    { signal: sig }
   );

   let debounce: ReturnType<typeof setTimeout>;
   input.addEventListener(
    "input",
    () => {
     clearTimeout(debounce);
     const submitBtn = document.getElementById("search-submit");
     const q = input!.value.trim();

     if (!q) {
      hint!.textContent = "";
      hint!.classList.remove("search-hint--emphasized");
      submitBtn?.classList.remove("has-results");
      suggestions?.classList.remove("suggestions-hidden", "suggestions-expanded");
      return;
     }

     debounce = setTimeout(async () => {
      await loadSearchIndex();
      const lower = q.toLowerCase();
      const count = searchCache.index.filter((item: any) => {
       if (item.displayTitle.toLowerCase().includes(lower)) return true;
       return Object.values(item.fields as Record<string, string>).some(v => v.toLowerCase().includes(lower));
      }).length;
      submitBtn?.classList.toggle("has-results", count > 0);

      if (count > 0) {
       hint!.textContent = `${count} result${count > 1 ? "s" : ""}`;
       hint!.classList.remove("search-hint--emphasized");
       suggestions?.classList.add("suggestions-hidden");
       suggestions?.classList.remove("suggestions-expanded");
      } else {
       hint!.textContent = "검색결과가 없습니다";
       hint!.classList.add("search-hint--emphasized");
       suggestions?.classList.remove("suggestions-hidden");
       suggestions?.classList.add("suggestions-expanded");
      }
     }, 100);
    },
    { signal: sig }
   );

   form?.addEventListener(
    "submit",
    e => {
     e.preventDefault();
     const q = input!.value.trim();
     if (!q) return;
     closeDialog();
     window.location.href = `/search?q=${encodeURIComponent(q)}`;
    },
    { signal: sig }
   );

   loadSearchIndex();
  }

  document.addEventListener("astro:page-load", initHeader);
  document.addEventListener("astro:page-load", initTheme);
  document.addEventListener("astro:page-load", initSearch);
  document.addEventListener("astro:page-load", updateBottomNavHeight);
  document.addEventListener("astro:page-load", updateHeaderHeight);
  window.addEventListener("resize", updateBottomNavHeight, { passive: true });
  window.addEventListener("resize", updateHeaderHeight, { passive: true });
 </script>
</header>

<Search />
<SiteMenu />
