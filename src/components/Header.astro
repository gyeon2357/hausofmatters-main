---
import TextSlider from "../components/TextSlider.astro";
import Separator from "../components/Separator.astro";
import Search from "../components/Search.astro";
---

<header transition:persist>
 <section>
  <div>
   <img id="logo" src="/images/logo.png" alt="HAUSOFMATTERS" class="logo" />
   <h1>
    <a href="/">
     <TextSlider content="HAUSOFMATTERS" />
    </a>
   </h1>
  </div>

  <li>
   <!-- Search 링크 → button으로 교체, 모달 직접 제어 -->
   <button id="search-open-btn" aria-label="검색" class="search-btn">
    <TextSlider content="Search" />
   </button>
  </li>

  <li>
   <button id="theme-toggle" aria-label="Toggle dark mode">
    <span class="toggle-track">
     <span class="toggle-thumb"></span>
    </span><TextSlider content="Dark" />
   </button>
  </li>
 </section>

 <ul>
  <li>
   <a href="/magazine/" data-astro-prefetch><TextSlider content="Magazine" /></a>
  </li>
  <li>
   <a href="/albums/" data-astro-prefetch><TextSlider content="Album" /></a>
  </li>
  <li>
   <a href="/interview/" data-astro-prefetch><TextSlider content="Interview" /></a>
  </li>
  <li>
   <a href="/feature/" data-astro-prefetch><TextSlider content="Feature" /></a>
  </li>
  <li>
   <a href="/about/" data-astro-prefetch><TextSlider content="About" /></a>
  </li>
 </ul>
 <button id="top-btn" aria-label="Scroll to top">/ TOP</button>
 <Separator />

 <style>
  header {
   display: flex;
   flex-direction: column;

   position: sticky;
   top: 0;
   z-index: 100;
   background: var(--color-bg);

   font-family: var(--info-font);

   padding: 0.5rem 0.5rem 0;
   gap: 0.75rem;
   margin-left: -0.5rem;
   margin-right: -0.5rem;
  }

  header section {
   display: flex;
   justify-content: space-between;
   align-items: center;
   width: 100%;
  }

  header section div {
   display: flex;
   justify-content: start;
   align-items: center;
  }

  header a.current {
   opacity: 0.4;
  }
  header h1 a.current {
   color: inherit;
  }

  h1 {
   font-size: 1rem;
   font-weight: inherit;
   margin: 0;
  }

  header section a {
   display: flex;
   align-items: center;
  }

  header section h1 {
   margin-left: 0.5rem;
  }

  .logo {
   display: block;
   height: 0.875rem;
   width: auto;
  }

  /* Search 버튼 — 기존 링크와 동일한 스타일 */
  #search-open-btn {
   background: none;
   border: none;
   color: inherit;
   font: inherit;
   font-family: var(--info-font);
   cursor: pointer;
   padding: 0;
   display: flex;
   align-items: center;
  }

  ul {
   display: flex;
   list-style: none;
   gap: 0.75rem;
   margin: 0;
   padding: 0;
   grid-column: auto / span 2;
   overflow: hidden;
   max-height: 2rem;
   transition:
    max-height 0.25s ease,
    opacity 0.25s ease,
    padding 0.25s ease;
   opacity: 1;
  }

  ul.nav-hidden {
   max-height: 0;
   opacity: 0;
   pointer-events: none;
  }

  ul li {
   font-size: 0.875rem;
  }

  @media screen and (max-width: 768px) {
   header {
    gap: 0.625rem;
   }
   ul li,
   header {
    font-size: 0.825rem;
   }
  }

  #top-btn {
   display: none;
   position: fixed;
   bottom: 1.25rem;
   right: 1rem;
   z-index: 200;

   background: var(--color-bg);
   color: var(--color-text, currentColor);
   font-family: inherit;
   font-size: 0.875rem;
   padding: 0.375rem 0.5rem;
   cursor: pointer;

   opacity: 0;
   transition: opacity 0.25s ease;
  }

  #top-btn.visible {
   display: block;
   opacity: 1;
  }
 </style>

 <script>
  function initHeader() {
   const path = window.location.pathname;
   document.querySelectorAll("header a[href]").forEach(a => {
    const href = a.getAttribute("href");
    if (!href) return;
    a.classList.toggle("current", href !== "/" && path.startsWith(href));
   });
  }

  function initTheme() {
   const btn = document.getElementById("theme-toggle");
   if (!btn || btn.dataset.initialized) return;
   btn.dataset.initialized = "true";

   const inner = btn.querySelector(".oh__inner");
   const thumb = btn.querySelector(".toggle-thumb");

   const getEffective = () =>
    document.documentElement.getAttribute("data-theme") || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");

   const apply = (theme: string) => {
    document.documentElement.setAttribute("data-theme", theme);
    localStorage.setItem("theme", theme);
    if (inner) inner.textContent = theme === "dark" ? "Light" : "Dark";
    if (thumb instanceof HTMLElement) thumb.style.transform = theme === "dark" ? "translateX(0.5rem)" : "translateX(0)";
    const logo = document.getElementById("site-logo") as HTMLImageElement | null;
    if (logo) logo.src = theme === "dark" ? "/images/logo-w.png" : "/images/logo.png";
   };

   const initial = getEffective();
   if (inner) inner.textContent = initial === "dark" ? "Light" : "Dark";
   if (thumb instanceof HTMLElement) thumb.style.transform = initial === "dark" ? "translateX(0.5rem)" : "translateX(0)";
   const logoInit = document.getElementById("site-logo") as HTMLImageElement | null;
   if (logoInit) logoInit.src = initial === "dark" ? "/images/logo-w.png" : "/images/logo.png";

   btn.addEventListener("click", () => {
    apply(getEffective() === "dark" ? "light" : "dark");
   });
  }

  // ── Search 모달 ──────────────────────────────────────────
  function initSearch() {
   const openBtn = document.getElementById("search-open-btn");
   const dialog = document.getElementById("search-dialog") as HTMLDialogElement | null;
   const input = document.getElementById("search-input") as HTMLInputElement | null;
   const closeBtn = document.getElementById("close-dialog");
   const form = document.getElementById("search-form");
   const hint = document.getElementById("search-hint");

   if (!openBtn || !dialog || !input) return;

   // 이미 이벤트 바인딩된 경우 중복 방지
   if (openBtn.dataset.initialized) return;
   openBtn.dataset.initialized = "true";

   let index: any[] = [];
   let loaded = false;

   async function loadIndex() {
    if (loaded) return;
    const res = await fetch("/search-index.json");
    index = await res.json();
    loaded = true;
   }

   function openDialog() {
    dialog!.showModal();
    setTimeout(() => input!.focus(), 50);
    loadIndex(); // 미리 로드
   }

   function closeDialog() {
    dialog!.close();
   }

   openBtn.addEventListener("click", openDialog);
   closeBtn?.addEventListener("click", closeDialog);

   // backdrop 클릭으로 닫기
   dialog.addEventListener("click", e => {
    if (e.target === dialog) closeDialog();
   });

   // 입력 중 결과 수 표시
   let debounce: ReturnType<typeof setTimeout>;
   input.addEventListener("input", () => {
    clearTimeout(debounce);
    debounce = setTimeout(async () => {
     const q = input!.value.trim().toLowerCase();
     if (!q) {
      hint!.textContent = "Album · Magazine · Interview · Feature";
      return;
     }
     await loadIndex();
     const count = index.filter(item => {
      if (item.displayTitle.toLowerCase().includes(q)) return true;
      return Object.values(item.fields as Record<string, string>).some(v => v.toLowerCase().includes(q));
     }).length;
     hint!.textContent = count > 0 ? `${count} result${count > 1 ? "s" : ""}` : "No results";
    }, 100);
   });

   // 검색 제출 → /search?q=... 이동
   form?.addEventListener("submit", e => {
    e.preventDefault();
    const q = input!.value.trim();
    if (!q) return;
    closeDialog();
    window.location.href = `/search?q=${encodeURIComponent(q)}`;
   });
  }

  document.addEventListener("astro:page-load", initHeader);
  document.addEventListener("astro:page-load", initTheme);
  document.addEventListener("astro:page-load", initSearch);
  document.addEventListener("astro:page-load", initTopBtn);

  // ── 스크롤 방향 감지 ─────────────────────────────────────
  (function initScrollNav() {
   const COOLDOWN = 200;
   let lastToggle = 0;
   let isHidden = false;

   function isNearBottom(margin = 200) {
    return window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - margin;
   }

   function setNav(hide: boolean) {
    const now = Date.now();
    if (hide === isHidden || now - lastToggle < COOLDOWN) return;
    const nav = document.querySelector("header ul");
    if (!nav) return;
    isHidden = hide;
    lastToggle = now;
    nav.classList.toggle("nav-hidden", hide);
   }

   function attachLenis(lenis: any) {
    lenis.on("scroll", ({ scroll, velocity }: { scroll: number; velocity: number }) => {
     if (scroll < 80 || isNearBottom()) {
      setNav(false);
      return;
     }
     if (velocity > 0.3) setNav(true);
     else if (velocity < -0.3) setNav(false);
    });
   }

   if ((window as any).__lenis) {
    attachLenis((window as any).__lenis);
    return;
   }

   setTimeout(() => {
    if ((window as any).__lenis) {
     attachLenis((window as any).__lenis);
     return;
    }

    let lastY = window.scrollY;
    let accumulated = 0;
    const THRESHOLD = 12;

    window.addEventListener(
     "scroll",
     () => {
      const currentY = window.scrollY;
      accumulated += currentY - lastY;
      lastY = currentY;

      if (currentY < 80 || isNearBottom()) {
       setNav(false);
       accumulated = 0;
       return;
      }
      if (accumulated > THRESHOLD) {
       setNav(true);
       accumulated = 0;
      } else if (accumulated < -THRESHOLD) {
       setNav(false);
       accumulated = 0;
      }
     },
     { passive: true }
    );
   }, 200);
  })();

  // ── Top 버튼 ─────────────────────────────────────────────
  function initTopBtn() {
   const btn = document.getElementById("top-btn");
   if (!btn) return;

   const THRESHOLD = window.innerHeight;

   function onScroll() {
    btn!.classList.toggle("visible", window.scrollY > THRESHOLD);
   }

   btn.addEventListener("click", () => {
    if ((window as any).__lenis) {
     (window as any).__lenis.scrollTo(0, { duration: 1.2 });
    } else {
     window.scrollTo({ top: 0, behavior: "smooth" });
    }
   });

   window.addEventListener("scroll", onScroll, { passive: true });
   onScroll();
  }
 </script>
</header>

<!-- Search 모달: header 밖에 두어 z-index 충돌 방지 -->
<Search />
