---
import TextSlider from "../components/TextSlider.astro";
import Separator from "../components/Separator.astro";

const currentPath = Astro.url.pathname;

const isAlbums = currentPath.startsWith("/albums");
const isMagazine = currentPath.startsWith("/magazine");
const isInterview = currentPath.startsWith("/interview");
const isAbout = currentPath.startsWith("/about");
---

<header>
 <h1>
  <a href="/"><TextSlider content="HAUSOFMATTERS" /></a>
 </h1>

 <span><TextSlider content="by KHL" /></span>

 <ul>
  <li>
   <a href="/albums/" class={isAlbums ? "current" : ""} data-astro-prefetch><TextSlider content="Album" /></a>
  </li>
  <!-- <li>
      <a href="/artists/" class={isArtists ? "current" : ""} data-astro-prefetch><TextSlider content="Artists" /></a>
    </li> -->
  <li>
   <a href="/interview/" class={isInterview ? "current" : ""} data-astro-prefetch><TextSlider content="Interview" /></a>
  </li>
  <li>
   <a href="/magazine/" class={isMagazine ? "current" : ""} data-astro-prefetch><TextSlider content="Magazine" /></a>
  </li>
  <li>
   <a href="/about/" class={isAbout ? "current" : ""} data-astro-prefetch><TextSlider content="About" /></a>
  </li>
 </ul>
</header>
<Separator />

<style>
 header {
  position: relative;
  display: grid;
  grid-template-columns: min-content auto;
  font-weight: 700;
  padding: 0.5rem 0;
  gap: 1rem;
 }
 header a.current {
  opacity: 0.4;
 }

 header h1 a.current {
  color: inherit;
 }

 h1 {
  font-size: 1rem;
  font-weight: inherit;
  margin: 0;
 }
 ul {
  display: flex;
  list-style: none;
  gap: 0.75rem;
  margin: 0;
  padding: 0;
  grid-column: auto / span 2;
 }

 ul li {
  font-size: 0.875rem;
  line-height: 1.6;
 }
</style>
