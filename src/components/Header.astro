---
import TextSlider from "../components/TextSlider.astro";
import Separator from "../components/Separator.astro";
import Search from "../components/Search.astro";
import NavMenu from "../components/NavMenu.astro";
---

<header class="full-bleed" transition:persist>
 <section>
  <a href="/" class="logo-link">
   <img id="site-logo" src="/images/logo.png" alt="HAUSOFMATTERS" class="logo" />
  </a>

  <ul class="nav-links">
   <li>
    <a href="/magazine/" data-astro-prefetch><TextSlider content="Magazine" /></a>
   </li>
   <li>
    <a href="/albums/" data-astro-prefetch><TextSlider content="Album" /></a>
   </li>
   <li>
    <a href="/interview/" data-astro-prefetch><TextSlider content="Interview" /></a>
   </li>
   <li>
    <a href="/feature/" data-astro-prefetch><TextSlider content="Feature" /></a>
   </li>
   <li>
    <a href="/about/" data-astro-prefetch><TextSlider content="About" /></a>
   </li>
  </ul>

  <div class="header-actions">
   <!-- Search 링크 → button으로 교체, 모달 직접 제어 -->
   <button id="search-open-btn" aria-label="검색" class="search-btn">
    <TextSlider content="Search" />
   </button>
   <button id="menu-open-btn" aria-label="메뉴 열기" class="menu-btn">
    <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
    <span class="menu-label"><TextSlider content="Menu" /></span>
   </button>
  </div>
 </section>

 <button id="top-btn" class="top-btn" aria-label="Scroll to top">TOP</button>
 <Separator />

 <style>
  header {
   display: flex;
   flex-direction: column;

   position: sticky;
   top: 0;
   z-index: 100;
   background: var(--color-bg);

   font-family: var(--info-font);

   padding: 1rem 1rem 0;
   gap: 0.75rem;
  }

  header section {
   display: flex;
   align-items: center;
   width: 100%;
  }

  header a.current {
   opacity: 0.4;
  }

  .logo-link {
   display: flex;
   align-items: center;
   flex-shrink: 0;
  }

  .logo {
   display: block;
   height: 0.75rem;
   width: auto;
  }

  .nav-links,
  header section a,
  .header-actions button {
   display: flex;
   align-items: center;
  }

  .nav-links {
   list-style: none;
   gap: 1.25rem;
   margin: 0 0 0 2rem;
   padding: 0;
   overflow: hidden;
   max-height: 2rem;
   transition:
    max-height 0.25s ease,
    opacity 0.25s ease;
   opacity: 1;
  }

  .nav-links.nav-hidden {
   max-height: 0;
   opacity: 0;
   pointer-events: none;
  }

  .nav-links li {
   font-size: var(--font-size-s);
  }

  .header-actions {
   display: flex;
   align-items: center;
   gap: 1.25rem;
   margin-left: auto;
  }

  /* Search / Menu 버튼 — 기존 링크와 동일한 스타일 */
  #search-open-btn,
  #menu-open-btn {
   background: none;
   border: none;
   color: inherit;
   font: inherit;
   font-family: var(--info-font);
   font-size: var(--font-size-s);
   cursor: pointer;
   padding: 0;
   gap: 0.4rem;
  }

  /* 모바일 전용 햄버거(가로 두 줄) 아이콘 — 데스크톱에서는 "Menu" 텍스트만 사용 */
  .menu-icon {
   display: none;
   flex-direction: column;
   gap: 0.25rem;
  }

  .menu-icon span {
   display: block;
   width: 1rem;
   height: 1px;
   background: currentColor;
  }

  @media screen and (max-width: 768px) {
   header {
    gap: 0.625rem;
    padding: 0.75rem 0.75rem 0;
   }

   .nav-links {
    display: none;
   }

   .header-actions {
    gap: 0.75rem;
   }

   .menu-label {
    display: none;
   }

   .menu-icon {
    display: flex;
   }
  }

  #top-btn {
   display: none;
   position: fixed;
   bottom: 1.25rem;
   right: 1rem;
   z-index: 200;

   background: var(--color-bg);
   color: var(--color-text, currentColor);
   font-family: inherit;
   font-size: var(--font-size-s);
   padding: 0.375rem 0.5rem;
   cursor: pointer;

   opacity: 0;
   transition: opacity 0.25s ease;
  }

  #top-btn.visible {
   display: block;
   opacity: 1;
  }
 </style>

 <script>
  function initHeader() {
   const path = window.location.pathname;
   document.querySelectorAll("header a[href]").forEach(a => {
    const href = a.getAttribute("href");
    if (!href) return;
    a.classList.toggle("current", href !== "/" && path.startsWith(href));
   });
  }

  function initTheme() {
   const btn = document.getElementById("theme-toggle");
   if (!btn || btn.dataset.initialized) return;
   btn.dataset.initialized = "true";

   const inner = btn.querySelector(".oh__inner");

   const getEffective = () =>
    document.documentElement.getAttribute("data-theme") || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");

   const apply = (theme: string) => {
    document.documentElement.setAttribute("data-theme", theme);
    localStorage.setItem("theme", theme);
    if (inner) inner.textContent = theme === "dark" ? "Light" : "Dark";
    const logo = document.getElementById("site-logo") as HTMLImageElement | null;
    if (logo) logo.src = theme === "dark" ? "/images/logo-w.png" : "/images/logo.png";
   };

   const initial = getEffective();
   if (inner) inner.textContent = initial === "dark" ? "Light" : "Dark";
   const logoInit = document.getElementById("site-logo") as HTMLImageElement | null;
   if (logoInit) logoInit.src = initial === "dark" ? "/images/logo-w.png" : "/images/logo.png";

   btn.addEventListener("click", () => {
    apply(getEffective() === "dark" ? "light" : "dark");
   });
  }

  // ── Search 인덱스 전역 캐시 ─────────────────────────────
  if (!(window as any).__searchCache) {
   (window as any).__searchCache = { index: [] as any[], loaded: false, promise: null as Promise<void> | null };
  }
  const searchCache = (window as any).__searchCache as { index: any[]; loaded: boolean; promise: Promise<void> | null };

  function loadSearchIndex(): Promise<void> {
   if (searchCache.loaded) return Promise.resolve();
   if (searchCache.promise) return searchCache.promise;
   searchCache.promise = fetch("/search-index.json")
    .then(r => r.json())
    .then(data => {
     searchCache.index = data;
     searchCache.loaded = true;
    });
   return searchCache.promise;
  }

  // ── Search 모달 ──────────────────────────────────────────
  function initSearch() {
   // dialog는 페이지마다 새로 렌더링 → 매번 fresh하게 조회
   const openBtn = document.getElementById("search-open-btn");
   const dialog = document.getElementById("search-dialog") as HTMLDialogElement | null;
   const input = document.getElementById("search-input") as HTMLInputElement | null;
   const closeBtn = document.getElementById("close-dialog");
   const form = document.getElementById("search-form");
   const hint = document.getElementById("search-hint");
   const suggestions = document.getElementById("search-suggestions");

   if (!openBtn || !dialog || !input) return;

   // AbortController로 이전 페이지의 리스너를 정리하고 새로 바인딩
   const ac = new AbortController();
   const sig = ac.signal;
   const prev = (openBtn as any).__searchAC as AbortController | undefined;
   prev?.abort();
   (openBtn as any).__searchAC = ac;

   function openDialog() {
    dialog!.showModal();
    input!.value = "";
    hint!.textContent = "아티스트 · 앨범 · 인터뷰 · 공연정보";
    suggestions?.classList.remove("suggestions-hidden");
    setTimeout(() => input!.focus(), 50);
   }

   function closeDialog() {
    dialog!.close();
   }

   openBtn.addEventListener("click", openDialog, { signal: sig });
   closeBtn?.addEventListener("click", closeDialog, { signal: sig });

   dialog.addEventListener(
    "click",
    e => {
     if (e.target === dialog) closeDialog();
    },
    { signal: sig }
   );

   let debounce: ReturnType<typeof setTimeout>;
   input.addEventListener(
    "input",
    () => {
     suggestions?.classList.toggle("suggestions-hidden", input!.value.trim() !== "");
     clearTimeout(debounce);
     debounce = setTimeout(async () => {
      const q = input!.value.trim().toLowerCase();
      const submitBtn = document.getElementById("search-submit");
      if (!q) {
       hint!.textContent = "아티스트 · 앨범 · 인터뷰 · 공연정보";
       submitBtn?.classList.remove("has-results");
       return;
      }
      await loadSearchIndex();
      const count = searchCache.index.filter((item: any) => {
       if (item.displayTitle.toLowerCase().includes(q)) return true;
       return Object.values(item.fields as Record<string, string>).some(v => v.toLowerCase().includes(q));
      }).length;
      hint!.textContent = count > 0 ? `${count} result${count > 1 ? "s" : ""}` : "검색결과가 없습니다";
      submitBtn?.classList.toggle("has-results", count > 0);
     }, 100);
    },
    { signal: sig }
   );

   form?.addEventListener(
    "submit",
    e => {
     e.preventDefault();
     const q = input!.value.trim();
     if (!q) return;
     closeDialog();
     window.location.href = `/search?q=${encodeURIComponent(q)}`;
    },
    { signal: sig }
   );

   // 페이지 로드마다 인덱스 백그라운드 프리패치
   loadSearchIndex();
  }

  // ── 메뉴 aside ────────────────────────────────────────────
  function initMenu() {
   const openBtn = document.getElementById("menu-open-btn");
   const dialog = document.getElementById("menu-dialog") as HTMLDialogElement | null;
   const closeBtn = document.getElementById("close-menu");

   if (!openBtn || !dialog) return;

   const ac = new AbortController();
   const sig = ac.signal;
   const prev = (openBtn as any).__menuAC as AbortController | undefined;
   prev?.abort();
   (openBtn as any).__menuAC = ac;

   openBtn.addEventListener("click", () => dialog.showModal(), { signal: sig });
   closeBtn?.addEventListener("click", () => dialog.close(), { signal: sig });
   dialog.addEventListener(
    "click",
    e => {
     if (e.target === dialog) dialog.close();
    },
    { signal: sig }
   );
   dialog.querySelectorAll("a[href]").forEach(a => {
    a.addEventListener("click", () => dialog.close(), { signal: sig });
   });
  }

  document.addEventListener("astro:page-load", initHeader);
  document.addEventListener("astro:page-load", initTheme);
  document.addEventListener("astro:page-load", initSearch);
  document.addEventListener("astro:page-load", initMenu);
  document.addEventListener("astro:page-load", initTopBtn);

  // ── 스크롤 방향 감지 ─────────────────────────────────────
  (function initScrollNav() {
   const COOLDOWN = 200;
   let lastToggle = 0;
   let isHidden = false;

   function isNearBottom(margin = 200) {
    return window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - margin;
   }

   function setNav(hide: boolean) {
    const now = Date.now();
    if (hide === isHidden || now - lastToggle < COOLDOWN) return;
    const nav = document.querySelector(".nav-links");
    if (!nav) return;
    isHidden = hide;
    lastToggle = now;
    nav.classList.toggle("nav-hidden", hide);
   }

   function attachLenis(lenis: any) {
    lenis.on("scroll", ({ scroll, velocity }: { scroll: number; velocity: number }) => {
     if (scroll < 80 || isNearBottom()) {
      setNav(false);
      return;
     }
     if (velocity > 0.3) setNav(true);
     else if (velocity < -0.3) setNav(false);
    });
   }

   if ((window as any).__lenis) {
    attachLenis((window as any).__lenis);
    return;
   }

   setTimeout(() => {
    if ((window as any).__lenis) {
     attachLenis((window as any).__lenis);
     return;
    }

    let lastY = window.scrollY;
    let accumulated = 0;
    const THRESHOLD = 12;

    window.addEventListener(
     "scroll",
     () => {
      const currentY = window.scrollY;
      accumulated += currentY - lastY;
      lastY = currentY;

      if (currentY < 80 || isNearBottom()) {
       setNav(false);
       accumulated = 0;
       return;
      }
      if (accumulated > THRESHOLD) {
       setNav(true);
       accumulated = 0;
      } else if (accumulated < -THRESHOLD) {
       setNav(false);
       accumulated = 0;
      }
     },
     { passive: true }
    );
   }, 200);
  })();

  // ── Top 버튼 ─────────────────────────────────────────────
  function initTopBtn() {
   const btn = document.getElementById("top-btn");
   if (!btn) return;

   const THRESHOLD = window.innerHeight;

   function onScroll() {
    btn!.classList.toggle("visible", window.scrollY > THRESHOLD);
   }

   btn.addEventListener("click", () => {
    if ((window as any).__lenis) {
     (window as any).__lenis.scrollTo(0, { duration: 1.2 });
    } else {
     window.scrollTo({ top: 0, behavior: "smooth" });
    }
   });

   window.addEventListener("scroll", onScroll, { passive: true });
   onScroll();
  }
 </script>
</header>

<!-- Search / 메뉴 모달: header 밖에 두어 z-index 충돌 방지 -->
<Search />
<NavMenu />
