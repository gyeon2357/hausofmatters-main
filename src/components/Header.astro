---
import TextSlider from "../components/TextSlider.astro";
import Search from "../components/Search.astro";
import SiteMenu from "../components/SiteMenu.astro";
---

<!-- 로고를 가운데 두고 좌우에 텍스트 버튼 배치: 왼쪽 테마, 오른쪽 검색+Menu.
     데스크톱/모바일 모두 동일 — 하위 메뉴/인스타그램/메일은 Menu가 여는 SiteMenu 패널에서 노출 -->
<header class="full-bleed" transition:persist>
 <section class="header-bar">
  <button id="theme-toggle" aria-label="다크모드 전환" class="text-btn theme-toggle theme-toggle-btn">
   <TextSlider content="Dark" />
  </button>

  <a href="/" class="logo-link">
   <img id="site-logo" src="/images/logo.png" alt="HAUSOFMATTERS" class="logo" />
  </a>

  <div class="header-actions">
   <!-- Search 링크 → button으로 교체, 모달 직접 제어 -->
   <button
    id="search-open-btn"
    aria-label="검색"
    aria-haspopup="dialog"
    aria-controls="search-dialog"
    aria-expanded="false"
    class="text-btn search-btn"
   >
    <TextSlider content="Search" />
   </button>
   <!-- 하위 메뉴/인스타그램/Contact를 담은 SiteMenu 패널을 여닫는 버튼 — 라벨은 항상 "Menu" -->
   <button
    id="site-menu-open"
    aria-label="전체 메뉴 열기"
    aria-haspopup="dialog"
    aria-controls="site-menu-dialog"
    aria-expanded="false"
    class="text-btn menu-btn"
   >
    <TextSlider content="Menu" />
   </button>
  </div>
 </section>
</header>

<!-- 카테고리 내비게이션: 헤더와 분리해 화면 하단에 고정 -->
<nav class="pill-nav full-bleed" aria-label="주요 메뉴" transition:persist>
 <ul class="pill-links">
  <li>
   <a href="/magazine/" data-astro-prefetch><TextSlider content="Magazine" /></a>
  </li>
  <li>
   <a href="/albums/" data-astro-prefetch><TextSlider content="Album" /></a>
  </li>
  <li>
   <a href="/interview/" data-astro-prefetch><TextSlider content="Interview" /></a>
  </li>
  <li>
   <a href="/feature/" data-astro-prefetch><TextSlider content="Feature" /></a>
  </li>
 </ul>
</nav>

<style>
  header {
   display: flex;
   flex-direction: column;

   position: sticky;
   top: 0;
   z-index: 100;
   /* 맨 위에서는 배경 없이 콘텐츠 위에 떠 있다가, 스크롤하면 흰 바가 나타나 텍스트를
      가려주지 않게 함 (아래 .header--scrolled, 스크립트가 스크롤 위치에 따라 토글) */
   background: transparent;
   transition: background-color 0.2s ease;
   /* 모바일 Safari는 주소창이 접히는 스크롤 중에 position:sticky 요소를 한 프레임
      늦게 따라오는 경우가 있어서, 스크롤된 뒤에도 헤더 위로 콘텐츠가 잠깐 보이는
      현상이 있었음 — 별도 GPU 레이어로 승격시켜 리페인트를 더 즉각적으로 만듦 */
   transform: translateZ(0);

   font-family: var(--info-font);

   padding: 1rem;

   /* header 박스 자체는 내용(.header-bar)보다 넓게 패딩이 있는데, 그 빈 공간이
      Search/Menu 패널의 닫기 버튼(z-index 100인 header보다 낮은 90)을 가로채지 않도록
      기본은 클릭을 투과시키고, 실제 내용이 있는 .header-bar만 다시 받게 함 */
   pointer-events: none;
  }

  header.header--scrolled {
   background: var(--color-bg);
  }

  /* 테마(좌) - 로고(중앙) - 검색/Menu(우) 3열 그리드. 좌우 칸의 콘텐츠 폭/노출 여부가
     달라도(예: 모바일에서 테마 버튼만 숨김) 로고가 항상 정중앙에 오도록,
     1fr의 암묵적 최소폭(auto)을 minmax(0, 1fr)로 제거해 두 칸을 강제로 동일하게 둠 */
  .header-bar {
   pointer-events: auto;
   display: grid;
   grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
   align-items: center;
   width: 100%;
  }

  .logo-link {
   /* theme-toggle이 모바일에서 display:none이 되면 grid auto-placement가
      나머지 아이템을 앞 칸으로 당겨버려서, 항상 2번째 칸으로 명시 고정 */
   grid-column: 2;
   display: flex;
   align-items: center;
   justify-content: center;
  }

  .logo {
   display: block;
   height: 1.05rem; /* 1.5rem의 70% */
   width: auto;
  }

  .theme-toggle {
   grid-column: 1;
   justify-self: start;
  }

  .header-actions {
   grid-column: 3;
   display: flex;
   align-items: center;
   gap: 1rem;
   justify-self: end;
  }

  /* 카테고리 pill 내비게이션 — 화면 하단에 고정. 내비 바 자체엔 배경을 두지 않고,
     각 pill 버튼이 테마색 배경을 각자 갖고 있어 어떤 콘텐츠 위에서도 또렷하게 보임 */
  .pill-nav {
   position: fixed;
   left: 0;
   right: 0;
   bottom: 0;
   z-index: 100;
   width: 100%;

   padding: 1rem;

   overflow-x: auto;
   scrollbar-width: none;
  }

  .pill-nav::-webkit-scrollbar {
   display: none;
  }

  .pill-links {
   display: flex;
   justify-content: center;
   list-style: none;
   gap: 0.5rem;
   margin: 0;
   padding: 0;
   width: max-content;
   min-width: 100%;
  }

  .pill-links a {
   display: flex;
   align-items: center;
   white-space: nowrap;
   font-size: var(--font-size-s);
   padding: var(--btn-padding);
   background: var(--color-bg);
   border: 1px solid var(--border-color);
   border-radius: 999px;
   transition:
    background-color 0.2s ease,
    color 0.2s ease;
  }

  /* color-mix(…, transparent)는 불투명한 기본 배경을 "희석"해버려서(거의 투명하게 만듦)
     pill처럼 배경 자체가 핵심 스타일인 요소엔 안 맞음 — 모바일은 탭하면 hover가 그대로
     눌러붙어서("sticky hover") 계속 반투명하게 보이는 문제로 이어졌음. transparent 대신
     기존 배경색과 섞어서 완전히 불투명한 톤 변화만 주도록 함 */
  .pill-links a:hover {
   color: inherit;
   background: color-mix(in srgb, currentColor 8%, var(--color-bg));
  }

  .pill-links a.current {
   background: var(--color-text);
   border-color: var(--color-text);
   color: var(--color-bg);
   /* global.css의 .current { font-weight: 700 }를 그대로 두면 페이지 이동 시마다
      글자 폭이 바뀌어 pill 크기가 들썩이는("깜빡임") 원인이 됨 — 배경 반전만으로
      충분히 구분되니 굵기는 바꾸지 않음 */
   font-weight: inherit;
  }

  /* global.css의 a:focus { background-color: lightgrey; &:not(:focus-visible){transparent}
     &:focus-visible{opacity:.5; transparent} }가 포커스(마우스 클릭/터치 모두 포함 —
     모바일 Safari는 탭도 focus-visible로 취급함)를 받을 때마다 pill의 배경을 지워버려서
     누를 때마다 버튼이 투명해지는 것처럼 보였음 — focus-visible 여부와 상관없이
     상태별 배경을 그대로 복원하고, 키보드 포커스 표시는 outline으로 대체 */
  .pill-links a:focus {
   background: var(--color-bg);
   opacity: 1;
  }

  .pill-links a.current:focus {
   background: var(--color-text);
  }

  .pill-links a:focus-visible {
   outline: 2px solid currentColor;
   outline-offset: 2px;
  }

  @media screen and (max-width: 768px) {
   header {
    padding: 0.75rem;
   }

   .logo {
    height: 0.88rem; /* 1.1rem의 80% */
   }

   .pill-nav {
    padding: 0.75rem;
   }

   .pill-links {
    /* 실기기 소형 화면에서 pill 5개가 잘리지 않도록 간격/글자 크기를 살짝 줄임 */
    gap: 0.35rem;
   }

   .pill-links a {
    font-size: var(--font-size-xs);
   }
  }

 </style>

 <script>
  // 끝 슬래시 유무와 무관하게 비교하기 위해 "/" 자체가 아닌 한 끝 슬래시를 떼어냄 —
  // trailingSlash 설정상 "/albums"와 "/albums/" 둘 다 같은 페이지로 렌더되는데,
  // 내비게이션 href는 전부 끝 슬래시 포함("/albums/")이라, 끝 슬래시 없이 직접 주소를
  // 입력해 들어온 경우(북마크 등) path.startsWith(href)가 항상 false가 되어 active
  // 표시가 전혀 안 되는 버그가 있었음
  function stripTrailingSlash(p: string) {
   return p.length > 1 && p.endsWith("/") ? p.slice(0, -1) : p;
  }

  function initHeader() {
   const path = stripTrailingSlash(window.location.pathname);
   // "header a[href]"처럼 느슨하게 쓰면 매거진 상세 등 페이지 자체의 <header class="title-header">
   // (예: "View All" 백링크)까지 걸려서 무관한 링크에 current가 붙는 버그가 있었음 —
   // 사이트 전역 헤더(.full-bleed)로만 범위를 한정
   document.querySelectorAll("header.full-bleed a[href], .pill-nav a[href], .site-menu-links a[href]").forEach(a => {
    const href = a.getAttribute("href");
    if (!href || href === "/") return;
    const hrefPath = stripTrailingSlash(href);
    // 정확히 같은 페이지이거나("/magazine"), 그 하위 상세 페이지("/magazine/hom-1")일 때만
    // — 경계(슬래시) 없이 이어 붙여 비교하면 "/album"이 "/albums"에도 매치되는 식의
    // 오탐이 생길 수 있어 반드시 "/"를 넣어 구분함
    const isCurrent = path === hrefPath || path.startsWith(hrefPath + "/");
    a.classList.toggle("current", isCurrent);
    // 클래스만으로는 스크린리더가 "현재 페이지"임을 알 수 없어 aria-current도 함께 반영
    if (isCurrent) a.setAttribute("aria-current", "page");
    else a.removeAttribute("aria-current");
   });
  }

  // pill-nav가 화면 하단에 고정되므로 실제 높이를 CSS 변수로 노출 — body 하단 여백(footer 가림 방지)에 사용
  function updateBottomNavHeight() {
   const nav = document.querySelector(".pill-nav");
   if (nav) document.documentElement.style.setProperty("--bottom-nav-height", nav.getBoundingClientRect().height + "px");
  }

  // SiteMenu 패널이 Menu 버튼 바로 아래 가깝게 붙도록, header 전체(아래 패딩 포함)가
  // 아니라 버튼이 실제로 있는 header-bar 줄의 bottom 좌표만 노출
  function updateHeaderHeight() {
   const bar = document.querySelector(".header-bar");
   if (bar) document.documentElement.style.setProperty("--menu-anchor-top", bar.getBoundingClientRect().bottom + "px");
  }

  // 맨 위에서는 배경 없이 콘텐츠 위에 떠 있다가, 스크롤하면 흰 바(테마 배경)가 나타나
  // 텍스트가 콘텐츠에 섞여 안 보이는 걸 방지.
  function updateHeaderScrollBg() {
   document.querySelector("header.full-bleed")?.classList.toggle("header--scrolled", window.scrollY > 4);
  }

  // IntersectionObserver(문서 맨 위 #scroll-sentinel 관찰)를 기본으로 쓰되 — iOS Safari는
  // 관성 스크롤 중 scroll 이벤트를 거의/전혀 쏘지 않아서, scroll 이벤트만으로는 빠르게
  // 스크롤할 때 헤더 배경이 갱신될 기회를 놓쳐 콘텐츠가 헤더 위로 비쳐 보였음 —
  // IntersectionObserver는 메인 스레드 이벤트 루프에 의존하지 않아 이 문제가 없음.
  // 그래도 간헐적으로 놓치는 경우가 보고돼서, scroll 이벤트와 bfcache 복원(pageshow)
  // 시점에도 같은 상태 동기화 함수를 한 번 더 걸어 이중으로 보강함.
  // header는 transition:persist라 리스너가 페이지 이동마다 쌓이지 않도록 AbortController로
  // 이전 리스너를 정리하고 새로 바인딩
  function initHeaderScrollBg() {
   const header = document.querySelector("header.full-bleed") as HTMLElement | null;
   if (!header) return;

   updateHeaderScrollBg();

   const ac = new AbortController();
   const prev = (header as any).__scrollBgAC as AbortController | undefined;
   prev?.abort();
   (header as any).__scrollBgAC = ac;

   const sentinel = document.getElementById("scroll-sentinel");
   if (sentinel) {
    const observer = new IntersectionObserver(updateHeaderScrollBg, { threshold: 0 });
    observer.observe(sentinel);
    ac.signal.addEventListener("abort", () => observer.disconnect());
   }

   window.addEventListener("scroll", updateHeaderScrollBg, { passive: true, signal: ac.signal });
   window.addEventListener("pageshow", updateHeaderScrollBg, { signal: ac.signal });
   // 모바일에서 Search/Menu를 showModal()로 열었다 닫으면, 배경 콘텐츠가 inert였던 동안
   // IntersectionObserver/scroll 이벤트가 갱신될 기회를 놓쳐 헤더가 스크롤된 상태인데도
   // 다시 투명하게 "뚫려" 보이는 경우가 있었음 — Search/SiteMenu가 닫힐 때 이 이벤트를
   // 쏴서 명시적으로 다시 동기화함 (이름 충돌 방지용 네임스페이스)
   document.addEventListener("hom:resync-header-bg", updateHeaderScrollBg, { signal: ac.signal });
   // 키보드가 열렸다 닫히는 것도 뷰포트 리사이즈라 같은 증상을 낼 수 있어 보강
   window.addEventListener("resize", updateHeaderScrollBg, { passive: true, signal: ac.signal });
  }

  // 데스크톱 헤더의 테마 버튼 + MobileMenu 안의 테마 버튼, 두 개를 함께 동기화
  function initTheme() {
   const btns = Array.from(document.querySelectorAll<HTMLElement>(".theme-toggle-btn"));
   if (btns.length === 0) return;

   const getEffective = () =>
    document.documentElement.getAttribute("data-theme") || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");

   const syncLabels = (theme: string) => {
    btns.forEach(btn => {
     const inner = btn.querySelector(".oh__inner");
     if (inner) inner.textContent = theme === "dark" ? "Light" : "Dark";
    });
   };

   const apply = (theme: string) => {
    document.documentElement.setAttribute("data-theme", theme);
    localStorage.setItem("theme", theme);
    syncLabels(theme);
    const logo = document.getElementById("site-logo") as HTMLImageElement | null;
    if (logo) logo.src = theme === "dark" ? "/images/logo-w.png" : "/images/logo.png";

    // iOS Safari는 <meta name="theme-color">로 상태바/툴바 배경을 입히는데, 이게 실제
    // 페이지 배경(--color-bg)과 어긋나면 스크롤 중 그 틈으로 콘텐츠가 비쳐 보임 —
    // 토글할 때마다 같이 갱신(최초 로드 시 값은 BaseLayout의 인라인 스크립트가 맞춰줌)
    const themeColorMeta = document.querySelector('meta[name="theme-color"]');
    if (themeColorMeta) themeColorMeta.setAttribute("content", theme === "dark" ? "#020202" : "#ffffff");

    // 일부 모바일 브라우저는 position:fixed/sticky 요소의 배경이 CSS 커스텀 프로퍼티
    // (--color-bg)로만 바뀌면 리페인트를 건너뛰어, 라이트→다크→라이트로 되돌려도
    // 상/하단 바가 이전 테마 배경인 채로 남는 경우가 있음 — 강제로 리페인트시킴
    [document.querySelector("header.full-bleed"), document.querySelector(".pill-nav")].forEach(el => {
     if (!(el instanceof HTMLElement)) return;
     const prevDisplay = el.style.display;
     el.style.display = "none";
     void el.offsetHeight;
     el.style.display = prevDisplay;
    });
   };

   const initial = getEffective();
   syncLabels(initial);
   const logoInit = document.getElementById("site-logo") as HTMLImageElement | null;
   if (logoInit) logoInit.src = initial === "dark" ? "/images/logo-w.png" : "/images/logo.png";

   btns.forEach(btn => {
    if (btn.dataset.initialized) return;
    btn.dataset.initialized = "true";
    btn.addEventListener("click", () => {
     apply(getEffective() === "dark" ? "light" : "dark");
    });
   });
  }

  // ── Search 인덱스 전역 캐시 ─────────────────────────────
  if (!(window as any).__searchCache) {
   (window as any).__searchCache = { index: [] as any[], loaded: false, promise: null as Promise<void> | null };
  }
  const searchCache = (window as any).__searchCache as { index: any[]; loaded: boolean; promise: Promise<void> | null };

  function loadSearchIndex(): Promise<void> {
   if (searchCache.loaded) return Promise.resolve();
   if (searchCache.promise) return searchCache.promise;
   searchCache.promise = fetch("/search-index.json")
    .then(r => r.json())
    .then(data => {
     searchCache.index = data;
     searchCache.loaded = true;
    });
   return searchCache.promise;
  }

  // ── Search 모달 ──────────────────────────────────────────
  function initSearch() {
   // dialog는 페이지마다 새로 렌더링 → 매번 fresh하게 조회
   const openBtn = document.getElementById("search-open-btn");
   const dialog = document.getElementById("search-dialog") as HTMLDialogElement | null;
   const input = document.getElementById("search-input") as HTMLInputElement | null;
   const closeBtn = document.getElementById("close-dialog");
   const form = document.getElementById("search-form");
   const hint = document.getElementById("search-hint");
   const suggestions = document.getElementById("search-suggestions");

   if (!openBtn || !dialog || !input) return;

   // AbortController로 이전 페이지의 리스너를 정리하고 새로 바인딩
   const ac = new AbortController();
   const sig = ac.signal;
   const prev = (openBtn as any).__searchAC as AbortController | undefined;
   prev?.abort();
   (openBtn as any).__searchAC = ac;

   function openDialog() {
    dialog!.showModal();
    openBtn!.setAttribute("aria-expanded", "true");
    input!.value = "";
    hint!.textContent = "";
    hint!.classList.remove("search-hint--emphasized");
    // 처음 열었을 때는 추천 5개 중 3개만(.suggestions-expanded 없는 기본 상태)
    suggestions?.classList.remove("suggestions-hidden", "suggestions-expanded");
    setTimeout(() => input!.focus(), 50);
   }

   function closeDialog() {
    dialog!.close();
   }

   // Escape 키로 닫히는 경우(브라우저 기본 동작) 등 닫히는 경로가 여러 개라,
   // dialog 자체의 close 이벤트 하나로 aria-expanded 동기화를 통일
   dialog.addEventListener(
    "close",
    () => {
     openBtn!.setAttribute("aria-expanded", "false");
     // showModal()로 열려있는 동안 배경(헤더 포함)이 inert라, 스크롤 상태 감지가 갱신될
     // 기회를 놓쳐서 닫은 뒤 헤더가 다시 투명해 보일 수 있었음 — 직접 재동기화를 요청
     document.dispatchEvent(new Event("hom:resync-header-bg"));
    },
    { signal: sig }
   );

   // showModal() 특성상 열려있는 동안 openBtn 자체가 inert(클릭 불가)라
   // 트리거 버튼을 닫기로 재사용할 수 없음 — 별도 닫기 버튼(closeBtn) 필요
   openBtn.addEventListener("click", openDialog, { signal: sig });
   closeBtn?.addEventListener("click", closeDialog, { signal: sig });

   dialog.addEventListener(
    "click",
    e => {
     if (e.target === dialog) closeDialog();
    },
    { signal: sig }
   );

   let debounce: ReturnType<typeof setTimeout>;
   input.addEventListener(
    "input",
    () => {
     clearTimeout(debounce);
     const submitBtn = document.getElementById("search-submit");
     const q = input!.value.trim();

     if (!q) {
      // 입력을 지워 다시 빈 상태가 되면 디바운스 없이 바로 초기 상태(추천 3개)로 복귀
      hint!.textContent = "";
      hint!.classList.remove("search-hint--emphasized");
      submitBtn?.classList.remove("has-results");
      suggestions?.classList.remove("suggestions-hidden", "suggestions-expanded");
      return;
     }

     debounce = setTimeout(async () => {
      await loadSearchIndex();
      const lower = q.toLowerCase();
      const count = searchCache.index.filter((item: any) => {
       if (item.displayTitle.toLowerCase().includes(lower)) return true;
       return Object.values(item.fields as Record<string, string>).some(v => v.toLowerCase().includes(lower));
      }).length;
      submitBtn?.classList.toggle("has-results", count > 0);

      if (count > 0) {
       // 결과가 있으면 추천 영역은 숨기고(제출하면 /search 결과 페이지에서 확인) 개수만 안내
       hint!.textContent = `${count} result${count > 1 ? "s" : ""}`;
       hint!.classList.remove("search-hint--emphasized");
       suggestions?.classList.add("suggestions-hidden");
       suggestions?.classList.remove("suggestions-expanded");
      } else {
       // 결과가 없으면 추천 5개를 전부 보여주고(빈 손으로 돌려보내지 않음), 안내 문구를
       // 그 위에 여백을 넉넉히 줘서 눈에 띄게 함
       hint!.textContent = "검색결과가 없습니다";
       hint!.classList.add("search-hint--emphasized");
       suggestions?.classList.remove("suggestions-hidden");
       suggestions?.classList.add("suggestions-expanded");
      }
     }, 100);
    },
    { signal: sig }
   );

   form?.addEventListener(
    "submit",
    e => {
     e.preventDefault();
     const q = input!.value.trim();
     if (!q) return;
     closeDialog();
     window.location.href = `/search?q=${encodeURIComponent(q)}`;
    },
    { signal: sig }
   );

   // 페이지 로드마다 인덱스 백그라운드 프리패치
   loadSearchIndex();
  }

  document.addEventListener("astro:page-load", initHeader);
  document.addEventListener("astro:page-load", initTheme);
  document.addEventListener("astro:page-load", initSearch);
  document.addEventListener("astro:page-load", updateBottomNavHeight);
  document.addEventListener("astro:page-load", updateHeaderHeight);
  document.addEventListener("astro:page-load", initHeaderScrollBg);
  window.addEventListener("resize", updateBottomNavHeight, { passive: true });
  window.addEventListener("resize", updateHeaderHeight, { passive: true });
 </script>
</header>

<!-- Search 모달 / 전체 메뉴 패널: header 밖에 두어 z-index 충돌 방지 -->
<Search />
<SiteMenu />
