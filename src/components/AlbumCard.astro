---
import type { CollectionEntry } from "astro:content";

type Props = {
 album: CollectionEntry<"albums">;
};

const { album } = Astro.props;
---

<a class="album-card" href={`/albums/${album.id}`}>
 <div>
  {album.data.image && <img src={album.data.image.src} alt={album.data.image.alt} />}
 </div>
 <h3>{album.data.name}</h3>
 <p>{new Date(album.data.release).getFullYear()}</p>
</a>

<style>
 div {
  aspect-ratio: 1;
  grid-area: img;
  background: var(--color-placeholder);
 }
 h3,
 p {
  margin: 0;
 }
 h3 {
  grid-area: title;
 }
 p {
  justify-self: end;
  grid-area: meta;
 }
</style>
