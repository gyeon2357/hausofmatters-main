---
import TextSlider from "../components/TextSlider.astro";
import Separator from "../components/Separator.astro";

type Props = {
 albumsTotal: number;
 title?: string;
};

const { albumsTotal, title = "Review" } = Astro.props;
---

<header class="title-header title-header--initial">
 <div class="title-row">
  <h1><TextSlider content={title} /></h1>
  <span class="total-num"><TextSlider content={"(" + albumsTotal + ")"} /></span>
 </div>
 <section>
  <div class="sort-group">
   <button data-sort><TextSlider content="A-Z" /></button>
   <button data-sort-date><TextSlider content="Date" /></button>
   <button data-recommended><TextSlider content="Pick" /></button>
   <button data-shuffle><TextSlider content="Shuffle" /></button>
  </div>
 </section>
 <a class="nav-link" href="/albums">Back</a>
</header>

<Separator />

<style>
 .title-row {
  display: flex;
  align-items: center;
  gap: 0.4rem;
 }

 .title-row h1 {
  text-wrap: nowrap;
 }

 section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
 }

 .sort-group {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin: 0;
  padding: 0;
 }

 .sort-group button {
  display: flex;
  align-items: center;
  font-size: var(--font-size-l);
 }

 .sort-group > button::before {
  content: "\2610";
  display: inline-block;
  font-size: inherit;
  text-decoration: none;

  margin-right: 0.25rem;
 }

 .sort--active {
  opacity: 0.4;
 }

 .total-num {
  font-size: var(--font-size-s);
  font-weight: 700;
  vertical-align: middle;
 }

 @media only screen and (max-width: 768px) {
  .sort-group {
   gap: 0.625rem;
  }
 }
</style>
<script src="../scripts/gridActions.js"></script>
