---
import TextSlider from "../components/TextSlider.astro";
import Separator from "../components/Separator.astro";
import Search from "../components/Search.astro";
import Cross from "../assets/images/cross.svg";

type Props = {
 albumsTotal: number;
 title?: string;
};

const { albumsTotal, title = "Review" } = Astro.props;
---

<header class="title-header title-header--initial">
 <div class="title-row">
  <h2><TextSlider content={title} /></h2>
  <span class="total-num"><TextSlider content={"(" + albumsTotal + ")"} /></span>
 </div>
 <section>
  <div class="sort-group">
   <button data-sort><TextSlider content="A-Z" /></button>
   <button data-sort-date><TextSlider content="Date" /></button>
   <button data-recommended><TextSlider content="Pick" /></button>
   <button data-shuffle><TextSlider content="Shuffle" /></button>

   <div class="search-group">
    <button data-search class="search"><TextSlider content="Search" /></button>
    <button data-clear class="clear hidden" aria-label="Clear search">
     <Cross width={16} height={16} />
    </button>
   </div>
  </div>
 </section>
 <a class="back" href="/albums">/ Back</a>
</header>

<Separator />
<Search />

<style>
 .title-row {
  display: flex;
  align-items: baseline;
  gap: 0.4rem;
 }

 section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
 }

 .sort-group {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin: 0;
  padding: 0;
 }

 .sort-group button {
  display: flex;
  align-items: center;
 }

 .sort-group button::before {
  content: "\2610";
  display: inline-block;
  font-size: inherit;
  text-decoration: none;

  margin-right: 0.25rem;
 }

 .search-group {
  display: flex;
  align-items: center;
  position: relative;

  margin-left: 0.75rem;
 }

 .search-group:has(> .search--active) {
  margin-left: 1rem;
 }
 .search-group:has(> .search--active)::before {
  pointer-events: none;
  content: "";
  position: absolute;
  left: -1rem;
  right: -1rem;
  top: -0.5rem;
  bottom: -0.5rem;
  border: 1px solid;
 }
 .search--active:focus-visible {
  color: inherit;
 }

 .search-group .clear {
  margin-left: 1rem;
 }

 .total-num {
  font-size: 75%;
  font-weight: 700;
  vertical-align: text-top;
 }

 @media only screen and (max-width: 900px) {
  .title-header {
   display: block;
  }

  .sort-group {
   flex-direction: column;
   align-items: start;

   margin-top: 0.75rem;
   gap: 0.375rem;
  }

  .search-group {
   margin: 0;
  }

  .back {
  }
 }
</style>
<script src="../scripts/gridActions.js"></script>
