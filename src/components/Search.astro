---
import Cross from "../assets/images/cross.svg";
---

<dialog id="search-dialog">
 <form id="search-form">
  <button id="close-dialog" type="button" aria-label="Close search">
   <Cross width={16} height={16} />
  </button>

  <div class="search-input-row">
   <label for="search-input" class="sr-only">Search:</label>
   <input
    aria-label="search"
    type="text"
    id="search-input"
    placeholder="검색어를 입력하세요"
    maxlength="30"
    autocomplete="off"
    autocorrect="off"
    spellcheck="false"
   />
   <button type="submit" id="search-submit">Search</button>
  </div>

  <p id="search-hint" class="search-hint">Album · Magazine · Interview · Feature</p>
 </form>
</dialog>

<style>
 dialog {
  border: 0;
  padding: 2.5rem 3rem 3rem;

  background: var(--color-text);
  color: var(--color-bg);
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  margin: 0;
 }

 dialog::backdrop {
  background: color-mix(in srgb, var(--color-text) 40%, transparent);
  backdrop-filter: blur(4px);
 }

 #close-dialog {
  position: absolute;
  top: 0.75rem;
  right: 0.75rem;
  background: none;
  border: none;
  color: inherit;
  cursor: pointer;
  opacity: 0.8;
  transition: opacity 0.25s;
  padding: 0.25rem;
  display: flex;
  align-items: center;
 }
 #close-dialog:hover {
  opacity: 1;
 }

 .search-input-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  border-bottom: 1px solid color-mix(in srgb, var(--color-bg) 40%, transparent);
  padding-bottom: 0.5rem;
  margin-top: 1rem;
 }

 input {
  background: none;
  flex: 1;
  font-size: var(--font-size-l);
  border: 0;
  color: inherit;

  padding: 0.25rem 0;
  font-family: inherit;
  font-size: 1rem;
 }
 input:focus {
  outline: none;
 }
 input::placeholder {
  color: inherit;
  opacity: 0.3;
 }

 #search-submit {
  background: none;
  border: none;
  color: inherit;
  font-size: var(--font-size-s, 0.8rem);

  cursor: pointer;
  padding: 0 0.25rem;
  opacity: 0.5;
  transition: opacity 0.15s;
  font-family: inherit;
  flex-shrink: 0;
  white-space: nowrap;
 }
 #search-submit:hover {
  opacity: 1;
 }

 .search-hint {
  font-size: var(--font-size-s, 0.8rem);
  opacity: 0.45;
  margin: 0.75rem 0 0;
  min-height: 1.4em;
 }
</style>
