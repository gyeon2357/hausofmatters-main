---
import { getCollection } from "astro:content";

// 마크다운 서식을 걷어내고 본문 일부만 미리보기로 보여줄 때 사용
function excerpt(markdown: string, maxLength = 60): string {
 const plain = markdown
  .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
  .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
  .replace(/[*_`#>]/g, "")
  .replace(/\s+/g, " ")
  .trim();
 return plain.length > maxLength ? plain.slice(0, maxLength).trim() + "…" : plain;
}

const allAlbums = await getCollection("albums");
const latestAlbums = allAlbums
 .sort((a, b) => new Date(b.data.release).getTime() - new Date(a.data.release).getTime())
 .slice(0, 2)
 .map(album => ({
  href: `/albums/${album.id}`,
  type: "Album",
  title: album.data.name,
  image: album.data.image?.src ?? `/images/albums/${album.id}.jpg`,
  imageAlt: album.data.image?.alt ?? album.data.name,
  excerpt: excerpt(album.body ?? ""),
 }));

const allInterviews = await getCollection("interview");
const latestInterviews = allInterviews
 .filter(i => i.data.published)
 .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
 .slice(0, 1)
 .map(interview => ({
  href: `/interview/${interview.id}`,
  type: "Interview",
  title: interview.data.artist ?? interview.id,
  image: interview.data.coverImage?.src ?? "",
  imageAlt: interview.data.coverImage?.alt ?? interview.data.artist ?? interview.id,
  excerpt: excerpt(interview.body ?? ""),
 }));

const suggestions = [...latestAlbums, ...latestInterviews];
---

<dialog id="search-dialog" class="anchored-panel" aria-label="검색">
 <form id="search-form">
  <!-- showModal()로 여는 진짜 모달이라 바깥 Search 버튼이 열려있는 동안 inert 처리됨 —
       그래서 Menu처럼 트리거 버튼으로 토글할 수 없고, 안쪽에 별도 닫기 버튼이 필요함 -->
  <button id="close-dialog" type="button" aria-label="Close search" class="anchored-panel-close">
   <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round">
    <path d="M2 2l12 12M14 2 2 14" />
   </svg>
  </button>

  <div class="search-input-row">
   <label for="search-input" class="sr-only">Search:</label>
   <input
    aria-label="search"
    type="text"
    id="search-input"
    placeholder="검색어를 입력하세요"
    maxlength="30"
    autocomplete="off"
    autocorrect="off"
    spellcheck="false"
   />
   <button type="submit" id="search-submit">Search</button>
  </div>

  <div id="search-suggestions" class="search-suggestions">
   <p class="suggestions-label">추천 컨텐츠</p>
   <div class="suggestion-list">
    {
     suggestions.map(item => (
      <a class="suggestion-card" href={item.href} data-astro-prefetch>
       <div class="suggestion-thumb">{item.image && <img src={item.image} alt={item.imageAlt} loading="lazy" />}</div>
       <div class="suggestion-body">
        <span class="suggestion-type">{item.type}</span>
        <p class="suggestion-title">{item.title}</p>
        <p class="suggestion-excerpt">{item.excerpt}</p>
       </div>
      </a>
     ))
    }
   </div>
  </div>

  <p id="search-hint" class="search-hint">아티스트 · 앨범 · 인터뷰 · 공연정보</p>
 </form>
</dialog>

<style>
 /* 공통 위치/크기/닫기 버튼(.anchored-panel)은 global.css 참고 — 여기선 검색 전용 내부 레이아웃만 */
 .search-input-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  border-bottom: 1px solid color-mix(in srgb, var(--color-text) 40%, transparent);
  padding-bottom: 0.5rem;
  margin-top: 1rem;
 }

 input {
  background: none;
  flex: 1;

  border: 0;
  color: inherit;

  padding: 0.25rem 0;
  font-family: inherit;
  font-size: var(--font-size-base);
 }
 input:focus {
  outline: none;
 }
 input::placeholder {
  color: inherit;
  opacity: 0.3;
 }

 #search-submit {
  background: none;
  border: none;
  color: inherit;
  font-size: var(--font-size-s);

  cursor: pointer;
  padding: 0 0.25rem;
  opacity: 0.6;
  transition: opacity 0.15s;
  font-family: inherit;
  flex-shrink: 0;
  white-space: nowrap;
 }
 #search-submit.has-results {
  opacity: 1;
 }
 #search-submit:hover {
  opacity: 1;
 }

 .search-hint {
  font-size: var(--font-size-xs);
  opacity: 0.75;
  margin: 0.5rem 0 0;
  min-height: 1.4em;
 }

 .search-suggestions.suggestions-hidden {
  display: none;
 }

 .suggestions-label {
  font-size: var(--font-size-xs);
  opacity: 0.5;
  text-transform: uppercase;
  margin: 1.25rem 0 0.75rem;
 }

 .suggestion-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
 }

 .suggestion-card {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
  color: inherit;
  transition: opacity 0.15s;
 }

 .suggestion-card:hover {
  opacity: 0.7;
 }

 .suggestion-thumb {
  flex-shrink: 0;
  width: 3rem;
  height: 3rem;
  overflow: hidden;
  background: var(--color-placeholder);
 }

 .suggestion-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
 }

 .suggestion-body {
  min-width: 0;
 }

 .suggestion-type {
  font-size: var(--font-size-xs);
  opacity: 0.5;
  text-transform: uppercase;
 }

 .suggestion-title {
  margin: 0;
  font-size: var(--font-size-s);
  font-weight: 700;
  line-height: 1.3;
 }

 .suggestion-excerpt {
  margin: 0.15rem 0 0;
  font-size: var(--font-size-xs);
  opacity: 0.6;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
 }
</style>
