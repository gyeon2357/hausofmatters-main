---
import TextSlider from "../components/TextSlider.astro";
---

<dialog id="menu-dialog">
 <ul class="menu-links">
  <li>
   <a href="/magazine/" data-astro-prefetch><TextSlider content="Magazine" /></a>
  </li>
  <li>
   <a href="/albums/" data-astro-prefetch><TextSlider content="Album" /></a>
  </li>
  <li>
   <a href="/interview/" data-astro-prefetch><TextSlider content="Interview" /></a>
  </li>
  <li>
   <a href="/feature/" data-astro-prefetch><TextSlider content="Feature" /></a>
  </li>
  <li>
   <a href="/about/" data-astro-prefetch><TextSlider content="About" /></a>
  </li>
 </ul>

 <div class="menu-footer">
  <button id="theme-toggle" aria-label="Toggle dark mode">
   <span class="theme-icon" aria-hidden="true">
    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
     <circle cx="12" cy="12" r="4" />
     <path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1" />
    </svg>
    <svg class="icon-moon" viewBox="0 0 24 24" fill="currentColor">
     <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z" />
    </svg>
   </span><TextSlider content="Dark" />
  </button>

  <a href="https://www.instagram.com/hausofmatters/" target="_blank" rel="noopener noreferrer" class="menu-instagram">Instagram</a>
 </div>
</dialog>

<style>
 dialog#menu-dialog {
  border: 0;
  margin: 0;
  padding: 2.5rem 2rem 2rem;
  position: fixed;
  /* 헤더(로고/검색/메뉴 버튼)는 계속 보이고 클릭도 되도록, 그 아래부터만 덮음.
     showModal() 대신 show()로 열기 때문에(아래 Header.astro 참고) ::backdrop이
     생기지 않고, 문서의 나머지 부분도 inert 처리되지 않아 헤더가 계속 살아있음 */
  top: var(--header-height, 4.5rem);
  left: 0;
  right: 0;
  bottom: 0;
  height: auto;
  max-height: none;
  width: 100%;
  max-width: none;
  z-index: 90;

  /* 옆으로 좁게 뜨던 패널 대신 전체 화면을 반투명 블러로 덮음 */
  background: color-mix(in srgb, var(--color-bg) 70%, transparent);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  color: var(--color-text);
  font-family: var(--info-font);
 }

 /* dialog는 [open]이 아니면 UA 기본값이 display:none — 여기서 무조건 display:flex를
    걸면 그 기본값을 덮어써서 닫혀 있어도 항상 보이게 되므로 [open]에만 적용 */
 dialog#menu-dialog[open] {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
 }

 .menu-links {
  display: flex;
  flex-direction: column;
  list-style: none;
  gap: 1.5rem;
  margin: 0;
  padding: 0;
 }

 .menu-links a {
  font-size: var(--font-size-l);
  text-decoration: underline;
  text-underline-position: under;
 }

 .menu-footer {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
 }

 #theme-toggle {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  font: inherit;
  font-size: var(--font-size-s);
  color: inherit;
 }

 .menu-instagram {
  font-size: var(--font-size-s);
  color: inherit;
  text-decoration: underline;
  text-underline-position: under;
 }
</style>
