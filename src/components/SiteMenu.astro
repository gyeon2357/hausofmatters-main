---
import TextSlider from "../components/TextSlider.astro";
---

<!-- 데스크톱: Menu 버튼 바로 아래 우측에 뜨는 비모달 드롭다운 (show()) — 헤더(로고/검색/Menu)가 항상 위에 보임,
     버튼 라벨이 Menu↔Close로 토글됨.
     모바일: Search 모달과 동일하게 showModal()로 열어 배경을 블러 처리하고, 전용 닫기 버튼으로 닫음 —
     이쪽은 트리거 라벨이 Menu로 고정 -->
<dialog id="site-menu-dialog">
 <button id="site-menu-close" type="button" aria-label="메뉴 닫기" class="site-menu-close">
  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round">
   <path d="M2 2l12 12M14 2 2 14" />
  </svg>
 </button>

 <ul class="site-menu-links">
  <li class="site-menu-item">
   <a href="/magazine/" data-astro-prefetch><TextSlider content="Magazine" /></a>
   <ul class="site-menu-sublinks">
    <li>
     <a href="/magazine/hom" data-astro-prefetch>HOM <span class="site-menu-subtext">국내힙합매거진</span></a>
    </li>
    <li>
     <a href="/magazine/w-hom" data-astro-prefetch>w/HOM <span class="site-menu-subtext">해외힙합매거진</span></a>
    </li>
   </ul>
  </li>
  <li class="site-menu-item">
   <a href="/albums/" data-astro-prefetch><TextSlider content="Album" /></a>
   <ul class="site-menu-sublinks">
    <li>
     <a href="/albums/hom" data-astro-prefetch>국내리뷰</a>
    </li>
    <li>
     <a href="/albums/w-hom" data-astro-prefetch>해외리뷰</a>
    </li>
   </ul>
  </li>
  <li>
   <a href="/interview/" data-astro-prefetch><TextSlider content="Interview" /></a>
  </li>
  <li>
   <a href="/feature/" data-astro-prefetch><TextSlider content="Feature" /></a>
  </li>
  <li>
   <a href="/about/" data-astro-prefetch><TextSlider content="About" /></a>
  </li>
 </ul>

 <div class="site-menu-utility">
  <a href="https://www.instagram.com/hausofmatters/" target="_blank" rel="noopener noreferrer" class="text-btn">Instagram</a>
  <a href="mailto:khlhomofficial@gmail.com" class="text-btn">khlhomofficial@gmail.com</a>
 </div>
</dialog>

<style>
 dialog#site-menu-dialog {
  border: 0;
  margin: 0;
  position: fixed;
  top: calc(var(--menu-anchor-top, 3.5rem) + 0.5rem);
  right: 1rem;
  left: auto;
  width: min(320px, calc(100vw - 2rem));
  max-width: none;
  max-height: calc(100vh - var(--menu-anchor-top, 3.5rem) - var(--bottom-nav-height, 3.5rem) - 1.5rem);

  padding: 1.5rem;
  background: var(--color-bg);
  color: var(--color-text);
  font-family: var(--info-font);
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
  overflow-y: auto;
  z-index: 90;
 }

 /* dialog는 [open]이 아니면 UA 기본값이 display:none — [open]에만 flex를 걸어야
    닫혀 있을 때 항상 보이는 사고를 막을 수 있음 */
 dialog#site-menu-dialog[open] {
  display: flex;
  flex-direction: column;
  gap: 2rem;
 }

 /* 데스크톱 드롭다운에는 필요 없음 — 모바일 모달에서만 노출 */
 .site-menu-close {
  display: none;
  position: absolute;
  top: 0.75rem;
  right: 0.75rem;
  align-items: center;
  background: none;
  border: none;
  color: inherit;
  cursor: pointer;
  opacity: 0.8;
  transition: opacity 0.25s;
  padding: 0.25rem;
 }

 .site-menu-close:hover {
  opacity: 1;
 }

 .site-menu-links {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  list-style: none;
  margin: 0;
  padding: 0;
 }

 .site-menu-links a {
  font-size: var(--font-size-base);
  text-decoration: underline;
  text-underline-position: under;
 }

 /* 현재 페이지는 볼드가 아니라 밑줄을 굵게 해서 구분 */
 .site-menu-links a.current {
  font-weight: 400;
  text-decoration-thickness: 2px;
 }

 .site-menu-sublinks {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  list-style: none;
  margin: 0.5rem 0 0;
  padding: 0 0 0 1rem;
 }

 .site-menu-sublinks a {
  font-size: var(--font-size-s);
  opacity: 0.8;
 }

 .site-menu-subtext {
  opacity: 0.6;
 }

 .site-menu-utility {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.75rem;
  padding-top: 1rem;
  border-top: 1px solid var(--border-color);
 }

 @media screen and (max-width: 768px) {
  dialog#site-menu-dialog {
   left: 0.75rem;
   right: 0.75rem;
   width: auto;
  }

  .site-menu-close {
   display: flex;
  }

  /* Search 모달과 동일한 배경 블러 — showModal()로 열렸을 때만 그려짐 */
  dialog#site-menu-dialog::backdrop {
   background: color-mix(in srgb, var(--color-text) 10%, transparent);
   backdrop-filter: blur(4px);
  }
 }
</style>

<script>
 function initSiteMenu() {
  const btn = document.getElementById("site-menu-open");
  const dialog = document.getElementById("site-menu-dialog") as HTMLDialogElement | null;
  const closeBtn = document.getElementById("site-menu-close");

  if (!btn || !dialog) return;

  // AbortController로 이전 페이지의 리스너를 정리하고 새로 바인딩
  const ac = new AbortController();
  const sig = ac.signal;
  const prev = (btn as any).__siteMenuAC as AbortController | undefined;
  prev?.abort();
  (btn as any).__siteMenuAC = ac;

  const isMobile = () => window.matchMedia("(max-width: 768px)").matches;
  const label = () => btn!.querySelector(".oh__inner");

  function open() {
   if (isMobile()) {
    // 모바일: Search와 동일하게 진짜 모달로 열어 배경을 블러 처리 — 트리거 라벨은 Menu로 고정
    dialog!.showModal();
   } else {
    dialog!.show();
    btn!.classList.add("is-open");
    const inner = label();
    if (inner) inner.textContent = "Close";
   }
  }

  function close() {
   dialog!.close();
   btn!.classList.remove("is-open");
   const inner = label();
   if (inner) inner.textContent = "Menu";
  }

  // showModal()로 열려있는 동안 트리거 버튼 자체가 inert(클릭 불가)라, 토글이 아니라
  // 열기 전용으로만 쓰임 — 닫기는 모바일에서 전용 닫기 버튼이 담당
  btn.addEventListener(
   "click",
   () => {
    if (dialog!.open) close();
    else open();
   },
   { signal: sig }
  );

  closeBtn?.addEventListener("click", close, { signal: sig });

  // 바깥 클릭 시 닫기 — show() 모달(데스크톱)은 네이티브 backdrop이 없어 직접 감지해야 하고,
  // showModal() 모달(모바일)은 클릭 대상이 dialog 자신일 때(= backdrop) 아래 리스너로 처리됨
  document.addEventListener(
   "click",
   e => {
    if (!dialog!.open || isMobile()) return;
    const target = e.target as Node;
    if (dialog!.contains(target) || btn!.contains(target)) return;
    close();
   },
   { signal: sig }
  );

  dialog.addEventListener(
   "click",
   e => {
    if (e.target === dialog) close();
   },
   { signal: sig }
  );

  document.addEventListener(
   "keydown",
   e => {
    if (e.key === "Escape" && dialog!.open) close();
   },
   { signal: sig }
  );

  dialog.querySelectorAll("a[href]").forEach(a => {
   a.addEventListener("click", close, { signal: sig });
  });
 }

 document.addEventListener("astro:page-load", initSiteMenu);
</script>
