---
import TextSlider from "../components/TextSlider.astro";
---

<dialog id="site-menu-dialog" class="anchored-panel" aria-label="전체 메뉴">
 <button id="site-menu-close" type="button" aria-label="메뉴 닫기" class="anchored-panel-close">
  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round">
   <path d="M2 2l12 12M14 2 2 14" />
  </svg>
 </button>

 <ul class="site-menu-links">
  <li class="site-menu-item">
   <a href="/magazine/" data-astro-prefetch><TextSlider content="Magazine" /></a>
   <ul class="site-menu-sublinks">
    <li>
     <a href="/magazine/hom" data-astro-prefetch>HOM <span class="site-menu-subtext">국내힙합매거진</span></a>
    </li>
    <li>
     <a href="/magazine/w-hom" data-astro-prefetch>w/HOM <span class="site-menu-subtext">해외힙합매거진</span></a>
    </li>
   </ul>
  </li>
  <li class="site-menu-item">
   <a href="/albums/" data-astro-prefetch><TextSlider content="Album" /></a>
   <ul class="site-menu-sublinks">
    <li>
     <a href="/albums/hom" data-astro-prefetch>국내리뷰</a>
    </li>
    <li>
     <a href="/albums/w-hom" data-astro-prefetch>해외리뷰</a>
    </li>
   </ul>
  </li>
  <li>
   <a href="/interview/" data-astro-prefetch><TextSlider content="Interview" /></a>
  </li>
  <li>
   <a href="/feature/" data-astro-prefetch><TextSlider content="Feature" /></a>
  </li>
  <li>
   <a href="/about/" data-astro-prefetch><TextSlider content="About" /></a>
  </li>
 </ul>

 <div class="site-menu-utility">
  <a href="https://www.instagram.com/hausofmatters/" target="_blank" rel="noopener noreferrer" class="text-btn">Instagram</a>
  <a href="/about/#contact-intro" data-astro-prefetch class="text-btn">Contact</a>
 </div>
</dialog>

<style>
 dialog#site-menu-dialog[open] {
  gap: 1rem;
 }

 .site-menu-links {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  list-style: none;
  margin: 0;
  padding: 0;
 }

 .site-menu-links a {
  font-size: var(--font-size-base);
  text-decoration: underline;
  text-underline-position: under;
 }

 .site-menu-links a.current {
  font-weight: 400;
  text-decoration-thickness: 2px;
 }

 .site-menu-sublinks {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  list-style: none;
  margin: 0.5rem 0 0;
  padding: 0 0 0 1rem;
 }

 .site-menu-sublinks a {
  font-size: var(--font-size-s);
  text-decoration: none;
  opacity: 0.8;
 }

 .site-menu-sublinks a.current {
  text-decoration: underline;
  text-decoration-thickness: 2px;
  text-underline-position: under;
  opacity: 1;
 }

 .site-menu-subtext {
  opacity: 1;
 }

 .site-menu-utility {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.75rem;
  padding-top: 1rem;
  border-top: 1px solid var(--border-color);
 }

 .site-menu-utility a {
  text-decoration: none;
 }
</style>

<script>
 function initSiteMenu() {
  const btn = document.getElementById("site-menu-open");
  const dialog = document.getElementById("site-menu-dialog") as HTMLDialogElement | null;
  const closeBtn = document.getElementById("site-menu-close");

  if (!btn || !dialog) return;

  const ac = new AbortController();
  const sig = ac.signal;
  const prev = (btn as any).__siteMenuAC as AbortController | undefined;
  prev?.abort();
  (btn as any).__siteMenuAC = ac;

  const isMobile = () => window.matchMedia("(max-width: 768px)").matches;

  function open() {
   if (isMobile()) dialog!.showModal();
   else dialog!.show();
   btn!.setAttribute("aria-expanded", "true");
   closeBtn?.focus();
  }

  function close() {
   dialog!.close();
  }

  dialog.addEventListener(
   "close",
   () => {
    btn!.setAttribute("aria-expanded", "false");
    btn!.focus();
   },
   { signal: sig }
  );

  btn.addEventListener(
   "click",
   () => {
    if (dialog!.open) close();
    else open();
   },
   { signal: sig }
  );

  closeBtn?.addEventListener("click", close, { signal: sig });

  document.addEventListener(
   "click",
   e => {
    if (!dialog!.open || isMobile()) return;
    const target = e.target as Node;
    if (dialog!.contains(target) || btn!.contains(target)) return;
    close();
   },
   { signal: sig }
  );

  dialog.addEventListener(
   "click",
   e => {
    if (e.target === dialog) close();
   },
   { signal: sig }
  );

  document.addEventListener(
   "keydown",
   e => {
    if (e.key === "Escape" && dialog!.open) close();
   },
   { signal: sig }
  );

  dialog.querySelectorAll("a[href]").forEach(a => {
   a.addEventListener("click", close, { signal: sig });
  });
 }

 document.addEventListener("astro:page-load", initSiteMenu);
</script>
