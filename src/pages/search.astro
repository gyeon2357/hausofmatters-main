---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Hausofmatters — Search" description="Search albums, magazine, interviews and features">
  <div class="search-page">
    <header class="search-header">
      <div class="search-box">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8" />
          <path d="M21 21l-4.35-4.35" />
        </svg>
        <input
          id="search-input"
          type="search"
          placeholder="검색어를 입력하세요"
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"
          autofocus
        />
        <kbd id="clear-btn" aria-label="지우기">ESC</kbd>
      </div>
      <p id="search-status" class="search-status" aria-live="polite"></p>
    </header>

    <div id="results" class="results" role="list"></div>

    <div id="empty-state" class="empty-state" hidden>
      <p>검색 결과가 없습니다.</p>
    </div>

    <div id="initial-state" class="initial-state">
      <p>Album · Magazine · Interview · Feature</p>
    </div>
  </div>
</BaseLayout>

<script>
  type SearchItem = {
    type: string;
    url: string;
    displayTitle: string;
    fields: Record<string, string>;
  };

  type MatchedField = { label: string; value: string; highlight: string };

  type Result = SearchItem & { matches: MatchedField[] };

  const TYPE_LABELS: Record<string, string> = {
    album: "Album",
    magazine: "Magazine",
    interview: "Interview",
    feature: "Feature",
  };

  let index: SearchItem[] = [];

  async function loadIndex() {
    const res = await fetch("/search-index.json");
    index = await res.json();
  }

  function escapeRegex(str: string) {
    return str.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  }

  function highlight(text: string, query: string): string {
    if (!query) return text;
    const re = new RegExp(`(${escapeRegex(query)})`, "gi");
    return text.replace(re, '<mark>$1</mark>');
  }

  function search(query: string): Result[] {
    if (!query.trim()) return [];
    const q = query.trim().toLowerCase();
    const results: Result[] = [];

    for (const item of index) {
      const matches: MatchedField[] = [];

      // 제목 매칭
      if (item.displayTitle.toLowerCase().includes(q)) {
        matches.push({
          label: "제목",
          value: item.displayTitle,
          highlight: highlight(item.displayTitle, query.trim()),
        });
      }

      // 각 필드 매칭
      for (const [label, value] of Object.entries(item.fields)) {
        if (value.toLowerCase().includes(q)) {
          matches.push({
            label,
            value,
            highlight: highlight(value, query.trim()),
          });
        }
      }

      if (matches.length > 0) {
        results.push({ ...item, matches });
      }
    }

    return results;
  }

  function renderResults(results: Result[], query: string) {
    const container = document.getElementById("results")!;
    const emptyState = document.getElementById("empty-state")!;
    const initialState = document.getElementById("initial-state")!;
    const status = document.getElementById("search-status")!;

    initialState.hidden = true;

    if (results.length === 0) {
      container.innerHTML = "";
      emptyState.hidden = false;
      status.textContent = "";
      return;
    }

    emptyState.hidden = true;
    status.textContent = `${results.length}개의 결과`;

    container.innerHTML = results
      .map(item => {
        const typeLabel = TYPE_LABELS[item.type] ?? item.type;

        // 매칭 필드 — 제목 제외한 것만 배지로 표시 (최대 3개)
        const fieldMatches = item.matches
          .filter(m => m.label !== "제목")
          .slice(0, 3);

        const badges = fieldMatches
          .map(
            m => `<span class="match-badge">
              <span class="match-label">${m.label}</span>
              <span class="match-value">${m.highlight}</span>
            </span>`,
          )
          .join("");

        // 제목 하이라이트
        const titleDisplay = item.matches.find(m => m.label === "제목")
          ? highlight(item.displayTitle, query)
          : item.displayTitle;

        return `<a class="result-item" href="${item.url}" role="listitem" data-astro-prefetch>
          <div class="result-type">${typeLabel}</div>
          <div class="result-main">
            <span class="result-title">${titleDisplay}</span>
            ${badges ? `<div class="result-fields">${badges}</div>` : ""}
          </div>
          <svg class="result-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>`;
      })
      .join("");
  }

  function init() {
    const input = document.getElementById("search-input") as HTMLInputElement | null;
    const clearBtn = document.getElementById("clear-btn");
    const container = document.getElementById("results")!;
    const emptyState = document.getElementById("empty-state")!;
    const initialState = document.getElementById("initial-state")!;
    const status = document.getElementById("search-status")!;

    if (!input) return;

    // URL 파라미터에서 초기 쿼리 복원
    const urlQuery = new URLSearchParams(window.location.search).get("q") ?? "";
    if (urlQuery) {
      input.value = urlQuery;
    }

    let debounceTimer: ReturnType<typeof setTimeout>;

    function handleInput() {
      const q = input!.value;

      // URL 업데이트
      const url = new URL(window.location.href);
      if (q) url.searchParams.set("q", q);
      else url.searchParams.delete("q");
      history.replaceState(null, "", url.toString());

      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        if (!q.trim()) {
          container.innerHTML = "";
          emptyState.hidden = true;
          initialState.hidden = false;
          status.textContent = "";
          return;
        }
        const results = search(q);
        renderResults(results, q);
      }, 120);
    }

    input.addEventListener("input", handleInput);

    // ESC로 지우기
    clearBtn?.addEventListener("click", () => {
      input.value = "";
      input.focus();
      handleInput();
    });

    input.addEventListener("keydown", e => {
      if (e.key === "Escape") {
        input.value = "";
        handleInput();
      }
    });

    // 인덱스 로드 후 초기 쿼리가 있으면 바로 검색
    loadIndex().then(() => {
      if (urlQuery) handleInput();
    });
  }

  document.addEventListener("astro:page-load", init);
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>

<style>
  .search-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 0 8rem;
  }

  /* ── Search box ── */
  .search-header {
    margin-bottom: 2rem;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1.5px solid currentColor;
    padding-bottom: 0.5rem;
  }

  .search-icon {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
    opacity: 0.5;
  }

  #search-input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    font: inherit;
    font-size: 1.25rem;
    color: inherit;
    padding: 0;
  }

  #search-input::placeholder {
    opacity: 0.35;
  }

  /* hide browser clear button */
  #search-input::-webkit-search-cancel-button { display: none; }

  kbd {
    font-family: inherit;
    font-size: 0.7rem;
    opacity: 0.4;
    border: 1px solid currentColor;
    border-radius: 3px;
    padding: 0.1em 0.4em;
    cursor: pointer;
    user-select: none;
    transition: opacity 0.15s;
  }

  kbd:hover { opacity: 0.7; }

  .search-status {
    font-size: 0.8rem;
    opacity: 0.5;
    margin: 0.75rem 0 0;
    min-height: 1.2em;
  }

  /* ── States ── */
  .initial-state,
  .empty-state {
    text-align: center;
    opacity: 0.4;
    font-size: 0.9rem;
    margin-top: 4rem;
  }

  /* ── Results ── */
  .results {
    display: flex;
    flex-direction: column;
  }

  .result-item {
    display: grid;
    grid-template-columns: 5.5rem 1fr auto;
    align-items: start;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid color-mix(in srgb, currentColor 15%, transparent);
    text-decoration: none;
    color: inherit;
    transition: opacity 0.15s;
  }

  .result-item:hover { opacity: 0.6; }
  .result-item:first-child { border-top: 1px solid color-mix(in srgb, currentColor 15%, transparent); }

  .result-type {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.45;
    padding-top: 0.15rem;
    white-space: nowrap;
  }

  .result-main {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .result-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    word-break: keep-all;
  }

  /* ── Match badges ── */
  .result-fields {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .match-badge {
    display: inline-flex;
    gap: 0.3rem;
    font-size: 0.75rem;
    background: color-mix(in srgb, currentColor 8%, transparent);
    border-radius: 3px;
    padding: 0.2em 0.5em;
    max-width: 100%;
    overflow: hidden;
  }

  .match-label {
    opacity: 0.5;
    flex-shrink: 0;
  }

  .match-value {
    opacity: 0.8;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 18ch;
  }

  /* 트랙 필드처럼 긴 텍스트는 더 넓게 */
  .match-badge:has(.match-label:first-child) .match-value {
    max-width: 24ch;
  }

  .result-arrow {
    width: 1rem;
    height: 1rem;
    opacity: 0.25;
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  /* ── Highlight mark ── */
  :global(mark) {
    background: none;
    color: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 2px;
  }

  @media (max-width: 480px) {
    .result-item {
      grid-template-columns: 4.5rem 1fr auto;
      gap: 0.6rem;
    }

    .result-type {
      font-size: 0.65rem;
    }

    .result-title {
      font-size: 0.9rem;
    }
  }
</style>
