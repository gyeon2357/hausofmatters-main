---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Separator from "../../components/Separator.astro";
import Share from "../../components/Share.astro";

export async function getStaticPaths() {
  const allFeature = await getCollection("feature");
  return allFeature
    .filter(f => f.data.published)
    .map(feature => ({
      params: { slug: feature.id },
      props: { feature },
    }));
}

const { feature } = Astro.props;
const { Content } = await render(feature);

const dateStr = new Date(feature.data.date).toLocaleDateString("ko-KR", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const coverSrc = feature.data.coverImage?.src ?? "";
const coverAlt = feature.data.coverImage?.alt ?? feature.id;

const displayTitle = feature.id
  .replace(/-/g, " ")
  .replace(/\b\w/g, c => c.toUpperCase());
const pageTitle = `Hausofmatters - Feature: ${displayTitle}`;


let linkHref: string | undefined;
let linkLabel: string | undefined;
if (feature.data.link) {
  const raw = feature.data.link.trim();
  // hom- 또는 w-hom- 으로 시작하면 magazine, 아니면 album
  if (/^(w-)?hom-/i.test(raw)) {
    linkHref = `/magazine/${raw.toLowerCase()}`;
    linkLabel = raw.toUpperCase();
  } else {
    linkHref = `/albums/${raw.toLowerCase()}`;
    linkLabel = raw.toUpperCase();
  }
}
const seoDescription = feature.data.artist
  ? `${feature.data.artist} | ${dateStr}`
  : `${feature.data.category} | ${dateStr}`;
---

<BaseLayout title={pageTitle} description={seoDescription} ogImage={coverSrc || undefined}>
  {
    coverSrc && (
      <div class="feature-cover">
        <img src={coverSrc} alt={coverAlt} />
      </div>
    )
  }

  <header class="feature-header">
    <p class="feature-label">HAUS OF Feature</p>
    <h1>{displayTitle}</h1>
    <p class="feature-meta">
      {feature.data.artist && <span>{feature.data.artist}</span>}
      {feature.data.artist && <span class="sep">·</span>}
      <span>{feature.data.category}</span>
      <span class="sep">·</span>
      <span>{dateStr}</span>
    </p>
    <a class="nav-link" href="/feature">Back to Feature</a>
  </header>

  <Separator />

  <div class="feature-body">
    <Content />

    <div class="feature-footer">
      {
        linkHref && (
          <a class="related-link" href={linkHref}>
            {linkLabel}
          </a>
        )
      }
      <Share title={displayTitle} />
    </div>
  </div>
</BaseLayout>

<style>
  .feature-cover {
    width: 100%;
    max-height: 70vh;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .feature-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .feature-header {
    margin-bottom: 1rem;
    text-align: center;
  }

  .feature-label {
    margin: 0 0 0.5rem;
    text-transform: uppercase;
    font-size: var(--font-size-xs);
    opacity: 0.6;
  }

  .feature-header h1 {
    margin: 0 0 0.5rem;
    font-size: var(--font-size-2xl);
  }

  .feature-meta {
    margin: 0 0 0.75rem;
    font-size: var(--font-size-s);
    opacity: 0.7;
  }

  .feature-header .nav-link {
    display: inline-block;
  }

  .sep {
    opacity: 0.5;
  }

  .feature-body {
    margin: 1rem auto 6rem;
    max-width: 720px;
    line-height: 1.8;
    word-break: keep-all;
    text-wrap: pretty;
  }

  .feature-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
  }

</style>
