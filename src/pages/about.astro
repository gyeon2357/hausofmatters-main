---

<BaseLayout title={title}>
 <div class="info-page">
  <header class="title-header title-header--initial">
   <h1>About</h1>
  </header>
  <Separator />

  <h4>
   팀 KHL은 블랙뮤직을 사랑하는 장르팬들이 모여 결성한 매거진 팀입니다. 음악에 대한 애정을 바탕으로 앨범 소개, 리뷰, 인터뷰, 칼럼 등 다양한 형식의 글을 통해
   아티스트와 앨범, 그리고 그 음악이 담고 있는 의미를 기록해나가고 있습니다. 단순한 정보 전달을 넘어, 팀원 각자의 개성을 담아 블랙뮤직을 둘러싼 다채로운 풍경을
   함께 담아내보려 합니다.
  </h4>

  <section class="members-container" id="members-container">
   <div class="contact-intro" id="contact-intro">
    <p class="contact-intro-text">다양한 프로젝트와 협업에 대해 편하게 연락 바랍니다.</p>
    <div class="contact-intro-mail">
     <a href="mailto:khlhomofficial@gmail.com">khlhomofficial@gmail.com</a>
     <button id="mail-copy-btn" type="button" class="text-btn">Copy</button>
     <button id="mail-share-btn" type="button" class="text-btn">Share</button>
    </div>
   </div>
   {
    [
     { label: "Directors", members: directors },
     { label: "Designers", members: designers },
     { label: "HOM Editors", members: homEditors },
     { label: "w/HOM Editors", members: whomEditors },
    ].map(({ label, members }) => (
     <div class="members-wrapper">
      <h2>{label}</h2>
      <ol>
       {members.map(m => (
        <li>
         <div class="member-info">
          <h3>{m.name}</h3>
          <p>{m.bio}</p>
         </div>
         <figure>
          {m.image && <img src={m.image} alt={m.name} class="fade-in" />}
          <figcaption>
           {m.links?.map(l => (
            <a href={l.href} target="_blank" rel="noopener noreferrer">
             ‣ {l.label}
            </a>
           ))}
           {m.note && <small>{m.note}</small>}
          </figcaption>
         </figure>
        </li>
       ))}
      </ol>
     </div>
    ))
   }
  </section>

  <Separator />

  <section class="contact-section">
   <h2 class="group-title">Contact</h2>
   <div class="contact-grid">
    <div>
     <span class="contact-label">Mail</span>
     <a href="mailto:khlhomofficial@gmail.com">khlhomofficial@gmail.com</a>
    </div>
    <div>
     <span class="contact-label">Instagram</span>
     <a href="https://www.instagram.com/hausofmatters/" target="_blank" rel="noopener noreferrer"> @hausofmatters </a>
    </div>
   </div>
  </section>
 </div>
 <div id="copy-toast" aria-live="polite">이메일이 복사되었습니다</div>
</BaseLayout>

<script>
 const CONTACT_EMAIL = "khlhomofficial@gmail.com";

 function showToast(message: string) {
  const toast = document.getElementById("copy-toast");
  if (!toast) return;

  toast.textContent = message;
  toast.classList.add("visible");
  setTimeout(() => toast.classList.remove("visible"), 2000);
 }

 // Menu의 Contact 링크(#contact-intro)로 들어왔을 때, 네이티브 해시 점프는 타깃을
 // 화면 맨 위에 딱 붙여버려 어색함 — 화면 상단에서 30% 지점(중앙보다 살짝 위)에 오도록 보정
 function scrollToContactIntro() {
  if (window.location.hash !== "#contact-intro") return;
  const target = document.getElementById("contact-intro");
  if (!target) return;

  const targetY = target.getBoundingClientRect().top + window.scrollY - window.innerHeight * 0.3;
  window.scrollTo({ top: Math.max(targetY, 0), behavior: "auto" });
 }

 let popstateBound = false;

 function initContactIntro() {
  // 다른 페이지에서 들어올 때는 astro:page-load 시점에 보정하면 되지만, About 페이지에
  // 이미 있는 상태에서 Menu의 Contact를 클릭하는 경우는 astro:page-load가 다시 발화하지
  // 않고 popstate만 발생한 뒤 브라우저가 자체적으로 해시 위치로 스크롤함 — 그 네이티브
  // 스크롤이 끝난 뒤에 보정해야 해서 popstate에도 별도로 걸어둠
  scrollToContactIntro();
  if (!popstateBound) {
   popstateBound = true;
   window.addEventListener("popstate", () => setTimeout(scrollToContactIntro, 50));
  }

  const copyBtn = document.getElementById("mail-copy-btn");
  const shareBtn = document.getElementById("mail-share-btn");

  if (!copyBtn || !shareBtn || copyBtn.dataset.initialized) return;
  copyBtn.dataset.initialized = "true";
  shareBtn.dataset.initialized = "true";

  copyBtn.addEventListener("click", async () => {
   try {
    await navigator.clipboard.writeText(CONTACT_EMAIL);
    showToast("이메일이 복사되었습니다.");
   } catch {
    // clipboard API 미지원 환경 fallback (일부 모바일 브라우저)
    try {
     const el = document.createElement("textarea");
     el.value = CONTACT_EMAIL;
     el.style.position = "fixed";
     el.style.opacity = "0";
     document.body.appendChild(el);
     el.focus();
     el.select();
     document.execCommand("copy");
     document.body.removeChild(el);
     showToast("이메일이 복사되었습니다.");
    } catch {
     showToast("복사에 실패했습니다.");
    }
   }
  });

  shareBtn.addEventListener("click", async () => {
   if (navigator.share) {
    try {
     await navigator.share({ title: "Hausofmatters Contact", text: CONTACT_EMAIL });
    } catch (e: any) {
     if (e?.name !== "AbortError") showToast("공유에 실패했습니다.");
    }
   } else {
    showToast("공유 기능이 지원되지 않는 브라우저입니다.");
   }
  });
 }

 document.addEventListener("astro:page-load", initContactIntro);
</script>

<style>
 .info-page {
  display: flex;
  flex-direction: column;
 }

 .info-page h4 {
  max-width: 48ch;

  font-size: var(--font-size-base);
  font-weight: 400;
  line-height: 1.55;
  word-break: keep-all;
  text-wrap: pretty;
 }

 /* 멤버 컨테이너 */
 .members-container {
  display: flex;
  flex-direction: column;
  gap: 4rem;

  margin: 0.5rem 0 8rem;
 }

 .members-wrapper {
  display: flex;
  flex-direction: column;
  gap: 1rem;
 }

 /* members-container 맨 위에 두는 연락처 안내 — 아래 contact-section(Mail/Instagram)과는
    별개로, 협업 제안을 바로 복사/공유할 수 있게 하는 용도 */
 .contact-intro {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
 }

 .contact-intro-text {
  font-size: var(--font-size-s);
  color: var(--color-text-alt);
  margin: 0;
 }

 .contact-intro-mail {
  display: flex;
  align-items: center;
  gap: 1rem;
 }

 .contact-intro-mail a {
  font-size: var(--font-size-base);
  text-decoration: underline;
  text-underline-position: under;
  color: var(--color-text);
 }

 .group-title {
  font-size: var(--font-size-base);
  font-weight: 700;

  margin: 0;
 }

 .members-wrapper ol {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  row-gap: 3rem;
  column-gap: 1.5rem;
  width: 100%;
  max-width: 1080px;
  list-style: none;
  margin: 0;
  padding: 0;
 }

 .members-wrapper li {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 0.75rem 0.75rem 0.5rem;
  gap: 1rem;
  border-top: 1px solid var(--border-color);
 }

 /* 텍스트 영역 */
 .member-info {
  display: flex;
  flex-direction: column;
  justify-content: start;
  gap: 0.4rem;
 }

 .member-info h3 {
  font-size: var(--font-size-base);

  margin: 0;
 }

 .member-info p {
  font-size: var(--font-size-s);
  line-height: 1.5;
  margin: 0;

  word-break: keep-all;
  color: var(--color-text-alt);
 }

 /* 이미지 + 링크 */
 .members-wrapper figure {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  gap: 1rem;
  margin: 0;
  flex-shrink: 0;
 }

 .members-wrapper img {
  width: 5rem;
  height: 5rem;
  object-fit: cover;
 }

 .members-wrapper figcaption {
  display: inline-flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.35rem;
 }

 .members-wrapper figcaption a {
  font-size: var(--font-size-xs);
  text-decoration: none;
  color: var(--color-text-alt);
 }

 .members-wrapper figcaption a:hover {
  color: var(--color-text);
 }

 .members-wrapper figcaption small {
  font-size: var(--font-size-xs);
  opacity: 0.6;
  text-align: right;
  line-height: 1.3;
 }

 /* 연락처 */
 .contact-section {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
 }

 .contact-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
 }

 .contact-grid > div {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
 }

 .contact-label {
  font-size: var(--font-size-xs);
  font-weight: 700;

  color: var(--color-text-alt);
  text-transform: uppercase;
 }

 .contact-grid a {
  font-size: var(--font-size-s);
  text-decoration: none;
  color: var(--color-text);
 }

 .contact-grid a:hover {
  opacity: 0.6;
 }

 /* 반응형 */
 @media (max-width: 44em) {
  .contact-intro-mail {
   flex-wrap: wrap;
   gap: 0.5rem 1rem;
  }

  .members-wrapper ol {
   grid-template-columns: 1fr;
  }

  .member-info p {
   width: auto;
  }

  .contact-grid {
   grid-template-columns: 1fr;
  }
 }
</style>
