---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Separator from "../components/Separator.astro";

const title = "Hausofmatters - Albums";

const allAlbums = await getCollection("albums");

// category 필드 기준으로 분리, 날짜 내림차순
const sorted = allAlbums.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());

const domesticAlbums = sorted.filter(a => a.data.category === "hom").slice(0, 6);
const intlAlbums = sorted.filter(a => a.data.category === "w-hom").slice(0, 6);

const makeCard = (album: (typeof allAlbums)[number]) => {
 return {
  href: `/albums/${album.id}`,
  name: album.data.name,
  imageSrc: (album.data.image?.src ?? `/images/albums/${album.id}.jpg`),
  imageAlt: (album.data.image?.alt ?? album.id.replace(/-/g, " ")),
  year: (() => {
  const d = new Date(album.data.publishDate);
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  return `${y}. ${m}.`;
})(),
 };
};

const domesticCards = domesticAlbums.map(makeCard);
const intlCards = intlAlbums.map(makeCard);
---

<BaseLayout title={title}>
 <header class="title-header title-header--initial">
  <h2>Review</h2>
 </header>
 <Separator />

 <div class="albums-page">
  <!-- 국내 섹션 -->
  <section>
   <div class="section-header">
    <h3 class="section-title">국내 리뷰</h3>
    <a class="more-link" href="/albums/hom"> / View All </a>
   </div>
   <div class="album-grid">
    {
     domesticCards.map(card => (
      <a class="album-card" href={card.href} data-name={card.name} data-astro-prefetch>
       <div class="album-img">
        <img class="fade-in" loading="lazy" src={card.imageSrc} alt={card.imageAlt} />
       </div>
       <h3 class="album-name">{card.name}</h3>
       <p class="album-year">{card.year}</p>
      </a>
     ))
    }
   </div>
  </section>

  <!-- 해외 섹션 -->
  {
   intlCards.length > 0 && (
    <section>
     <div class="section-header">
      <h3 class="section-title">해외 리뷰</h3>
      <a class="more-link" href="/albums/w-hom">
       / View All
      </a>
     </div>
     <div class="album-grid">
      {intlCards.map(card => (
       <a class="album-card" href={card.href} data-name={card.name} data-astro-prefetch>
        <div class="album-img">
         <img class="fade-in" loading="lazy" src={card.imageSrc} alt={card.imageAlt} />
        </div>
        <h3 class="album-name">{card.name}</h3>
        <p class="album-year">{card.year}</p>
       </a>
      ))}
     </div>
    </section>
   )
  }
 </div>
</BaseLayout>

<style>
 .albums-page {
  display: flex;
  flex-direction: column;
  gap: 4rem;
  margin: 2rem 0 10rem;
 }

 .section-title {
  margin: 0;
 }

 .album-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.5rem;
 }

 @media (min-width: 30em) {
  .album-grid {
   grid-template-columns: repeat(3, 1fr);
  }
 }
 @media (min-width: 50em) {
  .album-grid {
   grid-template-columns: repeat(6, 1fr);
  }
 }


 .album-name {
  margin: 0;
  font-size: 0.875rem;
  font-weight: 600;
  line-height: 1.3;
 }

 .album-year {
  margin: 0;
  font-size: 0.8rem;
 }


</style>

<script src="../scripts/index.js"></script>