---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Separator from "../components/Separator.astro";

const title = "Hausofmatters - Albums";

const allAlbums = await getCollection("albums");

const sorted = allAlbums.sort((a, b) => new Date(b.data.release).getTime() - new Date(a.data.release).getTime());

const domesticAlbums = sorted.filter(a => a.data.category === "hom").slice(0, 6);
const intlAlbums = sorted.filter(a => a.data.category === "w-hom").slice(0, 6);

function excerpt(markdown: string, maxLength = 140): string {
 const plain = markdown
  .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
  .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
  .replace(/[*_`#>]/g, "")
  .replace(/\s+/g, " ")
  .trim();
 return plain.length > maxLength ? plain.slice(0, maxLength).trim() + "…" : plain;
}

const makeCard = (album: (typeof allAlbums)[number], index: number) => {
 return {
  href: `/albums/${album.id}`,
  name: album.data.name,
  imageSrc: album.data.image?.src ?? `/images/albums/${album.id}.jpg`,
  imageAlt: album.data.image?.alt ?? album.id.replace(/-/g, " "),
  year: (() => {
   const d = new Date(album.data.release);
   const y = d.getFullYear();
   const m = String(d.getMonth() + 1).padStart(2, "0");
   return `${y}. ${m}.`;
  })(),
  featured: index === 0,
  review: index === 0 ? excerpt(album.body ?? "") : "",
 };
};

const domesticCards = domesticAlbums.map(makeCard);
const intlCards = intlAlbums.map(makeCard);
---

<BaseLayout title={title}>
 <header class="title-header title-header--initial">
  <h1>Album</h1>
 </header>
 <Separator />

 <div class="albums-page">
  <section>
   <div class="section-header">
    <h3 class="section-title">국내리뷰</h3>
    <a class="nav-link" href="/albums/hom">View All</a>
   </div>
   <div class="album-grid">
    {
     domesticCards.map(card => (
      <a class:list={["album-card", { "album-card--featured": card.featured }]} href={card.href} data-name={card.name} data-astro-prefetch>
       <div class="album-img">
        <img class="fade-in" loading="lazy" src={card.imageSrc} alt={card.imageAlt} />
       </div>
       <p class="album-name">{card.name}</p>
       <p class="meta-date">{card.year}</p>
       {card.featured && card.review && <p class="album-review">{card.review}</p>}
      </a>
     ))
    }
   </div>
   <a href="/albums/hom" class="load-more-btn" data-astro-prefetch>더보기</a>
  </section>

  {
   intlCards.length > 0 && (
    <section>
     <div class="section-header">
      <h3 class="section-title">해외리뷰</h3>
      <a class="nav-link" href="/albums/w-hom">
       View All
      </a>
     </div>
     <div class="album-grid">
      {intlCards.map(card => (
       <a class:list={["album-card", { "album-card--featured": card.featured }]} href={card.href} data-name={card.name} data-astro-prefetch>
        <div class="album-img">
         <img class="fade-in" loading="lazy" src={card.imageSrc} alt={card.imageAlt} />
        </div>
        <p class="album-name">{card.name}</p>
        <p class="meta-date">{card.year}</p>
        {card.featured && card.review && <p class="album-review">{card.review}</p>}
       </a>
      ))}
     </div>
     <a href="/albums/w-hom" class="load-more-btn" data-astro-prefetch>더보기</a>
    </section>
   )
  }
 </div>
</BaseLayout>

<style>
 .albums-page {
  display: flex;
  flex-direction: column;
  margin: 2rem 0 8rem;
  gap: 2rem;
 }

 .album-grid {
  margin: 0rem 0;
 }

 .load-more-btn {
  margin-top: 0.75rem;
  margin-bottom: 3rem;
 }

 .section-title {
  margin: 0;
 }

 .album-card--featured {
  grid-column: span 2;
 }

 .album-review {
  margin: 0.5rem 0 0.5rem;
  font-size: var(--font-size-s);
  line-height: 1.5;
  color: var(--color-text-alt);

  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
 }
</style>

<script src="../scripts/index.js"></script>
