<BaseLayout title={title}>
 <div class="info-page">
  <header class="title-header title-header--initial">
   <h2>Info</h2>
  </header>
  <Separator />

  <h3 style="line-height: 1.55; font-size: 1.25rem; max-width: 48ch; word-break: keep-all;">
   팀 KHL은 블랙뮤직을 사랑하는 장르팬들이 모여 결성한 매거진 팀입니다. 음악에 대한 애정을 바탕으로 앨범 소개, 리뷰, 인터뷰, 칼럼 등 다양한 형식의 글을 통해
   아티스트와 앨범, 그리고 그 음악이 담고 있는 의미를 기록해나가고 있습니다. 단순한 정보 전달을 넘어, 팀원 각자의 개성을 담아 블랙뮤직을 둘러싼 다채로운 풍경을
   함께 담아내보려 합니다.
  </h3>

  <section class="members-container">
   {
    [
     { label: "Directors", members: directors },
     { label: "Designers", members: designers },
     { label: "HOM Editors", members: homEditors },
     { label: "w/HOM Editors", members: whomEditors },
    ].map(({ label, members }) => (
     <div class="members-wrapper">
      <h2>{label}</h2>
      <ol>
       {members.map(m => (
        <li>
         <div class="member-info">
          <h3>{m.name}</h3>
          <p>{m.bio}</p>
         </div>
         <figure>
          {m.image && <img src={m.image} alt={m.name} class="fade-in" />}
          <figcaption>
           {m.links?.map(l => (
            <a href={l.href} target="_blank" rel="noopener noreferrer">
             ‣ {l.label}
            </a>
           ))}
           {m.note && <small>{m.note}</small>}
          </figcaption>
         </figure>
        </li>
       ))}
      </ol>
     </div>
    ))
   }
  </section>

  <Separator />

  <section class="contact-section">
   <h2 class="group-title">Contact</h2>
   <div class="contact-grid">
    <div>
     <span class="contact-label">Mail</span>
     <a href="mailto:khlhomofficial@gmail.com">khlhomofficial@gmail.com</a>
    </div>
    <div>
     <span class="contact-label">Instagram</span>
     <a href="https://www.instagram.com/hausofmatters/" target="_blank" rel="noopener noreferrer"> @hausofmatters </a>
    </div>
   </div>
  </section>
 </div>
</BaseLayout>

<style>
 .info-page {
  display: flex;
  flex-direction: column;
 }

 /* 페이지 타이틀 */
 .page-title {
  text-align: center;
  margin: 4rem auto 0;
 }

 .page-title img {
  max-height: 4.5rem;
 }

 /* 멤버 컨테이너 */
 .members-container {
  display: flex;
  flex-direction: column;
  gap: 4rem;

  margin: 2rem 0 8rem;
 }

 .members-wrapper {
  display: flex;
  flex-direction: column;
  gap: 2rem;
 }

 .group-title {
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  margin: 0;
 }

 .members-wrapper ol {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
  width: 100%;
  max-width: 1080px;
  list-style: none;
  margin: 0;
  padding: 0;
 }

 .members-wrapper li {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 0.75rem 0.75rem 0.5rem;
  gap: 1rem;
  border-top: 1px solid var(--border-color);
 }

 /* 텍스트 영역 */
 .member-info {
  display: flex;
  flex-direction: column;
  justify-content: start;
  gap: 0.4rem;
 }

 .member-info h3 {
  font-size: 1rem;
  font-weight: 600;
  margin: 0;
 }

 .member-info p {
  font-size: 0.875rem;
  line-height: 1.5;
  margin: 0;

  word-break: keep-all;
  color: var(--color-text-secondary);
 }

 /* 이미지 + 링크 */
 .members-wrapper figure {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  gap: 1rem;
  margin: 0;
  flex-shrink: 0;
 }

 .members-wrapper img {
  width: 5rem;
  height: 5rem;
  object-fit: cover;
 }

 .members-wrapper figcaption {
  display: inline-flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.35rem;
 }

 .members-wrapper figcaption a {
  font-size: 0.8rem;
  text-decoration: none;
  color: var(--color-text-secondary);
 }

 .members-wrapper figcaption a:hover {
  color: var(--color-text-primary);
 }

 .members-wrapper figcaption small {
  font-size: 0.75rem;
  opacity: 0.6;
  text-align: right;
  line-height: 1.3;
 }

 /* 연락처 */
 .contact-section {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
 }

 .contact-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
 }

 .contact-grid > div {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  border-left: 1px solid var(--color-border-tertiary);
  padding-left: 0.75rem;
 }

 .contact-label {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: var(--color-text-secondary);
  text-transform: uppercase;
 }

 .contact-grid a {
  font-size: 0.9rem;
  text-decoration: none;
  color: var(--color-text-primary);
 }

 .contact-grid a:hover {
  opacity: 0.6;
 }

 /* 반응형 */
 @media (max-width: 44em) {
  .members-wrapper ol {
   grid-template-columns: 1fr;
  }

  .member-info p {
   width: auto;
  }

  .contact-grid {
   grid-template-columns: 1fr;
  }
 }
</style>
