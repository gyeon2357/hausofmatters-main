---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Separator from "../../components/Separator.astro";

export async function getStaticPaths() {
 const allinterview = await getCollection("interview");
 return allinterview
  .filter(i => i.data.published)
  .map(interview => ({
   params: { slug: interview.id },
   props: { interview },
  }));
}

const { interview } = Astro.props;
const allArtists = await getCollection("artists");

// ✅ reference("artists")를 사용하므로 interview.data.artist는 artist ID
const artistId = String(interview.data.artist);
const artist = allArtists.find(a => a.id === artistId);

const stageName = artist?.data.stage_name ?? interview.id;
const genre = artist?.data.genre ?? "";
const dateStr = new Date(interview.data.date).toLocaleDateString("ko-KR", {
 year: "numeric",
 month: "long",
 day: "numeric",
});
const coverSrc = interview.data.coverImage?.src ?? artist?.data.image.src ?? "";
const coverAlt = interview.data.coverImage?.alt ?? stageName;

const title = `Hausofmatters - Interview: ${stageName}`;
---

<BaseLayout title={title}>
 <!-- 커버 이미지 -->
 {
  coverSrc && (
   <div class="interview-cover">
    <img src={coverSrc} alt={coverAlt} />
   </div>
  )
 }

 <!-- 헤더 -->
 <header class="interview-header">
  <p class="interview-label">HAUS OF interview</p>
  <h1>{stageName}</h1>

  <p class="interview-meta">
   <span>{genre}</span>
   <span class="sep">·</span>
   <span>{dateStr}</span>
  </p>
 </header>

 <Separator />

 <!-- Q&A 본문 -->
 <div class="interview-body">
  {
   interview.data.text.map(item => (
    <div class="qna-block">
     <p class="question">{item.q}</p>

     {item.a.map(answer => (
      <div class="answer-block">
       <p class="answer">{answer.text}</p>

       {answer.images && answer.images.length > 0 && (
        <div class={`image-group image-group--${answer.images.length}`}>
         {answer.images.map(img => (
          <div class="image-wrap">
           <img class="fade-in" src={img.src} alt={img.alt} loading="lazy" />
          </div>
         ))}
        </div>
       )}
      </div>
     ))}
    </div>
   ))
  }
 </div>
</BaseLayout>

<style>
 .interview-cover {
  width: 100%;
  max-height: 70vh;
  overflow: hidden;
  margin-bottom: 1rem;
 }

 .interview-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
 }

 .interview-header {
  margin-bottom: 1rem;
  text-align: center;
 }

 .interview-label {
  margin: 0 0 0.5rem;
  text-transform: uppercase;
 }

 .interview-header h1 {
  margin: 0 0 0.5rem;
  font-size: 2rem;
 }

 .interview-meta {
  margin: 0;
  font-size: 0.85rem;
  opacity: 0.7;
 }

 .sep {
  opacity: 0.5;
 }

 /* Q&A */
 .interview-body {
  margin: 1rem auto 6rem;
  display: flex;
  flex-direction: column;
  gap: 3rem;
  max-width: 720px;
 }

 .qna-block {
  display: flex;
  flex-direction: column;
  gap: 1rem;
 }

 .question {
  font-size: 1rem;
  font-weight: 700;
  word-break: keep-all;

  margin: 0;
 }

 .question::before {
  content: "";
 }

 .answer {
  margin: 0;
  font-size: 1rem;
  letter-spacing: -0.25px;

  white-space: pre-line;
  word-break: keep-all;
 }

 /* 이미지 그룹 */
 .image-group {
  display: grid;
  gap: 0.75rem;
  margin-top: 0.5rem;
 }

 .image-group--1 {
  grid-template-columns: 1fr;
 }

 .image-group--2 {
  grid-template-columns: 1fr 1fr;
 }

 .image-group--3 {
  grid-template-columns: 1fr 1fr 1fr;
 }

 .image-wrap {
  overflow: hidden;
  background: var(--color-placeholder);
  margin: 1rem 0;
 }

 .image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
 }

 @media (max-width: 480px) {
  .interview-header h1 {
   font-size: 1.5rem;
  }

  .interview-body {
   gap: 2.5rem;
  }

  .image-group--2,
  .image-group--3 {
   grid-template-columns: 1fr;
  }
 }
</style>
