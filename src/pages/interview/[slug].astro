---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Separator from "../../components/Separator.astro";
import Share from "../../components/Share.astro";

export async function getStaticPaths() {
 const allinterview = await getCollection("interview");
 return allinterview
  .filter(i => i.data.published)
  .map(interview => ({
   params: { slug: interview.id },
   props: { interview },
  }));
}

const { interview } = Astro.props;
const allArtists = await getCollection("artists");
const { Content } = await render(interview);

// 파일명(interview.id)으로 artists 컬렉션 조회 → 장르·이미지 연결용
const artist = allArtists.find(a => a.id === interview.id);

// 페이지 표시명: artist 필드 → artists 컬렉션 stage_name → 파일명 순으로 fallback
const stageName =
  interview.data.artist ??
  artist?.data.stage_name ??
  interview.id;

const genre = artist?.data.genre ?? "";
const dateStr = new Date(interview.data.date).toLocaleDateString("ko-KR", {
 year: "numeric",
 month: "long",
 day: "numeric",
});
const coverSrc = interview.data.coverImage?.src ?? artist?.data.image?.src ?? "";
const coverAlt = interview.data.coverImage?.alt ?? stageName;

const title = `Hausofmatters - Interview: ${stageName}`;
const seoDescription = `${stageName} | ${dateStr}`;
---

<BaseLayout title={title} description={seoDescription} ogImage={coverSrc || undefined}>
 {
  coverSrc && (
   <div class="interview-cover">
    <img src={coverSrc} alt={coverAlt} />
   </div>
  )
 }

 <header class="interview-header">
  <p class="interview-label">HAUS OF interview</p>
  <h1>{stageName}</h1>
  <p class="interview-meta">
   <span>{genre}</span>
   <span class="sep">·</span>
   <span>{dateStr}</span>
  </p>
 </header>

 <Separator />

 <div class="interview-body">
  <Content />
  <Share title={stageName} />
 </div>
</BaseLayout>

<style>
 .interview-cover {
  width: 100%;
  max-height: 70vh;
  overflow: hidden;
  margin-bottom: 1rem;
 }

 .interview-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
 }

 .interview-header {
  margin-bottom: 1rem;
  text-align: center;
 }

 .interview-label {
  margin: 0 0 0.5rem;
  text-transform: uppercase;
 }

 .interview-header h1 {
  margin: 0 0 0.5rem;
  font-size: 2rem;
 }

 .interview-meta {
  margin: 0;
  font-size: 0.85rem;
  opacity: 0.7;
 }

 .sep { opacity: 0.5; }

 /* ── 본문 ── */
 .interview-body {
  margin: 1rem auto 6rem;
  max-width: 720px;
  word-break: keep-all;
 }

 /* **볼드 단락** = 질문 */
 .interview-body :global(p > strong:only-child) {
  display: block;
  font-size: 1rem;
  font-weight: 700;
  margin-top: 2.5rem;
  margin-bottom: 0.75rem;
 }

 /* 첫 번째 질문은 위 마진 없음 */
 .interview-body :global(p:first-child > strong:only-child) {
  margin-top: 0;
 }

 /* 일반 단락 = 답변 */
 .interview-body :global(p) {
  margin: 0 0 0.75rem;
  line-height: 1.8;
  letter-spacing: -0.25px;
  padding-left: 0.75rem;
 }

 /* 질문 단락은 padding 없음 */
 .interview-body :global(p:has(> strong:only-child)) {
  padding-left: 0;
  margin-bottom: 0;
 }

 /* 인터뷰 중 삽입 이미지 */
 .interview-body :global(img) {
  width: 100%;
  height: auto;
  display: block;
  margin: 1.5rem 0;
 }

 @media (max-width: 480px) {
  .interview-header h1 { font-size: 1.5rem; }
 }
</style>
