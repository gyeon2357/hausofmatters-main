---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Separator from "../components/Separator.astro";

const title = "Hausofmatters - Magazine";
const magazineEntries = await getCollection("magazine");

magazineEntries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function formatTitle(id: string): string {
 if (/^w-hom-(\d+)$/.test(id)) return id.replace(/^w-hom-(\d+)$/, "w/HOM #$1");
 if (/^hom-(\d+)$/.test(id)) return id.replace(/^hom-(\d+)$/, "HOM #$1");
 return id.toUpperCase();
}

const resolve = (entry: (typeof magazineEntries)[number]) => ({
 title: entry.data.title ?? formatTitle(entry.id),
 slug: entry.data.slug ?? entry.id,
 image: entry.data.image ?? { src: `/images/magazine/thumb/${entry.id}.jpg`, alt: entry.id },
});

// ✅ category 기반, 각 최신 3개
const homEntries = magazineEntries.filter(e => e.data.category === "hom").slice(0, 4);
const whomEntries = magazineEntries.filter(e => e.data.category === "w-hom").slice(0, 4);
---

<BaseLayout title={title}>
 <header class="title-header title-header--initial">
  <h1>Magazine</h1>
 </header>
 <Separator />

 <div class="magazine-page">
  <section>
   <div class="section-header">
    <h3 class="section-title">HOM</h3>
    <a class="nav-link" href="/magazine/hom">View All</a>
   </div>
   <ul class="grid">
    {
     homEntries.map(entry => {
      const { title: t, slug, image } = resolve(entry);
      return (
       <li>
        <a href={`/magazine/${slug}`} data-astro-prefetch>
         {image && <img class="fade-in" src={image.src} alt={image.alt} loading="lazy" />}
         <div class="meta">
          <span class="meta-title">{t}</span>
          <span class="meta-date">
           {(() => {
            const d = new Date(entry.data.date);
            const y = d.getFullYear();
            const m = String(d.getMonth() + 1).padStart(2, "0");
            return `${y}. ${m}.`;
           })()}
          </span>
         </div>
        </a>
       </li>
      );
     })
    }
   </ul>
   <a href="/magazine/hom" class="load-more-btn" data-astro-prefetch>더보기</a>
  </section>

  {
   whomEntries.length > 0 && (
    <section>
     <div class="section-header">
      <h3 class="section-title">w/HOM</h3>
      <a class="nav-link" href="/magazine/w-hom">
       View All
      </a>
     </div>
     <ul class="grid">
      {whomEntries.map(entry => {
       const { title: t, slug, image } = resolve(entry);
       return (
        <li>
         <a href={`/magazine/${slug}`} data-astro-prefetch>
          {image && <img class="fade-in" src={image.src} alt={image.alt} loading="lazy" />}
          <div class="meta">
           <span class="meta-title">{t}</span>
           <span class="meta-date">
            {(() => {
             const d = new Date(entry.data.date);
             const y = d.getFullYear();
             const m = String(d.getMonth() + 1).padStart(2, "0");
             return `${y}. ${m}.`;
            })()}
           </span>
          </div>
         </a>
        </li>
       );
      })}
     </ul>
     <a href="/magazine/w-hom" class="load-more-btn" data-astro-prefetch>더보기</a>
    </section>
   )
  }
 </div>
</BaseLayout>

<style>
 .magazine-page {
  display: flex;
  flex-direction: column;
  gap: 4rem;
  margin: 2rem 0 8rem;
 }

 .section-title {
  margin: 0;
 }

 /* 기본값(margin-top만 2rem)을 그대로 두면 버튼 위(자기 섹션)와 아래(다음 섹션, gap 4rem이지만
    체감상 분간이 안 됐음) 여백 차이가 뚜렷하지 않아서 더보기가 어느 섹션 소속인지 애매했음 —
    위를 좁혀서 "이 섹션의 더보기"라는 소속감을 분명히 함 */
 .load-more-btn {
  margin-top: 1rem;
 }

 .grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0.75rem;
  margin: 0;
  padding: 0;
  list-style: none;
 }

 @media (max-width: 30em) {
  .grid {
   grid-template-columns: repeat(2, 1fr);
  }
 }

 li a {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  text-decoration: none;
  color: inherit;
  transition: opacity 0.2s ease;
 }

 li a:hover {
  opacity: 0.7;
 }

 li a img {
  width: 100%;
  aspect-ratio: 3 / 4;
  object-fit: cover;
 }

 .meta {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
 }

 .meta-title {
  font-size: var(--font-size-s);
  font-weight: 600;
 }
</style>
