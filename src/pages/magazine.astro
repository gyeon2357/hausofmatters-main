---
import { getCollection } from 'astro:content';
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Hausofmatters - Contact";
const magazineEntries = await getCollection('magazine');

// 최신순 정렬 (선택)
magazineEntries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={title}>
  <div class="content content--page">
    <h1>Magazine - HOM</h1>
<ul>
    {magazineEntries.map((entry) => (
      <li>
        <a class="reload-link" rel="external" href={`/magazine/hom/${entry.data.slug}`} >
          <img src={entry.data.image.src} alt={entry.data.image.alt} width="100" />
          <div>
            <strong>{entry.data.title}</strong><br />
            <span>{entry.data.date.toLocaleDateString('ko-KR')}</span>
          </div>
        </a>
      </li>
    ))}
  </ul>
  </div>
</BaseLayout>

<style>
ul {
margin: 0 auto;
padding: 0;
}

li {
list-style: none;
padding: 1rem;
}
</style>