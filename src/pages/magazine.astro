---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Separator from "../components/Separator.astro";

const title = "Hausofmatters - Magazine";
const magazineEntries = await getCollection("magazine");

magazineEntries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function formatTitle(id: string): string {
 if (/^w-hom-(\d+)$/.test(id)) return id.replace(/^w-hom-(\d+)$/, "w/HOM #$1");
 if (/^hom-(\d+)$/.test(id)) return id.replace(/^hom-(\d+)$/, "HOM #$1");
 return id.toUpperCase();
}

const resolve = (entry: (typeof magazineEntries)[number]) => ({
 title: entry.data.title ?? formatTitle(entry.id),
 slug: entry.data.slug ?? entry.id,
 image: entry.data.image ?? { src: `/images/magazine/thumb/${entry.id}.jpg`, alt: entry.id },
});

// ✅ category 기반, 각 최신 3개
const homEntries = magazineEntries.filter(e => e.data.category === "hom").slice(0, 2);
const whomEntries = magazineEntries.filter(e => e.data.category === "w-hom").slice(0, 2);
---

<BaseLayout title={title}>
 <header class="title-header title-header--initial">
  <h2>Magazine</h2>
 </header>
 <Separator />

 <div class="magazine-page">
  <section>
   <div class="section-header">
    <h3 class="section-title">HOM</h3>
    <a class="more-link" href="/magazine/hom">/ View All</a>
   </div>
   <ul class="grid">
    {
     homEntries.map(entry => {
      const { title: t, slug, image } = resolve(entry);
      return (
       <li>
        <a href={`/magazine/${slug}`} data-astro-prefetch>
         {image && <img class="fade-in" src={image.src} alt={image.alt} loading="lazy" />}
         <div class="meta">
          <span class="meta-title">{t}</span>
          {(() => {
           const d = new Date(entry.data.date);
           const y = d.getFullYear();
           const m = String(d.getMonth() + 1).padStart(2, "0");
           return `${y}. ${m}.`;
          })()}
         </div>
        </a>
       </li>
      );
     })
    }
   </ul>
  </section>

  {
   whomEntries.length > 0 && (
    <section>
     <div class="section-header">
      <h3 class="section-title">w/HOM</h3>
      <a class="more-link" href="/magazine/w-hom">
       / View All
      </a>
     </div>
     <ul class="grid">
      {whomEntries.map(entry => {
       const { title: t, slug, image } = resolve(entry);
       return (
        <li>
         <a href={`/magazine/${slug}`} data-astro-prefetch>
          {image && <img class="fade-in" src={image.src} alt={image.alt} loading="lazy" />}
          <div class="meta">
           <span class="meta-title">{t}</span>
           {(() => {
  const d = new Date(entry.data.date);
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  return `${y}. ${m}.`;
})()}
          </div>
         </a>
        </li>
       );
      })}
     </ul>
    </section>
   )
  }
 </div>
</BaseLayout>

<style>
 .magazine-page {
  display: flex;
  flex-direction: column;
  gap: 4rem;
  margin: 2rem 0 8rem;
 }

 .section-title {
  margin: 0;
 }

 .grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
  margin: 0;
  padding: 0;
  list-style: none;
 }

 @media (max-width: 30em) {
  .grid {
   grid-template-columns: repeat(2, 1fr);
  }
 }

 li a {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  text-decoration: none;
  color: inherit;
  transition: opacity 0.2s ease;
 }

 li a:hover {
  opacity: 0.7;
 }

 li a img {
  width: 100%;
  aspect-ratio: 3 / 4;
  object-fit: cover;
 }

 .meta {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
 }

 .meta-title {
  font-size: 0.875rem;
  font-weight: 600;
 }

 .meta-date {
  font-size: 0.8rem;
 }
</style>
