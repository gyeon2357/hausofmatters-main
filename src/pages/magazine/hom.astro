---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Separator from "../../components/Separator.astro";

const title = "Hausofmatters - Magazine / HOM";

const allMagazines = await getCollection("magazine");

const homCards = allMagazines
  .filter(m => m.data.category === "hom")
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map(m => {
    const slug = m.data.slug ?? m.id;
    const label = m.data.title ?? slug.replace(/^hom-(\d+)$/, "HOM #$1").toUpperCase();
    return {
      href: `/magazine/${slug}`,
      title: label,
      date: new Date(m.data.date).toLocaleDateString("ko-KR", { year: "numeric", month: "long", day: "numeric" }),
      imageSrc: m.data.image?.src ?? `/images/magazine/thumb/${m.id}.jpg`,
      imageAlt: m.data.image?.alt ?? label,
    };
  });
---

<BaseLayout title={title}>
  <header class="title-header title-header--initial">
    <h2>Magazine <span class="faded">/ HOM</span></h2>
    <a class="back" href="/magazine">← 전체보기</a>
  </header>
  <Separator />

  <ul class="grid">
    {homCards.map(card => (
      <li>
        <a href={card.href} data-astro-prefetch>
          <div class="thumb">
            <img class="fade-in" src={card.imageSrc} alt={card.imageAlt} loading="lazy" />
          </div>
          <div class="meta">
            <span class="meta-title">{card.title}</span>
            <span class="meta-date faded">{card.date}</span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .title-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .back {
    font-size: 0.85rem;
    opacity: 0.5;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s ease;
  }

  .back:hover {
    opacity: 1;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin: 2rem 0 8rem;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 30em) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 50em) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  li a {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s ease;
  }

  li a:hover {
    opacity: 0.7;
  }

  .thumb {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--color-placeholder);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .meta-title {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .meta-date {
    font-size: 0.8rem;
  }

  .faded {
    opacity: 0.5;
  }
</style>