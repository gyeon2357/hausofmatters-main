---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Separator from "../../components/Separator.astro";

const title = "Hausofmatters - Magazine / w/HOM";

const allMagazines = await getCollection("magazine");

const whomCards = allMagazines
 .filter(m => m.data.category === "w-hom")
 .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
 .map(m => {
  const slug = m.data.slug ?? m.id;
  const label = m.data.title ?? slug.replace(/^w-hom-(\d+)$/, "w/HOM #$1").toUpperCase();
  return {
   href: `/magazine/${slug}`,
   title: label,
   date: (() => { const d = new Date(m.data.date); const y = d.getFullYear(); const mo = String(d.getMonth() + 1).padStart(2, "0"); return `${y}. ${mo}.`; })(),
   imageSrc: m.data.image?.src ?? `/images/magazine/thumb/${m.id}.jpg`,
   imageAlt: m.data.image?.alt ?? label,
  };
 });
---

<BaseLayout title={title}>
 <header class="title-header title-header--initial">
  <h2>Magazine <span class="faded">/ w/HOM</span></h2>
  <a class="nav-link" href="/magazine">Back</a>
 </header>
 <Separator />

 <ul class="grid" data-load-more="12">
  {
   whomCards.map(card => (
    <li>
     <a href={card.href} data-astro-prefetch>
      <div class="thumb">
       <img class="fade-in" src={card.imageSrc} alt={card.imageAlt} loading="lazy" />
      </div>
      <div class="meta">
       <span class="meta-title">{card.title}</span>
       <span class="meta-date">{card.date}</span>
      </div>
     </a>
    </li>
   ))
  }
 </ul>
 <button type="button" class="load-more-btn" data-load-more-btn>더보기</button>
</BaseLayout>

<script src="../../scripts/loadMore.js"></script>

<style>


 .grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.75rem;
  margin: 2rem 0 8rem;
  padding: 0;
  list-style: none;
 }

 @media (min-width: 30em) {
  .grid {
   grid-template-columns: repeat(3, 1fr);
  }
 }
 @media (min-width: 50em) {
  .grid {
   grid-template-columns: repeat(4, 1fr);
  }
 }

 li a {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  text-decoration: none;
  color: inherit;
  transition: opacity 0.2s ease;
 }

 li a:hover {
  opacity: 0.7;
 }

 .thumb {
  aspect-ratio: 3 / 4;
  overflow: hidden;
  background: var(--color-placeholder);
 }

 .thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
 }

 .meta {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
 }

 .meta-title {
  font-size: var(--font-size-s);
  font-weight: 600;
 }
</style>