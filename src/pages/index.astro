---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Hausofmatters";

const allAlbums = await getCollection("albums");
const allMagazines = await getCollection("magazine");

const byDate = allAlbums.sort((a, b) => new Date(b.data.release).getTime() - new Date(a.data.release).getTime());

const picks = byDate.filter(a => a.data.recommended).slice(0, 5);
const pickIds = new Set(picks.map(a => a.id));
const latest = byDate.filter(a => !pickIds.has(a.id)).slice(0, 10 - picks.length);

const recentAlbums = [...picks, ...latest];

function formatTitle(id: string): string {
 if (/^w-hom-(\d+)$/.test(id)) return id.replace(/^w-hom-(\d+)$/, "w/HOM #$1");
 if (/^hom-(\d+)$/.test(id)) return id.replace(/^hom-(\d+)$/, "HOM #$1");
 return id.toUpperCase();
}

const albumCards = recentAlbums.map(album => {
 return {
  href: `/albums/${album.id}`,
  name: album.data.name,
  imageSrc: album.data.image?.src ?? `/images/albums/${album.id}.jpg`,
  imageAlt: album.data.image?.alt ?? album.id.replace(/-/g, " "),
  year: new Date(album.data.release).getFullYear(),
 };
});

const sorted = allMagazines.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// 인트로: hom / w-hom 커버 목록 (클라이언트에서 랜덤 선택)
// 마퀴 커버: 이미지 있는 전체 (special 제외)
type Cover = { src: string; alt: string };

const allCovers: Cover[] = sorted
 .filter(m => m.data.category !== "special")
 .map(m => ({
  src: m.data.image?.src ?? `/images/magazine/thumb/${m.id}.jpg`,
  alt: m.id,
 }));

// 4행: 커버를 행별로 중복 없이 분배, 각 행 내에서는 반복 허용
function shuffle(arr: Cover[]): Cover[] {
 return [...arr].sort(() => Math.random() - 0.5);
}

function splitInto4(arr: Cover[]): [Cover[], Cover[], Cover[], Cover[]] {
 const s = shuffle(arr);
 const n = s.length;
 // 균등 분배 (나머지는 앞 행에)
 const q = Math.floor(n / 4);
 const r = n % 4;
 const cuts = [0, q + (r > 0 ? 1 : 0), 2*q + (r > 1 ? 2 : r > 0 ? 1 : 0), 3*q + (r > 2 ? 3 : r > 1 ? 2 : r > 0 ? 1 : 0), n];
 return [s.slice(cuts[0], cuts[1]), s.slice(cuts[1], cuts[2]), s.slice(cuts[2], cuts[3]), s.slice(cuts[3], cuts[4])];
}

function fillRow(arr: Cover[], min = 16): Cover[] {
 if (!arr.length) return [];
 let out = [...arr];
 while (out.length < min) out = [...out, ...arr];
 return out;
}

const [r1, r2, r3, r4] = splitInto4(allCovers);
const row1 = fillRow(r1);
const row2 = fillRow(r2);
const row3 = fillRow(r3);
const row4 = fillRow(r4);

// ✅ category 기반, 각 최신 2개
const homCards = sorted
 .filter(m => m.data.category === "hom")
 .slice(0, 1)
 .map(m => ({
  href: `/magazine/${m.data.slug ?? m.id}`,
  title: m.data.title ?? formatTitle(m.id),
  date: new Date(m.data.date).toLocaleDateString("ko-KR"),
  imageSrc: m.data.image?.src ?? `/images/magazine/thumb/${m.id}.jpg`,
  imageAlt: m.data.image?.alt ?? m.id,
 }));

const whomCards = sorted
 .filter(m => m.data.category === "w-hom")
 .slice(0, 1)
 .map(m => ({
  href: `/magazine/${m.data.slug ?? m.id}`,
  title: m.data.title ?? formatTitle(m.id),
  date: new Date(m.data.date).toLocaleDateString("ko-KR"),
  imageSrc: m.data.image?.src ?? `/images/magazine/thumb/${m.id}.jpg`,
  imageAlt: m.data.image?.alt ?? m.id,
 }));
---

<BaseLayout title={title}>
 <!-- ── 인트로: GSAP 마퀴 ── -->
 <section class="mq-hero" id="mq-hero">
  {
   [
    { covers: row1, dir: 1, speed: 80 },
    { covers: row2, dir: -1, speed: 100 },
    { covers: row3, dir: 1, speed: 65 },
    { covers: row4, dir: -1, speed: 85 },
   ].map(({ covers, dir, speed }) => (
    <div class="mq-row" data-dir={dir} data-speed={speed}>
     <div class="mq-track">
      {[...covers, ...covers].map(c => (
       <div class="mq-item">
        <img src={c.src} alt={c.alt} loading="eager" draggable="false" />
       </div>
      ))}
     </div>
    </div>
   ))
  }
 </section>

 <section class="latest-magazine">
  <div class="section-header">
   <h2>Latest Magazine</h2>
   <a class="more-link" href="/magazine">/ View All</a>
  </div>
  <div class="magazine-columns">
   <div class="magazine-column">
    <h3 class="column-label">한국힙합 매거진 HOM</h3>
    <div class="magazine-list">
     {
      homCards.map(card => (
       <a class="magazine-card" href={card.href} data-astro-prefetch>
        <div class="magazine-img">
         <img class="fade-in" loading="lazy" src={card.imageSrc} alt={card.imageAlt} />
        </div>
        <div class="magazine-info">
         <h3 class="magazine-title">{card.title}</h3>
         <p class="magazine-date">{card.date}</p>
        </div>
       </a>
      ))
     }
    </div>
   </div>

   <div class="magazine-column">
    <h3 class="column-label">해외힙합 매거진 w/HOM</h3>
    <div class="magazine-list">
     {
      whomCards.map(card => (
       <a class="magazine-card" href={card.href} data-astro-prefetch>
        <div class="magazine-img">
         <img class="fade-in" loading="lazy" src={card.imageSrc} alt={card.imageAlt} />
        </div>
        <div class="magazine-info">
         <h3 class="magazine-title">{card.title}</h3>
         <p class="magazine-date">{card.date}</p>
        </div>
       </a>
      ))
     }
    </div>
   </div>
  </div>
 </section>

 <section class="featured-albums">
  <div class="section-header">
   <h2>Featured Album</h2>
   <a class="more-link" href="/albums">/ View All</a>
  </div>
  <div class="albums-grid">
   {
    albumCards.map(card => (
     <a class="album-card" href={card.href} data-name={card.name} data-astro-prefetch>
      <div class="album-img">
       <img class="fade-in" loading="lazy" src={card.imageSrc} alt={card.imageAlt} />
      </div>
      <p class="album-name">{card.name}</p>
      <p class="album-year">{card.year}</p>
     </a>
    ))
   }
  </div>
 </section>
</BaseLayout>

<style>
 /* ── 마퀴 히어로 ── */
 .mq-hero {
  width: 100vw;
  height: calc(100vh - 5rem);
  margin-left: -0.5rem;
  margin-right: -0.5rem;
  margin-bottom: 6rem;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  
 }

 .mq-row {
  flex: 1;
  overflow: hidden;
  display: flex;
  align-items: stretch;
 }

 .mq-track {
  display: flex;
  align-items: stretch;

  will-change: transform;
  flex-shrink: 0;
 }

 .mq-item {
  flex-shrink: 0;
  height: 100%;
  overflow: hidden;
 }

 .mq-item img {
  height: 100%;
  width: auto;
  display: block;
  object-fit: cover;
  pointer-events: none;
  user-select: none;
 }

 /* ── 기존 스타일 ── */
 .featured-albums {
  margin: 4rem 0;
 }

 .albums-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 0.75rem;
  margin-bottom: 4rem;
 }

 .album-year {
  margin: 0;
  font-size: 0.85rem;
 }

 .latest-magazine {
  margin: 4rem 0 6rem;
 }

 .magazine-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
 }

 .column-label {
  margin: 0 0 0.5rem;
  font-size: 1.25rem;
 }

 .magazine-list {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
 }

 .magazine-card {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  text-decoration: none;
  color: inherit;
  transition: opacity 0.2s ease;
 }

 .magazine-card:hover {
  opacity: 0.7;
 }

 .magazine-img {
  overflow: hidden;
  background: var(--color-placeholder);
 }

 .magazine-img img {
  width: 100%;
  object-fit: cover;
  display: block;
 }

 .magazine-info {
  display: flex;
  flex-direction: column;
 }

 .magazine-title {
  margin: 0;
  font-size: 0.95rem;
  line-height: 1.3;
 }

 .magazine-date {
  margin: 0;
  font-size: 0.85rem;
  line-height: 1.3;
 }

 .section-header {
  display: flex;
  align-items: center;
  justify-content: start;
  gap: 2rem;
  margin-bottom: 2rem;
 }

 .section-header h2 {
  margin: 0;
  font-size: 1.5rem;
 }

 @media (max-width: 768px) {
  .albums-grid {
   grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
  }
 }

 @media (max-width: 480px) {
  .featured-albums,
  .latest-magazine {
   margin: 2rem 0;
  }
  .albums-grid {
   grid-template-columns: repeat(2, 1fr);
  }
  .magazine-columns {
   grid-template-columns: 1fr;
   gap: 2.5rem;
  }
 }
</style>

<script src="../scripts/index.js"></script>

<script>
 import { gsap } from "gsap";

 document.addEventListener("astro:page-load", initMarquee);
 if (document.readyState !== "loading") initMarquee();

 function initMarquee() {
  const rows = document.querySelectorAll<HTMLElement>(".mq-row");
  if (!rows.length) return;

  rows.forEach(row => {
   const track = row.querySelector<HTMLElement>(".mq-track");
   if (!track) return;

   const dir = Number(row.dataset.dir ?? 1);
   const speed = Number(row.dataset.speed ?? 80);

   gsap.fromTo(
    track,
    { xPercent: dir === 1 ? 0 : -5 },
    {
     xPercent: dir === 1 ? -5 : 0,
     duration: speed,
     ease: "none",
     repeat: -1,
    }
   );
  });
 }
</script>
