---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Hausofmatters";

const allAlbums = await getCollection("albums");
const allMagazines = await getCollection("magazine");

const byDate = allAlbums.sort((a, b) => new Date(b.data.release).getTime() - new Date(a.data.release).getTime());

const picks = byDate.filter(a => a.data.recommended).slice(0, 5);
const pickIds = new Set(picks.map(a => a.id));
const latest = byDate.filter(a => !pickIds.has(a.id)).slice(0, 10 - picks.length);

const recentAlbums = [...picks, ...latest];

function formatTitle(id: string): string {
 if (/^w-hom-(\d+)$/.test(id)) return id.replace(/^w-hom-(\d+)$/, "w/HOM #$1");
 if (/^hom-(\d+)$/.test(id)) return id.replace(/^hom-(\d+)$/, "HOM #$1");
 return id.toUpperCase();
}

// 마크다운 서식을 걷어내고 리뷰 본문 일부만 미리보기로 보여줄 때 사용
function excerpt(markdown: string, maxLength = 140): string {
 const plain = markdown
  .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
  .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
  .replace(/[*_`#>]/g, "")
  .replace(/\s+/g, " ")
  .trim();
 return plain.length > maxLength ? plain.slice(0, maxLength).trim() + "…" : plain;
}

const albumCards = recentAlbums.map((album, index) => {
 return {
  href: `/albums/${album.id}`,
  name: album.data.name,
  imageSrc: album.data.image?.src ?? `/images/albums/${album.id}.jpg`,
  imageAlt: album.data.image?.alt ?? album.id.replace(/-/g, " "),
  year: new Date(album.data.release).getFullYear(),
  featured: index < 2,
  review: index < 2 ? excerpt(album.body ?? "") : "",
 };
});

const sorted = allMagazines.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// ✅ category 기반, 각 최신 3개
const homCards = sorted
 .filter(m => m.data.category === "hom")
 .slice(0, 3)
 .map(m => ({
  href: `/magazine/${m.data.slug ?? m.id}`,
  title: m.data.title ?? formatTitle(m.id),
  date: new Date(m.data.date).toLocaleDateString("ko-KR"),
  imageSrc: m.data.image?.src ?? `/images/magazine/thumb/${m.id}.jpg`,
  imageAlt: m.data.image?.alt ?? m.id,
 }));

const whomCards = sorted
 .filter(m => m.data.category === "w-hom")
 .slice(0, 3)
 .map(m => ({
  href: `/magazine/${m.data.slug ?? m.id}`,
  title: m.data.title ?? formatTitle(m.id),
  date: new Date(m.data.date).toLocaleDateString("ko-KR"),
  imageSrc: m.data.image?.src ?? `/images/magazine/thumb/${m.id}.jpg`,
  imageAlt: m.data.image?.alt ?? m.id,
 }));

// 히어로: 국내/해외 매거진 최신호 커버 각 1장씩 — 둘 다 있을 때만 슬라이드 보여줌
const heroSlides = [homCards[0], whomCards[0]].filter((card): card is NonNullable<typeof card> => Boolean(card));
---

<BaseLayout title={title}>
 <!-- 로고가 시각적으로 h1 역할을 하므로 화면에는 안 보이게(sr-only) 하되,
      스크린리더 사용자가 페이지 제목을 들을 수 있도록 실제 h1은 둠 -->
 <h1 class="sr-only">Hausofmatters</h1>

 <!-- ── 히어로: 국내/해외 매거진 최신호 커버를 아주 느리게 크로스페이드.
      이미지가 하나도 없으면(컨텐츠 준비 전) 배경색 박스만 자리를 잡음 ── -->
 <section class="hero-placeholder full-bleed" id="hero-placeholder">
  {
   heroSlides.map((slide, i) => (
    <img
     class="hero-slide"
     src={slide.imageSrc}
     alt={`${slide.title} 커버`}
     loading="eager"
     style={`animation-delay: ${i * 12}s;`}
    />
   ))
  }
 </section>

 <section class="latest-magazine">
  <div class="section-header">
   <h2>Latest Magazine</h2>
   <a class="nav-link" href="/magazine">View All</a>
  </div>
  <div class="magazine-columns">
   <div class="magazine-column">
    <h3 class="column-label">한국힙합 매거진 HOM</h3>
    <div class="magazine-list">
     {
      homCards.map(card => (
       <a class="magazine-card" href={card.href} data-astro-prefetch>
        <div class="magazine-img">
         <img class="fade-in" loading="lazy" src={card.imageSrc} alt={card.imageAlt} />
        </div>
        <div class="magazine-info">
         <h3 class="magazine-title">{card.title}</h3>
         <p class="meta-date">{card.date}</p>
        </div>
       </a>
      ))
     }
    </div>
   </div>

   <div class="magazine-column">
    <h3 class="column-label">해외힙합 매거진 w/HOM</h3>
    <div class="magazine-list">
     {
      whomCards.map(card => (
       <a class="magazine-card" href={card.href} data-astro-prefetch>
        <div class="magazine-img">
         <img class="fade-in" loading="lazy" src={card.imageSrc} alt={card.imageAlt} />
        </div>
        <div class="magazine-info">
         <h3 class="magazine-title">{card.title}</h3>
         <p class="meta-date">{card.date}</p>
        </div>
       </a>
      ))
     }
    </div>
   </div>
  </div>
 </section>

 <section class="featured-albums">
  <div class="section-header">
   <h2>Featured Album</h2>
   <a class="nav-link" href="/albums">View All</a>
  </div>
  <div class="albums-grid">
   {
    albumCards.map(card => (
     <a class:list={["album-card", { "album-card--featured": card.featured }]} href={card.href} data-name={card.name} data-astro-prefetch>
      <div class="album-img">
       <img class="fade-in" loading="lazy" src={card.imageSrc} alt={card.imageAlt} />
      </div>
      <p class="album-name">{card.name}</p>
      <p class="meta-date">{card.year}</p>
      {card.featured && card.review && <p class="album-review">{card.review}</p>}
     </a>
    ))
   }
  </div>
 </section>
</BaseLayout>

<style>
 /* ── 히어로 플레이스홀더 ── */
 /* 화면 끝까지 채우는 건 global.css의 .full-bleed 클래스(grid-column: 1 / -1)가 담당.
    여기서는 높이/배경만 지정 — 좌우 여백 관련 margin 계산이 필요 없음 */
 .hero-placeholder {
  position: relative;
  height: 100vh;
  margin-bottom: 4rem;
  background: var(--color-placeholder);
 }

 /* 커버가 1장뿐이면 애니메이션 없이 그냥 보여주고, 2장이면 서로 번갈아 크로스페이드 —
    opacity만 바뀌므로 prefers-reduced-motion 전역 규칙(animation-duration 강제 축소)에
    자동으로 걸려서 모션 민감 사용자에게는 그냥 즉시 전환됨 */
 .hero-slide {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
 }

 .hero-slide:only-child {
  opacity: 1;
 }

 .hero-slide:not(:only-child) {
  animation: hero-crossfade 24s ease-in-out infinite;
 }

 /* 0~41.6%(0~10s) 보임 → 41.6~50%(10~12s) 페이드아웃 → 91.6%(22s)까지 숨김 →
    다시 페이드인. 두 번째 슬라이드는 animation-delay로 정확히 절반(12s)만큼 밀려서
    서로 어긋나게(한쪽이 보일 때 다른 쪽은 숨김) 돎 */
 @keyframes hero-crossfade {
  0%,
  41.6% {
   opacity: 1;
  }
  50%,
  91.6% {
   opacity: 0;
  }
  100% {
   opacity: 1;
  }
 }

 /* 이미지 로드 실패 시 깨진 아이콘 대신 .hero-placeholder 배경색만 보이게 숨김
    (아래 스크립트가 error 이벤트에서 추가) */
 .hero-slide--missing {
  display: none;
 }

 /* ── 기존 스타일 ── */
 .featured-albums {
  margin: 4rem 0;
 }

 .albums-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 0.75rem;
  margin-bottom: 4rem;
 }

 /* 처음 2개(추천 앨범)는 2칸을 차지하는 큰 카드로 보여주고, 리뷰 일부를 함께 노출 */
 .album-card--featured {
  grid-column: span 2;
 }

 .album-review {
  margin: 0.5rem 0 0.5rem;
  font-size: var(--font-size-s);
  line-height: 1.5;
  color: var(--color-text-alt);

  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
 }

 .latest-magazine {
  margin: 4rem 0 6rem;
 }

 .magazine-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
  max-width: 1200px;
 }

 .column-label {
  margin: 0 0 0.5rem;
  font-size: var(--font-size-l);
 }

 .magazine-list {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
 }

 .magazine-card {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  text-decoration: none;
  color: inherit;
  transition: opacity 0.2s ease;
 }

 .magazine-card:hover {
  opacity: 0.7;
 }

 .magazine-img {
  overflow: hidden;
  background: var(--color-placeholder);
 }

 .magazine-img img {
  width: 100%;
  object-fit: cover;
  display: block;
 }

 .magazine-info {
  display: flex;
  flex-direction: column;
 }

 .magazine-title {
  margin: 0;
  font-size: var(--font-size-base);
  line-height: 1.3;
 }

 .section-header {
  display: flex;
  align-items: center;
  justify-content: start;
  gap: 2rem;
  margin-bottom: 2rem;
 }

 @media (max-width: 768px) {
  .albums-grid {
   grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
  }
 }

 @media (max-width: 480px) {
  .featured-albums,
  .latest-magazine {
   margin: 2rem 0;
  }
  .albums-grid {
   grid-template-columns: repeat(2, 1fr);
  }
  .magazine-columns {
   grid-template-columns: 1fr;
   gap: 2.5rem;
  }
 }
</style>

<script src="../scripts/index.js"></script>

<script>
 // 커버 이미지가 깨져 있으면(잘못된 경로 등) 아이콘 대신 .hero-placeholder 배경색만
 // 보이도록 조용히 숨김 — 슬라이드가 하나뿐이면 :only-child가 안 맞게 되므로,
 // 숨긴 뒤 남은 슬라이드가 1장이면 애니메이션 없이 바로 보이도록 다시 계산함
 function initHeroFallback() {
  const slides = Array.from(document.querySelectorAll<HTMLImageElement>(".hero-slide"));
  if (slides.length === 0) return;

  const hide = (img: HTMLImageElement) => {
   img.classList.add("hero-slide--missing");
   const remaining = slides.filter(s => !s.classList.contains("hero-slide--missing"));
   if (remaining.length === 1) {
    remaining[0].style.animation = "none";
    remaining[0].style.opacity = "1";
   }
  };

  slides.forEach(img => {
   if (img.complete && img.naturalWidth === 0) hide(img);
   else img.addEventListener("error", () => hide(img), { once: true });
  });
 }

 document.addEventListener("astro:page-load", initHeroFallback);
</script>
