---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Hausofmatters";

const allAlbums = await getCollection("albums");
const recentAlbums = allAlbums
 .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
 .slice(0, 5) // ← 최신 3개만
 .sort(() => Math.random() - 0.5); // ← 랜덤 정렬

// const recentAlbums = allAlbums
// .sort(() => Math.random() - 0.5)
// .slice(0, 5);

// Magazine 컬렉션에서 최신 1개 가져오기
const allMagazines = await getCollection("magazine");
const latestMagazine = allMagazines.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).at(0);

// const latestMagazines = allMagazines
//   .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
//   .slice(0, 3);  // 최신 3개

// Artists 데이터 (필요한 경우)
const allArtists = await getCollection("artists");
---

<BaseLayout title={title}>
 <div class="content content--page">
  <h1>Hausofmatters</h1>
  <p>Welcome to our music platform</p>
 </div>

 <!-- 섹션 1: 추천 앨범 -->
 <section class="featured-albums">
  <h2>오늘의 추천 리뷰</h2>
  <div class="albums-grid">
   {
    recentAlbums.map(album => {
     // ✅ artist를 안전하게 체크
     const artistId = album.data.artist.id;

     const hasArtist = artistId !== "";
     const artist = hasArtist ? allArtists.find(a => a.id === artistId) : null;

     return (
      <a
       class="album-card"
       href={artist ? `/${artist.id}/albums/${album.id}` : `/albums/${album.id}`}
       data-stagename={album.data.name}
       data-name={album.data.name}
       data-astro-prefetch>
       <div class="album-img">
        <img class="fade-in" loading="lazy" src={album.data.image.src} alt={album.data.image.alt} />
       </div>
       <h3>{album.data.name}</h3>
       <p class="album-year">{new Date(album.data.publishDate).getFullYear()}</p>
      </a>
     );
    })
   }
  </div>
 </section>

 <!-- 섹션 2: 매거진 최신호 -->
 {
  latestMagazine && (
   <section class="latest-magazine">
    <h2>매거진 최신호</h2>
    <a class="magazine-feature" href={`/magazine/hom/${latestMagazine.data.slug}`} data-astro-prefetch>
     <div class="magazine-img">
      <img src={latestMagazine.data.image.src} alt={latestMagazine.data.image.alt} />
     </div>
     <div class="magazine-info">
      <h3>{latestMagazine.data.title}</h3>
      <p class="magazine-date">{new Date(latestMagazine.data.date).toLocaleDateString("ko-KR")}</p>
      <p class="magazine-cta">View Issue →</p>
     </div>
    </a>
   </section>
  )
 }
</BaseLayout>

<style>
 /* Featured Albums 섹션 */
 .featured-albums {
  margin: 4rem 0;
 }

 .featured-albums h2 {
  margin-bottom: 2rem;
  font-size: 1.5rem;
 }

 .albums-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 1.5rem;
  margin-bottom: 4rem;
 }

 .album-card {
  text-decoration: none;
  color: inherit;
  transition: transform 0.3s ease;
 }

 .album-card:hover {
  transform: translateY(-4px);
 }

 .album-img {
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 0.25rem;
  background: var(--color-placeholder);
  margin-bottom: 0.75rem;
 }

 .album-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
 }

 .album-card h3 {
  margin: 0;
  font-size: 0.95rem;
  line-height: 1.3;
 }

 .album-year {
  margin: 0.5rem 0 0;
  font-size: 0.85rem;
  opacity: 0.6;
 }

 /* Latest Magazine 섹션 */
 .latest-magazine {
  margin: 4rem 0 6rem;
 }

 .latest-magazine h2 {
  margin-bottom: 2rem;
  font-size: 1.5rem;
 }

 .magazine-feature {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  align-items: center;
  text-decoration: none;
  color: inherit;
 }

 .magazine-img {
  overflow: hidden;
  border-radius: 0.25rem;
  aspect-ratio: 1;
 }

 .magazine-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.3s ease;
 }

 .magazine-feature:hover .magazine-img img {
  transform: scale(1.05);
 }

 .magazine-info h3 {
  margin: 0 0 1rem;
  font-size: 1.5rem;
 }

 .magazine-date {
  margin: 0 0 1.5rem;
  opacity: 0.6;
 }

 .magazine-cta {
  margin: 0;
  opacity: 0.7;
  transition: opacity 0.3s ease;
 }

 .magazine-feature:hover .magazine-cta {
  opacity: 1;
 }

 /* 반응형 */
 @media (max-width: 768px) {
  .albums-grid {
   grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
   gap: 1rem;
  }

  .magazine-feature {
   grid-template-columns: 1fr;
  }
 }

 @media (max-width: 480px) {
  .featured-albums,
  .latest-magazine {
   margin: 2rem 0;
  }

  .albums-grid {
   grid-template-columns: repeat(2, 1fr);
  }

  .magazine-info h3 {
   font-size: 1.2rem;
  }
 }
</style>

<script src="../scripts/index.js"></script>
