---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Hausofmatters";

const allAlbums = await getCollection("albums");
const allMagazines = await getCollection("magazine");

const byDate = allAlbums.sort((a, b) => new Date(b.data.release).getTime() - new Date(a.data.release).getTime());

const picks = byDate.filter(a => a.data.recommended).slice(0, 5);
const pickIds = new Set(picks.map(a => a.id));
const latest = byDate.filter(a => !pickIds.has(a.id)).slice(0, 10 - picks.length);

const recentAlbums = [...picks, ...latest];

function formatTitle(id: string): string {
 if (/^w-hom-(\d+)$/.test(id)) return id.replace(/^w-hom-(\d+)$/, "w/HOM #$1");
 if (/^hom-(\d+)$/.test(id)) return id.replace(/^hom-(\d+)$/, "HOM #$1");
 return id.toUpperCase();
}

const albumCards = recentAlbums.map(album => {
 return {
  href: `/albums/${album.id}`,
  name: album.data.name,
  imageSrc: album.data.image?.src ?? `/images/albums/${album.id}.jpg`,
  imageAlt: album.data.image?.alt ?? album.id.replace(/-/g, " "),
  year: new Date(album.data.release).getFullYear(),
 };
});

const sorted = allMagazines.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// 인트로: Three.js WebGL 드리프트용 매거진 썸네일 URL 목록
const coverUrls: string[] = sorted
 .filter(m => m.data.category !== "special")
 .map(m => m.data.image?.src ?? `/images/magazine/thumb/${m.id}.jpg`);

// ✅ category 기반, 각 최신 2개
const homCards = sorted
 .filter(m => m.data.category === "hom")
 .slice(0, 1)
 .map(m => ({
  href: `/magazine/${m.data.slug ?? m.id}`,
  title: m.data.title ?? formatTitle(m.id),
  date: new Date(m.data.date).toLocaleDateString("ko-KR"),
  imageSrc: m.data.image?.src ?? `/images/magazine/thumb/${m.id}.jpg`,
  imageAlt: m.data.image?.alt ?? m.id,
 }));

const whomCards = sorted
 .filter(m => m.data.category === "w-hom")
 .slice(0, 1)
 .map(m => ({
  href: `/magazine/${m.data.slug ?? m.id}`,
  title: m.data.title ?? formatTitle(m.id),
  date: new Date(m.data.date).toLocaleDateString("ko-KR"),
  imageSrc: m.data.image?.src ?? `/images/magazine/thumb/${m.id}.jpg`,
  imageAlt: m.data.image?.alt ?? m.id,
 }));
---

<BaseLayout title={title}>
 <!-- ── 인트로: Three.js WebGL 드리프트 ── -->
 <section class="webgl-intro" id="webgl-intro">
  <canvas id="drift-canvas"></canvas>
  <script id="cover-urls" type="application/json" set:html={JSON.stringify(coverUrls)} />
 </section>

 <section class="latest-magazine">
  <div class="section-header">
   <h2>Latest Magazine</h2>
   <a class="more-link" href="/magazine">/ View All</a>
  </div>
  <div class="magazine-columns">
   <div class="magazine-column">
    <h3 class="column-label">한국힙합 매거진 HOM</h3>
    <div class="magazine-list">
     {
      homCards.map(card => (
       <a class="magazine-card" href={card.href} data-astro-prefetch>
        <div class="magazine-img">
         <img class="fade-in" loading="lazy" src={card.imageSrc} alt={card.imageAlt} />
        </div>
        <div class="magazine-info">
         <h3 class="magazine-title">{card.title}</h3>
         <p class="magazine-date">{card.date}</p>
        </div>
       </a>
      ))
     }
    </div>
   </div>

   <div class="magazine-column">
    <h3 class="column-label">해외힙합 매거진 w/HOM</h3>
    <div class="magazine-list">
     {
      whomCards.map(card => (
       <a class="magazine-card" href={card.href} data-astro-prefetch>
        <div class="magazine-img">
         <img class="fade-in" loading="lazy" src={card.imageSrc} alt={card.imageAlt} />
        </div>
        <div class="magazine-info">
         <h3 class="magazine-title">{card.title}</h3>
         <p class="magazine-date">{card.date}</p>
        </div>
       </a>
      ))
     }
    </div>
   </div>
  </div>
 </section>

 <section class="featured-albums">
  <div class="section-header">
   <h2>Featured Album</h2>
   <a class="more-link" href="/albums">/ View All</a>
  </div>
  <div class="albums-grid">
   {
    albumCards.map(card => (
     <a class="album-card" href={card.href} data-name={card.name} data-astro-prefetch>
      <div class="album-img">
       <img class="fade-in" loading="lazy" src={card.imageSrc} alt={card.imageAlt} />
      </div>
      <p class="album-name">{card.name}</p>
      <p class="album-year">{card.year}</p>
     </a>
    ))
   }
  </div>
 </section>
</BaseLayout>

<style>
  /* ── WebGL 인트로 ── */
 .webgl-intro {
  position: relative;
  width: 100vw;
  height: 100vh;
  margin-left: -0.5rem;
  margin-right: -0.5rem;
  margin-bottom: 4rem;
  overflow: hidden;
  background: var(--color-bg);
 }

 #drift-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
 }

 /* ── 기존 스타일 ── */
 .featured-albums {
  margin: 4rem 0;
 }

 .albums-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 0.75rem;
  margin-bottom: 4rem;
 }

 .album-year {
  margin: 0;
  font-size: 0.85rem;
 }

 .latest-magazine {
  margin: 4rem 0 6rem;
 }

 .magazine-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
 }

 .column-label {
  margin: 0 0 0.5rem;
  font-size: 1.25rem;
 }

 .magazine-list {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
 }

 .magazine-card {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  text-decoration: none;
  color: inherit;
  transition: opacity 0.2s ease;
 }

 .magazine-card:hover {
  opacity: 0.7;
 }

 .magazine-img {
  overflow: hidden;
  background: var(--color-placeholder);
 }

 .magazine-img img {
  width: 100%;
  object-fit: cover;
  display: block;
 }

 .magazine-info {
  display: flex;
  flex-direction: column;
 }

 .magazine-title {
  margin: 0;
  font-size: 0.95rem;
  line-height: 1.3;
 }

 .magazine-date {
  margin: 0;
  font-size: 0.85rem;
  line-height: 1.3;
 }

 .section-header {
  display: flex;
  align-items: center;
  justify-content: start;
  gap: 2rem;
  margin-bottom: 2rem;
 }

 .section-header h2 {
  margin: 0;
  font-size: 1.5rem;
 }

 @media (max-width: 768px) {
  .albums-grid {
   grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
  }
 }

 @media (max-width: 480px) {
  .featured-albums,
  .latest-magazine {
   margin: 2rem 0;
  }
  .albums-grid {
   grid-template-columns: repeat(2, 1fr);
  }
  .magazine-columns {
   grid-template-columns: 1fr;
   gap: 2.5rem;
  }
 }
</style>

<script src="../scripts/index.js"></script>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script is:inline>
(function() {
  const canvas = document.getElementById('drift-canvas');
  if (!canvas) return;
  const urlData = document.getElementById('cover-urls');
  const allUrls = urlData ? JSON.parse(urlData.textContent || '[]') : [];
  if (!allUrls.length) return;

  const scene = new THREE.Scene();
  const camera = new THREE.OrthographicCamera(-1,1,1,-1,0.1,10);
  camera.position.z = 1;
  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setSize(window.innerWidth, window.innerHeight);

  const NUM_BANDS   = 8;
  const CLONE_COUNT = 3;
  const IMAGE_GAP   = 12;

  // 밴드 높이 = 뷰포트 / 밴드 수 - 간격
  function getBandHeight() { return Math.floor(window.innerHeight / NUM_BANDS) - 4; }
  function getImageHeight() { return getBandHeight() - 10; }

  // offsetY: 뷰포트 기준 균등 분배 (겹침 없음)
  function computeOffsets() {
    const spacing = window.innerHeight / NUM_BANDS;
    return Array.from({ length: NUM_BANDS }, (_, i) =>
      (i - (NUM_BANDS - 1) / 2) * spacing
    );
  }

  const bandSpeeds    = [0.55, 0.80, 0.45, 0.65, 0.35, 0.70, 0.50, 0.90];
  const bandRotations = Array(NUM_BANDS).fill(7 * Math.PI / 180);
  const bandRotTypes  = ['fromLeft','fromCenter','fromLeft','fromCenter','fromLeft','fromCenter','fromLeft','fromCenter'];
  const bandCurves    = [35,30,35,30,35,30,35,30];

  // URL → 8밴드 분배
  function getUrlsForBand(bi) {
    const base = allUrls.filter((_, i) => i % NUM_BANDS === bi);
    const pool = base.length ? base : allUrls;
    const out = [...pool];
    while (out.length < 4) out.push(...pool);
    return out;
  }

  function createBandTexture(images, bandH, imgH) {
    let seqW = 0;
    images.forEach(img => { if (img.loaded) seqW += img.width + IMAGE_GAP; });
    seqW = Math.max(seqW - IMAGE_GAP, 1);
    const totalW = seqW * CLONE_COUNT;
    const c = document.createElement('canvas');
    c.width = totalW; c.height = bandH;
    const ctx = c.getContext('2d');
    let x = 0;
    for (let cl = 0; cl < CLONE_COUNT; cl++) {
      images.forEach(img => {
        if (!img.loaded) return;
        const cy = (bandH - img.height) / 2;
        ctx.save(); ctx.globalAlpha = 0.93;
        ctx.drawImage(img.el, x, cy, img.width, img.height);
        ctx.restore();
        x += img.width + IMAGE_GAP;
      });
    }
    return { canvas: c, totalWidth: totalW, sequenceWidth: seqW };
  }

  function loadBand(bi) {
    const bandH = getBandHeight();
    const imgH  = getImageHeight();
    return new Promise(resolve => {
      const urls = getUrlsForBand(bi);
      const images = [];
      let loaded = 0;
      urls.forEach(url => {
        const obj = { loaded: false, el: null, width: 0, height: 0 };
        images.push(obj);
        const img = new Image();
        img.crossOrigin = 'anonymous';
        const done = () => { if (++loaded === urls.length) resolve(createBandTexture(images, bandH, imgH)); };
        img.onload = () => {
          const ratio = img.naturalWidth / img.naturalHeight;
          obj.height = imgH;
          obj.width  = Math.round(imgH * ratio);
          obj.el = img; obj.loaded = true; done();
        };
        img.onerror = () => {
          const ph = document.createElement('canvas');
          ph.width = 80; ph.height = imgH;
          ph.getContext('2d').fillStyle = '#222';
          ph.getContext('2d').fillRect(0,0,80,imgH);
          obj.el = ph; obj.width = 80; obj.height = imgH; obj.loaded = true; done();
        };
        img.src = url;
      });
    });
  }

  const vertexShader = `
    varying vec2 vUv;
    void main(){ vUv=uv; gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0); }
  `;
  const fragmentShader = `
    precision highp float;
    uniform vec2 uResolution; uniform sampler2D uTexture;
    uniform float uTextureWidth,uSequenceWidth,uBandHeight;
    uniform float uScroll,uSpeed,uOffsetY,uRotation;
    uniform float uRotationType,uHasRotation,uCurveAmount,uCurveDirection;
    varying vec2 vUv;
    mat2 rot(float a){ return mat2(cos(a),-sin(a),sin(a),cos(a)); }
    void main(){
      vec2 p=vUv*uResolution; vec2 op=p;
      float nx=p.x/uResolution.x;
      float cf=4.0*(nx-0.5)*(nx-0.5);
      float co=(0.5-cf)*uCurveAmount*uCurveDirection;
      float bt=(uResolution.y-uBandHeight)*0.5+uOffsetY+co;
      float bb=bt+uBandHeight;
      float bcy=(uResolution.y-uBandHeight)*0.5+uOffsetY+uBandHeight*0.5;
      if(uHasRotation>0.5){
        vec2 rc=uRotationType>0.5?vec2(0.0,bcy):vec2(uResolution.x*0.5,bcy);
        p-=rc; p=rot(uRotation)*p; p+=rc;
        op-=rc; op=rot(uRotation)*op; op+=rc;
      }
      float margin=3.0;
      if(p.y<bt-margin||p.y>bb+margin){ discard; return; }
      float sp=uScroll*uSpeed;
      float wx=mod(op.x+sp,uSequenceWidth);
      float tx=(wx+uSequenceWidth)/uTextureWidth;
      float ty=(p.y-bt)/(bb-bt);
      if(tx<0.0||tx>1.0||ty<0.0||ty>1.0){ discard; return; }
      vec4 col=texture2D(uTexture,vec2(tx,ty));
      if(col.a<0.5){ discard; return; }
      float edge=min(p.y-bt,bb-p.y);
      if(edge<margin) col.a*=smoothstep(0.0,margin,edge);
      if(col.a<0.01){ discard; return; }
      gl_FragColor=col;
    }
  `;

  let materials = [];
  let autoScroll  = 0;
  const DRIFT_SPEED = 0.6;

  // ── 드래그 인터랙션 ──
  let isDragging = false;
  let lastDragX  = 0;
  let velocity   = 0;
  const INERTIA  = 0.90;

  canvas.style.cursor = 'grab';

  canvas.addEventListener('mousedown', e => {
    isDragging = true; lastDragX = e.clientX; velocity = 0;
    canvas.style.cursor = 'grabbing';
  });
  window.addEventListener('mousemove', e => {
    if (!isDragging) return;
    const dx = e.clientX - lastDragX;
    autoScroll -= dx * 2;
    velocity = -dx * 2;
    lastDragX = e.clientX;
  });
  window.addEventListener('mouseup', () => {
    isDragging = false;
    canvas.style.cursor = 'grab';
  });

  canvas.addEventListener('touchstart', e => {
    isDragging = true; lastDragX = e.touches[0].clientX; velocity = 0;
  }, { passive: true });
  canvas.addEventListener('touchmove', e => {
    const dx = e.touches[0].clientX - lastDragX;
    autoScroll -= dx * 2;
    velocity = -dx * 2;
    lastDragX = e.touches[0].clientX;
  }, { passive: true });
  canvas.addEventListener('touchend', () => { isDragging = false; });

  function animate() {
    requestAnimationFrame(animate);
    if (!isDragging) {
      autoScroll += DRIFT_SPEED;
      autoScroll += velocity;
      velocity *= INERTIA;
    }
    const offsets = computeOffsets();
    const bandH   = getBandHeight();
    materials.forEach((m, i) => {
      m.uniforms.uScroll.value      = autoScroll;
      m.uniforms.uOffsetY.value     = offsets[i];
      m.uniforms.uBandHeight.value  = bandH;
      m.uniforms.uResolution.value.set(window.innerWidth, window.innerHeight);
    });
    renderer.render(scene, camera);
  }

  async function init() {
    const offsets = computeOffsets();
    const bandH   = getBandHeight();
    const results = await Promise.all(
      Array.from({ length: NUM_BANDS }, (_, i) => loadBand(i))
    );
    results.forEach((td, i) => {
      const tex = new THREE.Texture(td.canvas);
      tex.needsUpdate = true;
      const mat = new THREE.ShaderMaterial({
        uniforms: {
          uResolution:    { value: new THREE.Vector2(window.innerWidth, window.innerHeight) },
          uTexture:       { value: tex },
          uTextureWidth:  { value: td.totalWidth },
          uSequenceWidth: { value: td.sequenceWidth },
          uBandHeight:    { value: bandH },
          uScroll:        { value: 0 },
          uSpeed:         { value: bandSpeeds[i] },
          uOffsetY:       { value: offsets[i] },
          uRotation:      { value: bandRotations[i] },
          uRotationType:  { value: bandRotTypes[i] === 'fromLeft' ? 1.0 : 0.0 },
          uHasRotation:   { value: 1.0 },
          uCurveAmount:   { value: bandCurves[i] },
          uCurveDirection:{ value: 1 },
        },
        vertexShader, fragmentShader,
        transparent: true, depthTest: false, depthWrite: false, alphaTest: 0.5,
      });
      materials.push(mat);
      const mesh = new THREE.Mesh(new THREE.PlaneGeometry(2,2), mat);
      mesh.position.z = i * -0.1;
      scene.add(mesh);
    });
    animate();
  }

  window.addEventListener('resize', () => {
    renderer.setSize(window.innerWidth, window.innerHeight);
  });

  init();
})();
</script>
