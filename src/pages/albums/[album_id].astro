---
import type { CollectionEntry } from "astro:content";
import { getCollection, render, getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Separator from "../../components/Separator.astro";
import Share from "../../components/Share.astro";

export const getStaticPaths = async () => {
 const albums = await getCollection("albums");
 return albums.map(album => ({
  params: { album_id: album.id },
  props: { album },
 }));
};

type Props = {
 album: CollectionEntry<"albums">;
};

const { album } = Astro.props;
const { Content } = await render(album);

const category = album.data.category === "w-hom" ? "w-hom" : "hom";
const backHref = `/albums/${category}`;
const backLabel = "/ Back";

// artist
const rawArtist = album.data.artist as unknown;
const artistId: string | undefined =
 typeof rawArtist === "string"
  ? rawArtist
  : typeof rawArtist === "object" && rawArtist !== null && "id" in rawArtist
    ? (rawArtist as { id: string }).id
    : undefined;

let artistName: string | undefined = artistId;
if (artistId) {
 try {
  const artistEntry = await getEntry("artists", artistId);
  if (artistEntry) artistName = artistEntry.data.stage_name;
 } catch {}
}

// magazine 링크
let magazineHref: string | undefined;
if (album.data.magazine) {
 try {
  const magazineEntry = await getEntry("magazine", album.data.magazine);
  if (magazineEntry) {
   magazineHref = `/magazine/${magazineEntry.data.slug ?? magazineEntry.id}`;
  }
 } catch {
  // magazine 파일이 없으면 id를 slug로 직접 사용
  magazineHref = `/magazine/${album.data.magazine}`;
 }
}
---

<BaseLayout title={album.data.name} ogImage={album.data.image?.src ?? `/images/albums/${album.id}.jpg`}>
 <section>
  <header class="title-header">
   <h2>
    {album.data.recommended && <span class="pick-badge">pick</span>}
    {album.data.name}
    {artistName && <span class="faded">by {artistName}</span>}
   </h2>
   <div>
    <a class="back" href={backHref}>{backLabel}</a>
   </div>
  </header>
  <Separator />
  <div class="content-wrap">
   <img class="fade-in" src={album.data.image?.src ?? `/images/albums/${album.id}.jpg`} alt={album.data.image?.alt ?? album.id.replace(/-/g, " ")} />
   <div class="content">
    {
     album.data.release &&
      (() => {
       const d = new Date(album.data.release);
       const date = d.toLocaleDateString("ko-KR", { year: "numeric", month: "numeric", day: "numeric" });
       const weekday = d.toLocaleDateString("en-US", { weekday: "short" });
       return (
        <h5 class="release">
         Released in {date} {weekday}
        </h5>
       );
      })()
    }

    <h5>Track List</h5>
    <ol>
     {album.data.tracks.map(track => <li>{track}</li>)}
    </ol>

    <Content />
    <div class="row">
     {
      magazineHref && (
       <a class="magazine-link" href={magazineHref}>
        / In {album.data.magazine?.toUpperCase()}
       </a>
      )
     }

     {album.data.editor && <h5 class="editor">Editor. {album.data.editor}</h5>}
    </div>

    <Share title={album.data.name} />
   </div>
  </div>
 </section>
</BaseLayout>

<style>
 .release {
  margin-bottom: 1.25rem;
 }

 .row {
  display: flex;
  justify-content: space-between;

  align-items: center;
  margin: 0.5rem 0 1rem;
 }

 .magazine-link {
  display: inline-block;

  opacity: 0.8;
  transition: opacity 0.2s;
 }
 .magazine-link:hover {
  opacity: 1;
 }

 .pick-badge {
  vertical-align: middle;
 }
</style>
