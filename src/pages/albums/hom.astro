---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AlbumGridHeader from "../../components/AlbumGridHeader.astro";

const title = "Hausofmatters - Albums / 국내";

const allAlbums = await getCollection("albums");

const domesticCards = allAlbums
 .filter(a => a.data.category === "hom")
 .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
 .map(album => ({
  href: `/albums/${album.id}`,
  name: album.data.name,
  imageSrc: album.data.image.src,
  imageAlt: album.data.image.alt,
  year: (() => {
   const d = new Date(album.data.publishDate);
   const y = d.getFullYear();
   const m = String(d.getMonth() + 1).padStart(2, "0");
   return `${y}. ${m}.`;
  })(),
  recommended: album.data.recommended ?? false,
 }));
---

<BaseLayout title={title}>
 <AlbumGridHeader albumsTotal={domesticCards.length} title="국내힙합" />

 <div class="album-grid" data-grid>
  {
   domesticCards.map(card => (
    <a class="album-card" href={card.href} data-name={card.name} data-recommended={String(card.recommended)} data-astro-prefetch>
     <div class="album-img">
      <img class="fade-in" loading="lazy" src={card.imageSrc} alt={card.imageAlt} />
     </div>
     <h3 class="album-name">
     
      {card.name}
       {card.recommended && <span class="pick-badge" />}
     </h3>
     <p class="album-year">{card.year}</p>
    </a>
   ))
  }
 </div>
</BaseLayout>

<style>
 .album-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.5rem;
  margin: 2rem 0 10rem;
 }

 @media (min-width: 30em) {
  .album-grid {
   grid-template-columns: repeat(3, 1fr);
  }
 }
 @media (min-width: 50em) {
  .album-grid {
   grid-template-columns: repeat(5, 1fr);
  }
 }

 .album-name {
  margin: 0;
  font-size: 0.875rem;
  font-weight: 600;
  line-height: 1.3;
 }

 .faded {
  opacity: 0.5;
 }
</style>

<script src="../../scripts/index.js"></script>
