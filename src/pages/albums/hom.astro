---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Separator from "../../components/Separator.astro";

const title = "Hausofmatters - Albums / 국내";

const allAlbums = await getCollection("albums");
const allArtists = await getCollection("artists");

const domesticCards = allAlbums
  .filter(a => a.data.category === "hom")
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .map(album => {
    const artist = allArtists.find(a => a.id === album.data.artist.id);
    return {
      href: artist ? `/${artist.id}/albums/${album.id}` : `/albums/${album.id}`,
      name: album.data.name,
      imageSrc: album.data.image.src,
      imageAlt: album.data.image.alt,
      year: new Date(album.data.publishDate).getFullYear(),
    };
  });
---

<BaseLayout title={title}>
  <header class="title-header title-header--initial">
    <h2>Albums <span class="faded">/ 국내</span></h2>
    <a class="back" href="/albums">← 전체보기</a>
  </header>
  <Separator />

  <div class="album-grid">
    {domesticCards.map(card => (
      <a class="album-card" href={card.href} data-name={card.name} data-astro-prefetch>
        <div class="album-img">
          <img class="fade-in" loading="lazy" src={card.imageSrc} alt={card.imageAlt} />
        </div>
        <p class="album-name">{card.name}</p>
        <p class="album-year faded">{card.year}</p>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .title-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .back {
    font-size: 0.85rem;
    opacity: 0.5;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s ease;
  }

  .back:hover {
    opacity: 1;
  }

  .album-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
    margin: 2rem 0 10rem;
  }

  @media (min-width: 30em) {
    .album-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 50em) {
    .album-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .album-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-decoration: none;
    color: inherit;
  }

  .album-img {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-placeholder);
  }

  .album-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .album-card:hover .album-img img {
    transform: scale(1.04);
  }

  .album-name {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .album-year {
    margin: 0;
    font-size: 0.8rem;
  }

  .faded {
    opacity: 0.5;
  }
</style>

<script src="../../scripts/index.js"></script>